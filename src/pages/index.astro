  .notes__figures {
    display: flex; flex-wrap: wrap; gap: 2rem clamp(3rem, 7vw, 6rem);
    margin-block: clamp(4rem, 8vw, 6rem) 0; padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .notes__figures div { display: flex; flex-direction: column-reverse; gap: 0.5rem; }
  .notes__figures dt { font-size: 1.0625rem; color: var(--on-dark-2); }
  .notes__figures dd { margin: 0; font-size: clamp(3.5rem, 7vw, 5.5rem); line-height: 1; font-weight: 600; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .notes__figures div:first-child dd { color: #c9b8ff; }

  .clips {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem 4rem; align-items: end;
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .clips__title { font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.015em; }
  .clips__text { margin-top: 1rem; font-size: clamp(1.0625rem, 1.4vw, 1.25rem); line-height: 1.45; color: var(--on-dark-2); max-width: 32rem; }
  .clips__text strong { color: var(--on-dark); font-weight: 600; }
  .chips--dark li { background: rgba(255, 255, 255, 0.08); color: var(--on-dark); }

  @media (max-width: 760px) {
    .notes__stage { grid-template-columns: 1fr 1fr; }
    .notes__page--paper { grid-column: 1 / -1; width: min(70%, 20rem); justify-self: center; }
    .notes__arrow { grid-column: 1 / -1; justify-self: center; rotate: 90deg; }
    .notes__page--tilt img, .notes__page--tilt figcaption { translate: none; }
    .clips { grid-template-columns: 1fr; }
  }

  /* ---- Filosofía. ---- */
  .tile--talk { padding: clamp(2rem, 5vw, 4rem); gap: 1.5rem; }
  .talk { margin: 0; }
  .talk__title { font-family: var(--serif); font-size: clamp(2.75rem, 7vw, 6rem); line-height: 1; letter-spacing: -0.02em; font-style: italic; }
  .talk__sub { margin-top: 1rem; max-width: 40rem; font-family: var(--serif); font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.3; color: var(--ink-2); }
  .tile--talk .tile__text { max-width: 44rem; }
  .tile--book { justify-content: space-between; min-height: 20rem; }
  .tile--book cite { font-style: italic; }
  .ms__title cite { font-style: italic; }
  .tile--motto { justify-content: space-between; background: radial-gradient(120% 80% at 100% 0%, #1b2150, #000 65%); }
  .motto { font-family: var(--serif); font-size: clamp(2.5rem, 5.5vw, 4.25rem); line-height: 1; font-style: italic; color: #f2d48a; }


  /* ---- Filosofía: more tiles. ---- */
  .tile--rain { justify-content: space-between; min-height: 20rem; background: linear-gradient(170deg, #fff 30%, #eef2f6); }
  .tile--rain .tile__title, .tile--book .tile__title { font-family: var(--serif); font-weight: 600; }
  .tile--finals { justify-content: space-between; min-height: 16rem; }
  .tile--finals .tile__num { font-family: var(--serif); font-weight: 600; }
  .tile--finals .tile__num span { font-size: 0.5em; color: var(--ink-2); font-style: italic; }
  .tile--motto { min-height: 18rem; }

  /* ---- Proyectos. ---- */
  .tile--glove { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem 3rem; align-items: center; min-height: 0; padding: clamp(2rem, 4vw, 3.5rem); }
  .glove__copy { display: grid; gap: 0.75rem; }
  .glove__detail { font-size: 0.9375rem; line-height: 1.5; color: var(--on-dark-2); max-width: 36rem; }
  .glove { position: relative; margin: 0; }
  .glove svg { display: block; width: 100%; height: auto; }
  .glove__track { fill: rgba(255, 255, 255, 0.08); }
  .glove__level { fill: #f2d48a; transform-box: fill-box; transform-origin: bottom; }
  .glove text { fill: var(--on-dark-2); font-size: 11px; text-anchor: middle; font-family: var(--font); }
  .glove__letter { position: absolute; top: -0.5rem; right: 0; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 1rem; background: rgba(255, 255, 255, 0.1); font-size: 2.25rem; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .glove__level { animation: flex 3.2s var(--ease-in-out) infinite alternate; animation-delay: var(--d); }
  }
  @keyframes flex { 0%, 30% { transform: scaleY(1); } 70%, 100% { transform: scaleY(0.3); } }

  .tile--quantum { justify-content: space-between; min-height: 20rem; }
  .ket { font-family: var(--math); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; color: #4b3fb5; }
  .tile--ai { justify-content: space-between; min-height: 20rem; }

  .tools { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 1rem; }
  .tools li { display: grid; justify-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; text-align: center; }
  .tools__icon { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 1.125rem; background: var(--bg-alt); }
  .tools__icon img { width: 2.75rem; height: 2.75rem; object-fit: contain; }
  .tools__icon--wide img { width: 3.5rem; }
  .tools__icon--text { font-size: 2.25rem; font-weight: 600; color: #00878f; }

  .groups { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; }
  .groups li { display: grid; gap: 0.25rem; padding: 0.875rem 0; border-top: 1px solid rgba(0, 0, 0, 0.08); }
  .groups strong { font-size: 1.0625rem; font-weight: 600; }
  .groups span { font-size: 0.9375rem; line-height: 1.45; color: var(--ink-2); }
  .tile--langs { justify-content: space-between; }
  .langs { margin: 0; display: grid; gap: 1.25rem; }
  .langs div { display: grid; gap: 0.125rem; }
  .langs dt { font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .langs dd { margin: 0; font-size: 1.0625rem; color: var(--ink-2); }

  @media (max-width: 760px) {
    .tile--glove { grid-template-columns: 1fr; }
  }

  /* ---- Cine: the four favourites. ---- */
  .posters {
    list-style: none; padding: 0; margin-block: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .poster a { display: block; border-radius: 0.5rem; overflow: hidden; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 1.5rem 3rem -1rem rgba(0, 0, 0, 0.8); transition: transform 300ms var(--ease-out); }
  .poster img { display: block; width: 100%; height: auto; aspect-ratio: 185 / 278; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) {
    .poster a:hover { transform: translateY(-0.375rem); }
  }
  @media (max-width: 620px) { .posters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ---- Studies: the timeline. ---- */
  /* Rail: dates | line | content. The line fills top to bottom (0 → 1 = "Now") straight from the scroll
     position: it is the reader's own motion, so it is never eased and can be stopped or reversed at any
     instant. --p is its value without the script or under reduced motion (full); with the script, the
     browser (below) or scripts/scroll.ts sets the fill's own transform. Lighting a milestone is the state
     change that motion causes: its colours cross over in 200ms, nothing moves. */
  .tl {
    --p: 0;
    --t: clamp(1.3125rem, 2vw, 1.75rem);        /* milestone title size */
    --dot: 0.75rem;                              /* node diameter */
    --dot-y: calc(var(--t) * 0.6);               /* node centre = middle of the title's first line */
    --line: 2px;
    --track: #d2d2d7;
    display: grid;
    grid-template-columns: [when] 8.5rem [rail] var(--dot) [body] minmax(0, 1fr);
    column-gap: 2.5rem;
  }

  /* No JS, or reduced motion: the line is drawn in full, no scrubbing. */
  :global(html:not(.js)) .tl,
  :global(html.reduce) .tl { --p: 1; }

  /* The rail spans rows 1–6 and stops on the "Now" node (row 7). */
  .tl__rail {
    grid-column: rail; grid-row: 1 / 7;
    justify-self: center;
    position: relative;
    width: var(--line);
    margin-block: var(--dot-y) calc(-1 * var(--dot-y));
    background: var(--track);
  }
  .tl__fill {
    position: absolute; inset: 0;
    background: var(--ink);
    transform: scaleY(var(--p));
    transform-origin: top;
  }
  /* Where an animation can be tied to the scroll itself, the browser draws the fill; Chrome and Safari
     (from 26.4) then run it on the scrolling thread, in step with the page, instead of a frame behind it
     from the script, which on phones made its tip wobble against the reading line. Same range as the script's: from
     the first dot on the reading line, 60% down the screen, to the "Now" dot on it. The script lights the
     milestones from this animation's own progress, so the two always agree. */
  @supports (animation-timeline: view()) {
    /* Inset 0: by default the timeline's window leaves out the page's scroll-padding (4rem at the top),
       which ran the fill 64px ahead of the dots it lights. */
    .tl__rail { view-timeline-name: --tl-rail; view-timeline-axis: block; view-timeline-inset: 0; }
    :global(html.js:not(.reduce)) .tl__fill { animation: tl-fill linear both; }
    /* The timeline in a rule of its own, which outranks the shorthand (the shorthand resets it): in the
       same rule the CSS minifier folds it into the shorthand, a form no browser accepts. */
    :global(html.js:not(.reduce)) .tl__rail > .tl__fill {
      animation-duration: auto;
      animation-timeline: --tl-rail;
      animation-range: cover 40dvh cover calc(100% - 60dvh);
    }
    @keyframes tl-fill { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  }

  .tl__list {
    grid-column: 1 / -1; grid-row: 1 / span 8;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    margin: 0; padding: 0; list-style: none;
  }

  /* Milestone tokens: not reached (dim) by default. */
  .ms {
    --c-when: #6e6e73;                           /* dim, but AA on #f5f5f7 and on the tile */
    --c-title: #6e6e73;
    --c-meta: #6e6e73;
    --c-unit: #86868b;
    --c-link: #6e6e73;
    --c-dot: var(--bg-alt);
    --c-ring: #c7c7cc;
    --logo: 0.4;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;                       /* date and title share a baseline */
  }
  /* Reached: lit. (No JS and reduced motion: everything up to "Now" is reached.) */
  .ms.is-reached,
  :global(html:not(.js)) .ms:not(.ms--next),
  :global(html.reduce) .ms:not(.ms--next) {
    --c-when: var(--ink);
    --c-title: var(--ink);
    --c-meta: var(--ink-2);
    --c-unit: var(--ink-2);
    --c-link: var(--link);
    --c-dot: var(--ink);
    --c-ring: var(--ink);
    --logo: 1;
  }
  .ms--now.is-reached,
  :global(html:not(.js)) .ms--now:not(.ms--next),
  :global(html.reduce) .ms--now:not(.ms--next) {
    --c-when: #248a3d;                           /* green that reads on a light ground */
    --c-dot: #30d158;
    --c-ring: #30d158;
  }
  /* Next: in the future, never reached. Readable, but not lit. */
  .ms--next {
    --c-when: #48484a;
    --c-title: #48484a;
    --c-meta: var(--ink-2);
    --c-link: var(--link);
    --c-ring: #aeaeb2;
  }

  .ms__when {
    grid-column: when; grid-row: 1;
    font-size: 1.0625rem;
    line-height: calc(var(--t) * 1.2);
    font-weight: 600;
    color: var(--c-when);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ms__dot {
    grid-column: rail; grid-row: 1;
    position: relative; z-index: 1;
    align-self: start;
    width: var(--dot); height: var(--dot);
    margin-top: calc(var(--dot-y) - var(--dot) / 2);
    border-radius: 50%;
    background: var(--c-dot);
    box-shadow: inset 0 0 0 var(--line) var(--c-ring), 0 0 0 0.375rem var(--bg-alt);
  }
  .ms--now .ms__dot {
    --dot: 1rem;
    margin-inline: -0.125rem;                    /* 1rem node centred on a 0.75rem column */
  }

  /* From "Now" to "Next": the future, dashed. Not part of the 0 → 1 travel. */
  .ms--now::after {
    content: '';
    grid-column: rail; grid-row: 1;
    justify-self: center; align-self: stretch;
    width: var(--line);
    margin-block: var(--dot-y) calc(-1 * var(--dot-y));
    background: repeating-linear-gradient(to bottom, #aeaeb2 0 0.25rem, transparent 0.25rem 0.625rem);
  }

  .ms__body {
    grid-column: body; grid-row: 1;
    max-width: 40rem;
    padding-bottom: clamp(3rem, 5.5vw, 4.5rem);
  }
  .ms:last-child .ms__body { padding-bottom: 0; }

  .ms__title {
    font-size: var(--t);
    line-height: 1.2;
    font-weight: 600;
    color: var(--c-title);
    text-wrap: balance;
  }
  .ms__title a {
    color: var(--c-link);
    text-decoration: none;
  }
  .ms__title a::after { content: '\00a0›'; }
  @media (hover: hover) and (pointer: fine) {
    .ms__title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  }
  .ms__title a:active { opacity: 0.7; }

  .ms__meta {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.47;
    color: var(--c-meta);
    text-wrap: pretty;
  }

  /* June 2025: the two figures, as display type. */
  .ms__figures {
    display: flex; flex-wrap: wrap;
    gap: 1.5rem clamp(3rem, 6vw, 5.5rem);
    margin: 1.5rem 0 0;
  }
  .ms__figure { display: flex; flex-direction: column-reverse; gap: 0.5rem; }
  .ms__figure dt { font-size: 1.0625rem; line-height: 1.47; color: var(--c-meta); }
  .ms__figure dd {
    margin: 0;
    font-size: clamp(3.5rem, 7.5vw, 6rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    color: var(--c-title);
  }
  .ms__figure dd span { font-size: 0.375em; letter-spacing: -0.01em; color: var(--c-unit); }

  /* September 2025: the university, the anchor. The only surface on the rail. */
  .ms--figures .ms__body,
  .ms--anchor .ms__body { max-width: none; }
  .ms--anchor { --pad: 2.5rem; }
  .ms--anchor .ms__dot { margin-top: calc(var(--pad) + 1px + var(--dot-y) - var(--dot) / 2); }
  .ms__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.5rem 2rem;
    max-width: 44rem;
    padding: var(--pad);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.75rem;
    background: var(--bg);
  }
  .ms__card .ms__meta { max-width: 30rem; }
  .ms__logo {
    align-self: center;
    width: 12.5rem; height: auto;
    margin: 0.5rem;
    opacity: var(--logo);
  }

  .ms__when, .ms__title, .ms__title a, .ms__meta, .ms__figure dt, .ms__figure dd, .ms__figure dd span { transition: color 200ms var(--ease-out); }
  .ms__dot { transition: background-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out); }
  .ms__logo { transition: opacity 200ms var(--ease-out); }

  @media (max-width: 620px) {
    .tl {
      --dot-y: 0.75rem;                          /* middle of the date line */
      grid-template-columns: [rail] var(--dot) [body] minmax(0, 1fr);
      column-gap: 1.25rem;
    }
    .ms__when {
      grid-column: body; grid-row: 1;
      font-size: 0.9375rem;
      line-height: 1.5rem;
      text-align: left;
    }
    .ms--now::after { grid-row: 1 / span 2; }
    .ms__body { grid-column: body; grid-row: 2; margin-top: 0.25rem; padding-bottom: 2.5rem; }
    .ms__figures { flex-direction: column; gap: 1.5rem; }
    .ms__figure dd { font-size: 3.5rem; }
    .ms--anchor { --pad: 1.5rem; }
    .ms--anchor .ms__dot { margin-top: calc(var(--dot-y) - var(--dot) / 2); }
    .ms__card { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; border-radius: 1.25rem; }
    .ms__logo { align-self: start; width: 10.5rem; margin: 0.5rem 0 0; }
  }

  /* Contact */
  /* With the footer, the last screen at its tallest (Safari's toolbar tucked away): scrolled to the end,
     the section starts at the top of the screen, so the black page before it never shows; with the
     toolbar out it starts a toolbar's height above, and "Say hi." still sits clear of the island. Never
     dynamic units here or below: Safari moves its toolbar when the end of the page is pulled, and a
     section that resized with it changed the page's length mid-pull, so the page jumped back and forth.
     --footer-h is measured by the page script. The thread is a short iMessage exchange set on the page
     like a quote: the visitor asks where to reach him, his reply is the email, and the reply bubble is
     the mailto. The headline says hi in one language after another (scripts/contact.ts). */
  .contact { min-height: calc(100lvh - var(--footer-h, 0px)); display: grid; align-content: center; text-align: center; background: var(--bg); }
  /* Only the island's clearance above and a little air below, not a section's generous padding, so the
     exchange fits that last screen and is centred in it; with the full padding it outgrew short windows
     and the headline went under the island at the end. Scrolled to the end, the headline sits as far
     below the top as the screen is taller than everything under it, so in short windows the headline,
     the thread and their spacing also scale with the height. */
  .contact.section { padding-block: 5rem 3rem; }
  .contact__inner { display: grid; justify-items: center; gap: 1.25rem; }
  /* One line, one em tall whatever script the greeting is in, so nothing below moves when it changes. */
  .contact__title { width: 100%; height: 1.05em; font-size: clamp(2.75rem, min(6vw, 8.5svh), 4.5rem); line-height: 1.05; font-weight: 600; letter-spacing: -0.022em; }
  /* "Say" stays; the greeting after it changes (scripts/contact.ts). The line stays centred: when the new
     word is a different width, the whole line glides to its new place instead of jumping. */
  .contact__greet { display: inline-block; white-space: nowrap; }
  .contact__slot { position: relative; display: inline-block; }
  .contact__word { display: none; }
  .contact__word.is-on { display: inline-block; }
  /* The word on its way out is taken out of the line, so the line measures the word coming in. */
  .contact__word.is-leaving { display: inline-block; position: absolute; left: 0; top: 0; }
  /* Each glyph in its own box (the script splits the words), so the letters can arrive one after another. */
  .contact__word > :global(span) { display: inline-block; }
  .contact__word--cjk { letter-spacing: 0; font-feature-settings: 'palt'; }
  .contact .lede { max-width: 30rem; }

  /* The thread. Everything inside is sized in em of the bubble text, so the exchange scales as one. */
  .thread {
    --grey: #e9e9eb; /* the received-bubble grey, one step darker than --bg-alt so it holds on white */
    --tail: 1.18em;
    width: min(100%, 22em);
    margin-top: clamp(1.25rem, min(3vw, 3svh), 2.5rem);
    padding-inline: 0.45em; /* room for the tails inside the gutter */
    font-size: clamp(1.0625rem, min(0.5rem + 1.4vw, 0.25rem + 2.5svh), 1.75rem); /* smaller in short windows too (see .contact) */
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-align: left;
  }
  .thread__stamp, .thread__receipt { font-size: max(0.75rem, 0.55em); line-height: 1.3; font-weight: 500; letter-spacing: 0.01em; color: var(--ink-2); }
  .thread__stamp { text-align: center; margin-bottom: 0.9em; }
  .thread__receipt { text-align: right; margin-top: 0.4em; padding-right: 0.15em; }
  .thread__row { display: flex; }
  .thread__row--me { justify-content: flex-end; margin-top: 0.7em; }
  .bubble { position: relative; display: block; padding: 0.42em 0.8em; border-radius: 1.1em; }
  /* The received bubble is two layers: the tail, drawn by the bubble itself, and the body, which carries
     the colour and the text and is the only part that is clipped while the message grows. */
  .bubble--them { max-width: 82%; padding: 0; color: var(--ink); }
  .bubble__body { display: block; padding: 0.42em 0.8em; border-radius: 1.1em; background: var(--grey); text-wrap: pretty; }
  .bubble--me { background: var(--blue); color: #fff; overflow-wrap: anywhere; text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.18em; transition: background-color 200ms ease; }
  /* Tails: a bubble-coloured corner, then a page-coloured mask that carves it into a hook. The mask is
     only as wide as its curve: the tail sticks out 0.41em, and a wider mask, invisible on the page,
     reached past the screen's edge on phones and let the page pan sideways. */
  .bubble::before, .bubble::after { content: ''; position: absolute; bottom: 0; height: var(--tail); }
  .bubble::before { width: var(--tail); background: inherit; }
  .bubble::after { width: 0.6em; background: var(--bg); }
  .bubble--them::before { left: -0.41em; border-bottom-right-radius: 0.94em 0.82em; background: var(--grey); }
  .bubble--them::after { left: -0.6em; border-bottom-right-radius: 0.59em; }
  .bubble--me::before { right: -0.41em; border-bottom-left-radius: 0.94em 0.82em; }
  .bubble--me::after { right: -0.6em; border-bottom-left-radius: 0.59em; }
  /* The reply is the action: it gives under the finger, anchored at its tail; an invisible slop takes
     the hit area past 44px while the bubble keeps its proportions. */
  .thread__reply { position: relative; display: block; max-width: 100%; border-radius: 1.1em; color: #fff; text-decoration: none; transform-origin: 100% 100%; transition: transform 140ms var(--ease-out); }
  .thread__reply:active { transform: scale(0.97); }
  .thread__reply::after { content: ''; position: absolute; inset: -0.5rem -0.75rem; }
  .thread__reply:focus-visible { outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .thread__reply:hover .bubble--me { background-color: var(--blue-hover); }
  }
  /* The other ways to reach me, as the action buttons of a contact card: a round icon, its name under it. */
  .contact__links { display: flex; justify-content: center; gap: clamp(1.5rem, 4vw, 2.5rem); margin: clamp(1rem, min(2.5vw, 2.5svh), 2rem) 0 0; padding: 0; list-style: none; }
