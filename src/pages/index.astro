  }
  @keyframes twinkle { to { opacity: 0.15; } }
  .tile--sky .tile__big { font-size: clamp(4rem, 9vw, 7rem); }
  .tile--sky .tile__big sup { font-size: 0.5em; vertical-align: 0.9em; letter-spacing: 0; }

  .stops { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; }
  .stops li {
    display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: baseline; gap: 0.75rem;
