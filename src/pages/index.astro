---
import '@/styles/global.css';
import ScrollStatement from '@/components/ScrollStatement.astro';
import { ClientRouter } from 'astro:transitions';
import Island from '@/components/Island.astro';
import PartDivider from '@/components/PartDivider.astro';
import { helloStrokes, helloStrokeWidth, helloViewBox } from '@/data/hello';
import { favorites, letterboxd } from '@/data/cine';
import { cinePath, href } from '@/lib/paths';

const title = 'Daniel Martín Guerrero';
const description = 'Hola, soy Daniel: estudio Física en la Universidad de Salamanca y me pregunto qué significa todo eso para nosotros. Divulgación, filosofía y cine.';
// Contact address for the "Escríbeme" bubble, as it appears on Daniel's CV. If it is ever emptied,
// the exchange is left out and the contact links stand on their own.
const email = 'daniel.martgue@usal.es';
const github = 'https://github.com/danimartinguerrero';
const tiktok = 'https://www.tiktok.com/@_.danielmg';
const linkedin = 'https://www.linkedin.com/in/daniel-mart%C3%ADn-guerrero-b05b67448/';
// Published at Daniel's request (21 Nov 2026), as on his CV.
const phone = { label: '+34 644 41 93 65', tel: '+34644419365' };

const statement = 'Me mueven dos preguntas: cómo funciona el universo y qué significa para nosotros, aquí abajo. La física me da el método; la filosofía, el porqué.';

// Pages Daniel signs as author, counted from his PDFs (21 Nov 2026): Mecánica I, temas 1-3 (107) and its
// formulario (1) in danimartinguerrero/Hermite; capítulo 8 (19), tema 4 parte 1 (31) and tema 5 parte 1 (29)
// in danimartinguerrero/classical-mechanics; Sturm–Liouville y Hermite (14), sent by Daniel. The temas 1-3
// in classical-mechanics are not his and are not counted.
const notePages = 201;
---
<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={new URL(href('/'), Astro.site)} />
    <meta property="og:image" content={new URL(href('/og.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hello, soy Daniel. Estudiante de Física en la Universidad de Salamanca." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(href('/og.jpg'), Astro.site)} />
    <meta name="twitter:image:alt" content="hello, soy Daniel. Estudiante de Física en la Universidad de Salamanca." />
    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={href('/favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- The site changes page without leaving the document, so the island carries on
         (scripts/page.ts). No animation between pages: the page cuts, the island stays put. -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Saltar al contenido</a>

    <Island />

    <main id="main" data-home>
      <section class="hero section--dark" id="top" data-home-intro aria-labelledby="hero-title">
        <canvas class="hero__waves" data-waves aria-hidden="true"></canvas>
        <div class="hero__copy container">
          <h1 class="hero__title" id="hero-title">
            <span class="sr-only">Hola, soy Daniel.</span>
            <svg class="hello" viewBox={helloViewBox} aria-hidden="true" data-hello>
              <g stroke-width={helloStrokeWidth}>{helloStrokes.map((s) => <path d={s.d} pathLength="1" data-delay={s.delay} data-duration={s.duration} />)}</g>
            </svg>
            <span class="hero__name" aria-hidden="true" data-after>Soy Daniel.</span>
          </h1>
          <p class="hero__lede" data-after>Estudio segundo de Física en la Universidad de Salamanca: óptica, astrofísica, cuántica y divulgación. <strong>Y no dejo de preguntarme por qué.</strong></p>
          <p class="hero__cta">
            <a class="pill" href="#divulgacion" data-after>Ver lo que hago</a>
            <a class="pill pill--glass" href="#contacto" data-after>Escríbeme</a>
          </p>
        </div>
      </section>

      <ScrollStatement label="En pocas palabras" text={statement} />

      <PartDivider id="divulgacion" headingId="part-divulgacion" title="Divulgación." />

      <section class="section section--alt" aria-labelledby="cosmo-title">
        <header class="intro container--wide">
          <p class="brand"><span class="brand__mark" aria-hidden="true">✦</span>Cosmosofía</p>
          <h2 class="headline" id="cosmo-title">Qué hay ahí arriba, y qué significa aquí abajo.</h2>
          <p class="lede">Soy guionista y locutor en <em>Eureka</em>, el programa de divulgación científica de Radio Universidad de Salamanca, con Supernova, la asociación astronómica de la universidad. Allí creé Cosmosofía, la sección que cierra <em>Radioacción Cósmica</em> y une astrofísica y filosofía de la ciencia. <strong>La escribo y la presento.</strong></p>
          <p class="intro__cta">
            <a class="pill" href={href('/docs/cosmosofia-episodio-1.pdf')}>Leer el guion del episodio I</a>
          </p>
        </header>

        <div class="bento container--wide">
          <article class="tile tile--half tile--dark tile--sky">
            <p class="tile__kicker">Episodio I · Un mar de cuatrocientos mil millones de soles</p>
            <p class="tile__big">4 × 10<sup>11</sup><span> estrellas</span></p>
            <p class="tile__text">en nuestra galaxia. Dos billones de galaxias. Un planeta. Y tú.</p>
          </article>

          <article class="tile tile--half tile--index">
            <h3 class="tile__title">Cuatro paradas, unos ocho minutos.</h3>
            <ol class="stops">
              <li><span class="stops__n">0</span><span class="stops__name">Presentación</span><span class="stops__sub">Abrir la ventana</span></li>
              <li><span class="stops__n">1</span><span class="stops__name">Coordenadas</span><span class="stops__sub">Dónde estamos</span></li>
              <li><span class="stops__n">2</span><span class="stops__name">Polvo de estrellas</span><span class="stops__sub">De qué estamos hechos</span></li>
              <li><span class="stops__n">3</span><span class="stops__name">¿Por qué no?</span><span class="stops__sub">La frontera de lo conocido</span></li>
              <li><span class="stops__n">4</span><span class="stops__name">Un punto azul pálido</span><span class="stops__sub">Lo que nos debemos</span></li>
              <li><span class="stops__n">5</span><span class="stops__name">Epílogo</span><span class="stops__sub">Mirar arriba</span></li>
            </ol>
          </article>

          <article class="tile tile--half tile--word">
            <p class="word" lang="grc"><span>κόσμος</span> <i aria-hidden="true">+</i> <span>σοφία</span></p>
            <p class="tile__text"><strong>Kósmos</strong>, orden y también belleza; <strong>sophía</strong>, sabiduría. La que el cosmos nos devuelve cuando nos atrevemos a mirarlo de verdad.</p>
          </article>

          <article class="tile tile--half tile--night">
            <p class="tile__kicker"><time datetime="2026-09-25">25 de septiembre de 2026</time> · Noche Europea de los Investigadores</p>
            <h3 class="tile__title">«Houston, tenemos un telescopio».</h3>
            <p class="tile__text">Organicé y dirigí esta actividad de astronomía de tres horas, abierta al público, dentro de la Noche Europea de los Investigadores Marie Skłodowska-Curie, con la UCC+i de la Universidad de Salamanca.</p>
          </article>
        </div>
      </section>

      <section class="section section--dark notes" aria-labelledby="notes-title">
        <header class="intro container--wide">
          <p class="eyebrow">Apuntes formalizados</p>
          <h2 class="headline" id="notes-title">Del cuaderno a LaTeX.</h2>
          <p class="lede">Lo que escribo a mano en clase termina en apuntes formales: definiciones en cajas, cada paso justificado, figuras redibujadas. <strong>Fondo negro, azul, lavanda y dorado</strong>: el mismo estilo para toda la carrera.</p>
          <p class="intro__cta">
            <a class="more" href={`${github}/Hermite`}>Mecánica I en GitHub</a>
            <a class="more" href={`${github}/classical-mechanics`}>Más temas</a>
          </p>
        </header>

        <div class="notes__stage container--wide">
          <figure class="notes__page notes__page--paper">
            <img src={href('/notes/hermite-cuaderno.webp')} alt="Página manuscrita: la ecuación de Hermite resuelta por series, con la fórmula de Rodrigues al final" width="900" height="1200" loading="lazy" decoding="async" />
            <figcaption>El cuaderno · ecuación de Hermite</figcaption>
          </figure>
          <span class="notes__arrow" aria-hidden="true">→</span>
          <figure class="notes__page">
            <img src={href('/notes/hermite-portada.webp')} alt="Portada de los apuntes formalizados Operador de Sturm–Liouville y ecuación de Hermite, sobre fondo negro, con las funciones de Hermite dibujadas en colores dentro de un pozo parabólico" width="910" height="1287" loading="lazy" decoding="async" />
            <figcaption>Los apuntes · Sturm–Liouville y Hermite</figcaption>
          </figure>
          <figure class="notes__page notes__page--tilt">
            <img src={href('/notes/hermite-oscilador.webp')} alt="Página de los apuntes con el oscilador armónico cuántico: los primeros niveles de energía y sus funciones de onda, y la fórmula de Rodrigues en una caja" width="910" height="1287" loading="lazy" decoding="async" />
            <figcaption>El oscilador armónico, página 9</figcaption>
          </figure>
        </div>

        <dl class="notes__figures container--wide">
          <div><dt>páginas en LaTeX, firmadas</dt><dd>{notePages}</dd></div>
          <div><dt>páginas de Mecánica I, temas 1 a 3</dt><dd>107</dd></div>
          <div><dt>páginas de Sturm–Liouville y Hermite</dt><dd>14</dd></div>
        </dl>

        <div class="clips container--wide">
          <div class="clips__copy">
            <h3 class="clips__title">Y en vertical, sin sonido.</h3>
            <p class="clips__text">De ahí salen mis vídeos de física y matemáticas en TikTok, hechos con ayuda de la IA: un concepto por clip, de la astrofísica y el electromagnetismo a la ley de inercia de Sylvester o el teorema de Stokes generalizado. <strong>Formales, pero claros a la primera.</strong></p>
            <p class="intro__cta"><a class="pill pill--glass" href={tiktok}>@_.danielmg en TikTok</a></p>
          </div>
          <ul class="chips chips--dark" aria-label="Algunos temas">
            <li>Delta de Dirac</li><li>Función de Green</li><li>Sturm–Liouville</li><li>Polinomios de Hermite</li><li>Desarrollo multipolar</li><li>Ley de inercia de Sylvester</li><li>Formas diferenciales</li><li>Teorema de Stokes generalizado</li><li>Termodinámica</li>
          </ul>
        </div>
      </section>

      <PartDivider id="filosofia" headingId="part-filosofia" title="Filosofía." />

      <section class="section section--alt" aria-labelledby="philo-title">
        <header class="intro container--wide">
          <h2 class="headline" id="philo-title">La física responde cómo. La filosofía insiste en por qué.</h2>
          <p class="lede">No quiero elegir entre las dos. <strong>Cosmosofía nació de ahí</strong>, y también lo que escribo y defiendo en voz alta.</p>
        </header>

        <div class="bento container--wide">
          <article class="tile tile--full tile--talk">
            <p class="tile__kicker"><time datetime="2026-02-27">27 de febrero de 2026</time> · XXI Olimpiada Filosófica de Castilla y León · Conferenciante</p>
            <blockquote class="talk">
              <p class="talk__title">El naufragio de la luz.</p>
              <p class="talk__sub">Disertación filosófica acerca de la lucidez del delirio. Don Quijote, Myshkin y la estética de la bondad.</p>
            </blockquote>
            <p class="tile__text">Ponencia y mesa redonda en la jornada dedicada a <em>La locura. Don Quijote en el mundo actual</em>, en Salamanca. Dos locos buenos, Cervantes y Dostoyevski, y una pregunta: ¿y si la bondad solo se deja ver desde fuera de la cordura?</p>
          </article>

          <article class="tile tile--half tile--rain">
            <p class="tile__kicker"><time datetime="2025-11">19–21 de noviembre de 2025</time> · XXX Congreso Internacional de la Sociedad Castellano-Leonesa de Filosofía</p>
            <h3 class="tile__title">«Como lágrimas en la lluvia».</h3>
            <p class="tile__text">Ponente en la sesión <em>Antropocentrismo y androcentrismo como límite de la compasión</em>, coordinada por la profesora Angélica Velasco Sesma, en el congreso <em>Límites del presente</em>.</p>
          </article>

          <article class="tile tile--half tile--book">
            <p class="tile__kicker"><time datetime="2026-06-05">5 de junio de 2026</time> · Librería Víctor Jara, Salamanca</p>
            <h3 class="tile__title">Conversando con Eduardo Infante sobre <cite>Salvar a Sócrates</cite>.</h3>
            <p class="tile__text">En la presentación de su novela para aprender a filosofar (Ariel), junto a Pablo Beato Andrés, Isabel Briones González y David Criado García.</p>
          </article>

          <article class="tile tile--half tile--finals">
            <p class="tile__num">XIX <span>y</span> XX</p>
            <p class="tile__text">Dos veces finalista de la Olimpiada Filosófica de Castilla y León con una disertación filosófica, en 2024 y en 2025. Después volví como conferenciante.</p>
          </article>

          <article class="tile tile--full tile--dark tile--motto">
            <p class="motto" lang="la">Per aspera ad astra.</p>
            <p class="tile__text">A las estrellas, por el camino difícil. Así se despide Cosmosofía, y así entiendo estudiar Física.</p>
          </article>
        </div>
      </section>

      <PartDivider id="estudios" headingId="part-estudios" title="Estudios." />

      <section class="section section--alt" aria-labelledby="studies-title">
        <header class="intro container--wide">
          <h2 class="headline" id="studies-title">Física en Salamanca, promoción de 2029.</h2>
          <p class="lede">Bachillerato de Ciencias y Tecnología y después el Grado en Física de la Universidad de Salamanca. <strong>Ahora, en segundo.</strong></p>
        </header>
        <div class="tl container--wide" data-timeline="rail">
          <div class="tl__rail" aria-hidden="true"><div class="tl__fill"></div></div>
          <ol class="tl__list">
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2023">2023</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Bachillerato de Ciencias y Tecnología.</h3>
                <p class="ms__meta">IES Federico García Bernalt, Salamanca. 2023–2025.</p>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2024">2024</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Finalista de la XIX Olimpiada Filosófica de Castilla y León.</h3>
                <p class="ms__meta">Disertación filosófica, en primero de Bachillerato.</p>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2025">2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Finalista otra vez, en la XX.</h3>
                <p class="ms__meta">Y Talking Hands, un guante que traduce el alfabeto dactilológico a texto.</p>
              </div>
            </li>
            <li class="ms ms--figures" data-ms>
              <p class="ms__when"><time datetime="2025-06">Jun 2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Bachillerato, con Matrícula de Honor.</h3>
                <dl class="ms__figures">
                  <div class="ms__figure">
                    <dt>Nota media de Bachillerato</dt>
                    <dd>9,88<span>/10</span></dd>
                  </div>
                  <div class="ms__figure">
                    <dt>Prueba de Acceso a la Universidad (PAU)</dt>
                    <dd>13,378<span>/14</span></dd>
                  </div>
                </dl>
                <p class="ms__meta">Premio de Acceso a la Universidad de la USAL: entre las cien mejores notas de la fase general de la PAU 2024/25, con la matrícula de primero gratuita.</p>
              </div>
            </li>
            <li class="ms ms--anchor" data-ms>
              <p class="ms__when"><time datetime="2025-09">Sep 2025</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <div class="ms__card">
                  <div>
                    <h3 class="ms__title">Grado en Física.</h3>
                    <p class="ms__meta">Universidad de Salamanca, promoción de 2029. Matemáticas, mecánica clásica, ondas y óptica, electromagnetismo, termodinámica y técnicas computacionales.</p>
                  </div>
                  <img class="ms__logo" src={href('/studies/usal-color.svg')} alt="Universidad de Salamanca" width="428" height="155" decoding="async" />
                </div>
              </div>
            </li>
            <li class="ms" data-ms>
              <p class="ms__when"><time datetime="2026">2026</time></p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Matrícula de Honor en Laboratorio de Física.</h3>
                <p class="ms__meta">Incertidumbres de verdad: propagación de varianzas, medias ponderadas, ajustes por mínimos cuadrados con χ² e intervalos de Welch–Satterthwaite.</p>
              </div>
            </li>
            <li class="ms ms--now" data-ms>
              <p class="ms__when">Ahora</p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">Segundo curso del grado.</h3>
                <p class="ms__meta">Curso 2026–27. Apuntes de mecánica cuántica en LaTeX y los guiones de Cosmosofía.</p>
              </div>
            </li>
            <li class="ms ms--next" data-ms>
              <p class="ms__when">Próximo</p>
              <span class="ms__dot" data-dot aria-hidden="true"></span>
              <div class="ms__body">
                <h3 class="ms__title">PLANCKS 2027.</h3>
                <p class="ms__meta">La competición internacional de física teórica.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <PartDivider id="proyectos" headingId="part-proyectos" title="Proyectos." />

      <section class="section section--alt" aria-labelledby="proj-title">
        <header class="intro container--wide">
          <h2 class="headline" id="proj-title">Con las manos, y con la cabeza.</h2>
          <p class="lede">Un guante que habla, apuntes de cuántica y las herramientas con las que trabajo. <strong>Óptica y fotónica, astrofísica, física de partículas.</strong></p>
        </header>

        <div class="bento container--wide">
          <article class="tile tile--full tile--dark tile--glove">
            <div class="glove__copy">
              <p class="tile__kicker">2024–2025 · Proyecto de TIC II, IES Federico García Bernalt</p>
              <h3 class="tile__title">Talking Hands.</h3>
              <p class="tile__text">Un guante que traduce el alfabeto dactilológico español a texto, para que quien no puede hablar se entienda con quien no conoce la lengua de signos.</p>
              <p class="glove__detail">Cinco sensores de flexión en divisores de tensión sobre un Arduino Mega 2560 (ADC de 10 bits). Firmware en C/C++ que calibra los sensores y clasifica los gestos por umbrales, y manda cada letra por serie a una app que la muestra y la lee en voz alta. Con un modo servo que imita la flexión de los dedos, un modelo 3D y una propuesta inalámbrica con sensores de presión tipo piel. Hardware y firmware, con Rubén González Sánchez.</p>
            </div>
            <figure class="glove" aria-hidden="true">
              <svg viewBox="0 0 260 200">
                <g class="glove__bars">
                  {[0.82, 0.2, 0.25, 0.9, 0.86].map((v, i) => (
                    <g transform={`translate(${20 + i * 46} 0)`}>
                      <rect class="glove__track" x="0" y="20" width="28" height="140" rx="14" />
                      <rect class="glove__level" x="0" y={20 + 140 * (1 - v)} width="28" height={140 * v} rx="14" style={`--d: ${i * 120}ms`} />
                      <text x="14" y="186">{['pulgar', 'índice', 'corazón', 'anular', 'meñique'][i]}</text>
                    </g>
                  ))}
                </g>
              </svg>
              <p class="glove__letter"><span>V</span></p>
            </figure>
          </article>

          <article class="tile tile--half tile--quantum">
            <p class="tile__kicker">2026 · Apuntes en LaTeX</p>
            <h3 class="tile__title">Mecánica cuántica, desde el espacio de Hilbert.</h3>
            <p class="ket" aria-label="ket psi igual a la suma de c n por ket n">|ψ⟩ = Σ<sub>n</sub> c<sub>n</sub> |n⟩</p>
            <p class="tile__text">L²(ℝ), bras y kets, operadores hermíticos, descomposición espectral y regla de Born. Ahora, cúbits y puertas cuánticas.</p>
          </article>

          <article class="tile tile--half tile--ai">
            <p class="tile__kicker">Desde 2025 · Modelización con IA</p>
            <h3 class="tile__title">De la variedad parametrizada al ajuste por mínimos cuadrados.</h3>
            <p class="tile__text">Simulaciones físicas y apuntes de estudio con Claude Opus 5.5, Gemini, modelos abiertos y NotebookLM. La IA propone; yo compruebo cada paso.</p>
          </article>

          <article class="tile tile--full tile--tools">
            <h3 class="tile__title">Las herramientas.</h3>
            <ul class="tools">
              <li><span class="tools__icon"><img src={href('/toolkit/python.svg')} alt="" width="64" height="64" /></span>Python</li>
              <li><span class="tools__icon"><img src={href('/toolkit/matlab.png')} alt="" width="64" height="64" /></span>MATLAB</li>
              <li><span class="tools__icon"><img src={href('/toolkit/mathematica.svg')} alt="" width="64" height="64" /></span>Mathematica</li>
              <li><span class="tools__icon tools__icon--wide"><img src={href('/toolkit/latex.svg')} alt="" width="64" height="64" /></span>LaTeX</li>
              <li><span class="tools__icon"><img src={href('/toolkit/labview.svg')} alt="" width="64" height="64" /></span>LabVIEW</li>
              <li><span class="tools__icon tools__icon--text" aria-hidden="true">∞</span>Arduino</li>
              <li><span class="tools__icon"><img src={href('/toolkit/claude.svg')} alt="" width="64" height="64" /></span>Claude</li>
