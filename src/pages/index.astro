---
import Base from '@/layouts/Base.astro';
import DoubleSlit from '@/components/fig/DoubleSlit.astro';
import Lensing from '@/components/fig/Lensing.astro';
import Balmer from '@/components/fig/Balmer.astro';
import Oscillator from '@/components/fig/Oscillator.astro';
import Malus from '@/components/fig/Malus.astro';
import Fiber from '@/components/fig/Fiber.astro';
import Glove from '@/components/fig/Glove.astro';
import ThinFilm from '@/components/fig/ThinFilm.astro';
import Prism from '@/components/fig/Prism.astro';
import Michelson from '@/components/fig/Michelson.astro';
import Fraunhofer from '@/components/fig/Fraunhofer.astro';
import Chladni from '@/components/fig/Chladni.astro';
import Sky from '@/components/Sky.astro';
import Tools from '@/components/Tools.astro';
import Records from '@/components/Records.astro';
import Photos from '@/components/Photos.astro';
import Plan from '@/components/Plan.astro';
import Hubble from '@/components/fig/Hubble.astro';
import Library from '@/components/Library.astro';
import { entries, favorites, poster, profile, stars } from '@/data/cine';
import { href } from '@/lib/paths';

const email = 'daniel.martgue@usal.es';
const phone = { label: '+34 644 41 93 65', tel: '+34644419365' };
const links = {
  linkedin: 'https://www.linkedin.com/in/daniel-mart%C3%ADn-guerrero-b05b67448/',
  github: 'https://github.com/danimartinguerrero',
  tiktok: 'https://www.tiktok.com/@_.danielmg',
};
const recent = entries.filter((e, i, all) => e.poster && all.findIndex((o) => o.slug === e.slug) === i).slice(0, 6);
const img = (name: string) => ({
  src: href(`/notes/${name}-800.webp`),
  srcset: `${href(`/notes/${name}-800.webp`)} 800w, ${href(`/notes/${name}-1600.webp`)} 1600w`,
});
---
<Base title="Daniel Martín Guerrero" description="Física, filosofía y cine. Estudiante de segundo de Física en la Universidad de Salamanca: divulgación, apuntes en LaTeX y una pregunta por el porqué.">

  <!-- Fig. 0: the double slit fills the first screen -->
  <section class="hero" id="top" data-slit-root aria-labelledby="name">
    <DoubleSlit />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <p class="label hero__kicker">Física · Filosofía · Cine — Salamanca</p>
      <h1 class="display hero__name" id="name">Daniel<br />Martín Guerrero</h1>
      <div class="hero__foot">
        <p class="lede">Estudio Física en la Universidad de Salamanca. Me pregunto cómo funciona el universo <em>y qué significa para nosotros</em>.</p>
        <div class="hero__fig">
          <div class="fig__ctl" role="group" aria-label="Longitud de onda">
            <button class="ctl" type="button" data-lambda="450" aria-pressed="false">450 nm</button>
            <button class="ctl" type="button" data-lambda="532" aria-pressed="true">532 nm</button>
            <button class="ctl" type="button" data-lambda="650" aria-pressed="false">650 nm</button>
            <button class="ctl" type="button" data-observe aria-pressed="false">Observar el camino</button>
          </div>
          <p class="fig__cap"><b>Fig. 0</b>Doble rendija, un fotón cada vez: <span class="fig__read"><span data-slit-count>0</span> fotones</span>. Ninguno sabe dónde caerá; juntos dibujan franjas. Si se mira por qué rendija pasan, desaparecen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 Divulgación -->
  <section class="sec" id="divulgacion" aria-labelledby="t-divulgacion">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">01</p><p class="label">Divulgación</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-divulgacion">Qué hay ahí arriba, <em>y qué significa aquí abajo.</em></h2>
        <p class="body">Escribo y presento en <em>Eureka</em>, el programa de divulgación de Radio Universidad de Salamanca, con Supernova, la asociación astronómica de la universidad. Allí creé <strong>Cosmosofía</strong>, la sección que cierra <em>Radioacción Cósmica</em>: astrofísica y filosofía de la ciencia, de las coordenadas cósmicas al punto azul pálido de Sagan.</p>
        <p class="body"><a class="link arrow" href={href('/docs/cosmosofia-episodio-1.pdf')}>Guion del episodio I, «Un mar de cuatrocientos mil millones de soles»</a></p>
      </div>
    </div>
    <div class="wrap sec__grid">
      <figure class="fig sec__wide">
        <div class="fig__stage"><Lensing /></div>
        <figcaption class="fig__bar"><p class="fig__cap"><b>Fig. 1</b>Lente gravitacional. Una masa curva el espacio, y la luz de lo que hay detrás llega por dos caminos; alineadas, las imágenes se cierran en un anillo de Einstein. Mueve el cursor.</p></figcaption>
      </figure>
    </div>
    <div class="wrap sec__grid">
      <div class="sec__main sky-intro">
        <p class="label">El cielo, en fotografías</p>
        <p class="body">Lo que miramos en Supernova y contamos en la radio, visto por Hubble, Webb y Artemis. Desliza; cada imagen abre su original a máxima resolución.</p>
      </div>
    </div>
    <Sky />
    <div class="wrap sec__grid">
      <div class="sec__main">
        <ol class="rows">
          <li class="row"><p class="row__when">25 sep 2026</p><p class="row__what">«Houston, tenemos un telescopio»</p><p class="row__more">Organicé y dirigí esta actividad de astronomía de tres horas, abierta al público, en la Noche Europea de los Investigadores Marie Skłodowska-Curie, con la UCC+i de la Universidad de Salamanca.</p></li>
          <li class="row"><p class="row__when">Desde 2026</p><p class="row__what">Cosmosofía, en Radio USAL</p><p class="row__more">Coordenadas, polvo de estrellas, la frontera del «¿por qué no?» y lo que nos debemos unos a otros. Nucleosíntesis, Cecilia Payne y Carl Sagan.</p></li>
          <li class="row"><p class="row__when">En curso</p><p class="row__what">Física en vertical</p><p class="row__more">Vídeos cortos de física y matemáticas en <a class="link" href={links.tiktok}>TikTok, @_.danielmg</a>: de la astrofísica, el electromagnetismo y la termodinámica a la ley de inercia de Sylvester, las formas diferenciales o el teorema de Stokes generalizado.</p></li>
        </ol>
        <div class="assoc">
          <a class="assoc__logo assoc__logo--round" href="https://supernova.usal.es/" aria-label="Supernova, Asociación Universitaria"><img src={href('/logos/supernova.svg')} alt="" width="120" height="120" /></a>
          <p class="body">Con <strong>Supernova</strong>, la asociación astronómica de la Universidad de Salamanca: noches de observación, salidas al campo, la radio y el eclipse total de 2026.</p>
        </div>
      </div>
    </div>
    <Photos label="Con Supernova" tall items={[
      { id: 'eclipse-2026', title: 'Eclipse total de Sol', note: '12 de agosto de 2026, al atardecer' },
      { id: 'observacion-luz-roja', title: 'Observación con luz roja', note: 'La luz roja no deslumbra: el ojo sigue adaptado a la oscuridad' },
      { id: 'via-lactea', title: 'La Vía Láctea', note: 'Lejos de la contaminación lumínica' },
      { id: 'observatorio', title: 'En el observatorio', note: 'El refractor bajo la cúpula abierta' },
      { id: 'supernova-grupo', title: 'Supernova', note: 'La asociación, de noche y con camiseta' },
      { id: 'supernova-charla', title: 'Una charla de Supernova', note: 'Divulgación en la universidad' },
      { id: 'maqueta-sistema-solar', title: 'El sistema solar, en la mesa', note: 'Material de divulgación' },
    ]} />
    <div class="wrap sec__grid">
      <div class="sec__main">
        <figure class="fig" data-balmer-root>
          <div class="fig__stage"><Balmer /></div>
          <figcaption class="fig__bar">
            <p class="fig__cap"><b>Fig. 2</b>Serie de Balmer del hidrógeno. En 1925 Cecilia Payne leyó líneas así en la luz de las estrellas y demostró que están hechas sobre todo de hidrógeno y helio.</p>
            <div class="fig__ctl" role="group" aria-label="Espectro">
              <button class="ctl" type="button" data-balmer-mode="emision" aria-pressed="true">Emisión</button>
              <button class="ctl" type="button" data-balmer-mode="absorcion" aria-pressed="false">Absorción</button>
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 02 Física -->
  <section class="sec" id="fisica" aria-labelledby="t-fisica">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">02</p><p class="label">Física</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-fisica">La carrera, <em>por dentro.</em></h2>
        <p class="body">El Grado en Física de la Universidad de Salamanca: 240 créditos en cuatro años. Primero, superado, con Matrícula de Honor en el Laboratorio de Física; segundo, en curso. Lo que escribo y lo que mido, aquí, en PDF.</p>
      </div>
    </div>
    <div class="wrap sec__grid">
      <div class="sec__wide"><Plan /></div>
    </div>

    <div class="wrap sec__grid">
      <div class="sec__main sub">
        <p class="label">Apuntes</p>
        <h3 class="sub__title">Del cuaderno a LaTeX.</h3>
        <p class="body">Lo que escribo a mano en clase acaba en apuntes formales: cada definición en su caja, cada paso justificado, las figuras redibujadas. Fondo negro, azul, lavanda y dorado: el mismo estilo para toda la carrera.</p>
      </div>
      <div class="pages sec__wide">
        <figure class="page"><img {...img('hermite-cuaderno')} sizes="(max-width: 900px) 46vw, 30vw" alt="Página manuscrita: la ecuación de Hermite resuelta por series, hasta la fórmula de Rodrigues" width="800" height="1067" loading="lazy" decoding="async" /><figcaption class="label">El cuaderno</figcaption></figure>
        <figure class="page"><img {...img('hermite-portada')} sizes="(max-width: 900px) 46vw, 30vw" alt="Portada de los apuntes Operador de Sturm–Liouville y ecuación de Hermite, con las funciones de Hermite en un pozo parabólico" width="800" height="1132" loading="lazy" decoding="async" /><figcaption class="label">Sturm–Liouville y Hermite</figcaption></figure>
        <figure class="page"><img {...img('hermite-oscilador')} sizes="(max-width: 900px) 46vw, 30vw" alt="Página de los apuntes con el oscilador armónico cuántico y la fórmula de Rodrigues en una caja" width="800" height="1132" loading="lazy" decoding="async" /><figcaption class="label">Página 9, el oscilador</figcaption></figure>
      </div>
      <figure class="fig sec__wide" data-osc-root>
        <div class="fig__stage"><Oscillator /></div>
        <figcaption class="fig__bar">
          <p class="fig__cap"><b>Fig. 3</b>El oscilador armónico cuántico de la página 9: ψₙ(x) ∝ Hₙ(x) e<sup>−x²/2</sup>. En dorado, |ψ|²; en blanco, la parte real, girando. Un estado propio no cambia; una superposición oscila. <span class="fig__read" data-osc-read></span></p>
          <div class="fig__ctl" role="group" aria-label="Estado">
            <button class="ctl" type="button" data-osc-down aria-label="Bajar un nivel">â</button>
            <button class="ctl" type="button" data-osc-up aria-label="Subir un nivel">â†</button>
            <button class="ctl" type="button" data-osc-mix aria-pressed="false">Superponer</button>
          </div>
        </figcaption>
      </figure>
      <div class="sec__wide"><Library /></div>
    </div>

    <div class="wrap sec__grid">
      <div class="sec__main sub">
        <p class="label">Laboratorio</p>
        <h3 class="sub__title">Medir, que es otra forma de entender.</h3>
        <ol class="rows">
          <li class="row"><p class="row__when">1.º · Lab. de Física</p><p class="row__what">Práctica 3. La imagen y fuentes de luz. Láser y espectroscopía</p><p class="row__more">Refracción y difracción, espectroscopía y holografía: la reconstrucción de la imagen del holograma y su visualización en la placa holográfica.</p></li>
          <li class="row"><p class="row__when">1.º · Lab. de Física</p><p class="row__what">Práctica 6. Medida de la constante de Hubble</p><p class="row__more">27 galaxias en imágenes de SkyView con SAOImage DS9: el contorno al 10 % del brillo, el diámetro angular θ y, suponiendo D ≈ 20 kpc, la distancia d ≃ D/θ. Con su velocidad de recesión, la ley de Hubble. <a class="link" href="#hubble">La práctica, de cerca</a>.</p></li>
          <li class="row"><p class="row__when">1.º · Lab. de Física</p><p class="row__what">Experiencia 1. Dependencia de la resistencia con la temperatura</p><p class="row__more">Con un baño termostático y, por otro lado, un hilo de cobre calentado por efecto Joule: la temperatura, por infrarrojos con un termómetro láser; la resistencia, R = V/I.</p></li>
          <li class="row"><p class="row__when">2.º · Mecánica y Ondas</p><p class="row__what">Momento de inercia y teorema de Steiner, ondas estacionarias, péndulos acoplados, tubo de Quincke y efecto Doppler con ultrasonidos</p><p class="row__more">Con sus informes, en la biblioteca de arriba: <a class="link" href="#pdf-laboratorio-de-mecanica-y-ondas">Laboratorio de Mecánica y Ondas</a>.</p></li>
          <li class="row"><p class="row__when">2.º · Instrumentación</p><p class="row__what">Electrónica analógica y teoría de circuitos</p><p class="row__more">Amplificadores operacionales, filtros de primer y segundo orden, un conversor de 4 bits, osciladores sinusoidal y de relajación, oscilogramas, el fenómeno de Gibbs en series de Fourier, diodos y tensiones umbral.</p></li>
        </ol>
      </div>
    </div>
    <div class="wrap sec__grid" id="hubble">
      <div class="sec__main sub sub--tight">
        <p class="label">Práctica 6, de cerca</p>
        <h3 class="sub__title">Medir la expansión del universo con una regla.</h3>
        <p class="body">Ninguna galaxia trae escrita su distancia. Pero si todas midieran unos 20 kpc, su tamaño aparente la delataría: d ≃ D/θ. Con DS9 delimité cada una donde su brillo cae al 10 % del núcleo, tomé los extremos de su eje mayor y calculé el ángulo entre ellos sobre la esfera celeste. Frente a la velocidad con que se alejan, sale la constante de Hubble.</p>
        <a class="report" href={href('/docs/practica-6-constante-de-hubble.pdf')} target="_blank" rel="noopener">
          <img src={href('/docs/practica-6-constante-de-hubble.webp')} alt="" width="720" height="1018" loading="lazy" decoding="async" />
          <span><span class="label">Informe · 11 pp. · 19 de abril de 2026</span><span class="report__t">Práctica 6: medida de la constante de Hubble</span><span class="report__m">H₀ = 66 ± 6 km s⁻¹ Mpc⁻¹, ajuste forzado al origen, r = 0,91</span></span>
        </a>
      </div>
      <figure class="fig sec__wide">
        <div class="fig__stage"><Hubble /></div>
        <figcaption class="fig__bar">
          <p class="fig__cap"><b>Fig. 4</b>La ley de Hubble con mis medidas: velocidad de recesión frente a distancia de 27 galaxias (círculos huecos, tipo Sa). La recta dorada es el ajuste; las discontinuas, los valores de Planck y de SH0ES. Pasa el cursor por un punto. <span class="fig__read" data-hub-read></span></p>
          <div class="fig__ctl" role="group" aria-label="Ajuste">
            <button class="ctl" type="button" data-hub-mode="todas" aria-pressed="true">Por el origen</button>
            <button class="ctl" type="button" data-hub-mode="sinSa" aria-pressed="false">Sin las Sa</button>
            <button class="ctl" type="button" data-hub-mode="d10" aria-pressed="false">D = 10 kpc</button>
            <button class="ctl" type="button" data-hub-mode="libre" aria-pressed="false">Recta libre</button>
          </div>
        </figcaption>
      </figure>
    </div>
    <Photos label="La práctica 6 en DS9" items={[
      { id: 'ds9-ngc-1357', title: 'NGC 1357, el ejemplo', note: 'Contorno al 10 % del brillo y eje mayor P1–P2' },
      { id: 'ds9-ngc-1832', title: 'NGC 1832', note: 'Espiral barrada, SBb' },
      { id: 'ds9-ngc-2275', title: 'NGC 2275 y NGC 2274', note: 'Arp 140: medir una galaxia junto a su compañera' },
      { id: 'ds9-ngc-2276', title: 'NGC 2276', note: 'Espiral Sc, con una estrella brillante al lado' },
      { id: 'ds9-ngc-3147', title: 'NGC 3147', note: 'Espiral Sb, que se aleja a 2 900 km/s' },
      { id: 'arp-140', title: 'Arp 140', note: 'NGC 2275 y NGC 2274, dos galaxias que interactúan' },
      { id: 'arp-94', title: 'Arp 94', note: 'NGC 3227 y NGC 3226' },
    ]} />
    <Photos label="En el laboratorio" items={[
      { id: 'laser-difraccion', title: 'Difracción de un láser', note: 'Práctica 3 · Láser y espectroscopía' },
      { id: 'laser-pantalla', title: 'Refracción y difracción', note: 'Práctica 3' },
      { id: 'prisma-goniometro', title: 'Espectroscopía', note: 'Práctica 3 · El espectro en el goniómetro' },
      { id: 'holografia-montaje', title: 'Reconstrucción del holograma', note: 'Práctica 3 · Holografía' },
      { id: 'holografia', title: 'La imagen en la placa holográfica', note: 'Práctica 3 · Holografía' },
      { id: 'termometria', title: 'Resistencia y temperatura', note: 'Experiencia 1 · Efecto Joule y termómetro de infrarrojos' },
      { id: 'tubo-thomson', title: 'Tubo de Thomson', note: 'La relación carga/masa del electrón: el haz azul, curvado por las bobinas de Helmholtz' },
      { id: 'momento-inercia', title: 'Teorema de Steiner', note: 'Mecánica y Ondas · Momento de inercia' },
      { id: 'ondas-cuerda', title: 'Ondas estacionarias', note: 'Mecánica y Ondas · Nodos y vientres en una cuerda' },
      { id: 'pendulos-acoplados', title: 'Péndulos acoplados', note: 'Mecánica y Ondas · Dos osciladores que se pasan la energía' },
      { id: 'pulsaciones', title: 'Pulsaciones', note: 'Mecánica y Ondas · La energía va y viene' },
      { id: 'pendulo-pohl', title: 'Péndulo de Pohl', note: 'Mecánica y Ondas · Oscilaciones forzadas y amortiguadas' },
      { id: 'osciloscopio-senales', title: 'Oscilogramas', note: 'Instrumentación electrónica' },
      { id: 'oscilogramas', title: 'Oscilador de relajación', note: 'Instrumentación electrónica' },
      { id: 'entrenador-at700', title: 'Circuitos en el entrenador', note: 'Instrumentación electrónica · Electrónica analógica' },
      { id: 'protoboard', title: 'Filtros y amplificadores', note: 'Instrumentación electrónica · Protoboard' },
      { id: 'pizarra', title: 'La pizarra', note: 'Facultad de Ciencias' },
    ]} />
  </section>

  <!-- 03 Óptica y fotónica -->
  <section class="sec" id="optica" aria-labelledby="t-optica">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">03</p><p class="label">Óptica y fotónica</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-optica">La luz, <em>de cerca.</em></h2>
        <p class="body">La rama de la física que más me tira. Formo parte del <strong>OSAL Student Chapter</strong>, la asociación de estudiantes que divulga la óptica y la fotónica en la Universidad de Salamanca, y soy miembro de <strong>Optica</strong>, la sociedad internacional de óptica y fotónica: <em lang="en">Advancing Optics and Photonics Worldwide</em>.</p>
      </div>
    </div>
    <div class="wrap sec__grid">
      <figure class="fig sec__wide">
        <div class="fig__stage"><Prism /></div>
        <figcaption class="fig__bar"><p class="fig__cap"><b>Fig. 5</b>Dispersión en un prisma de vidrio BK7. Cada longitud de onda se refracta con su propio índice, n(λ) = A + B/λ², y la luz blanca sale abierta en espectro. Sube y baja el cursor para cambiar el ángulo de incidencia. <span class="fig__read" data-prism-read></span></p></figcaption>
      </figure>
    </div>
    <div class="wrap sec__grid">
      <div class="sec__main">
        <div class="members">
          <a class="member" href="https://laser.usal.es/osal/en/home/">
            <span class="member__logo"><img src={href('/logos/osal.svg')} alt="OSAL Student Chapter" width="200" height="86" /></span>
            <span class="member__what">Miembro · Divulgación de óptica y fotónica en la Universidad de Salamanca: talleres, demostraciones y láseres.</span>
          </a>
          <a class="member" href="https://www.optica.org/">
            <span class="member__logo"><img src={href('/logos/optica.svg')} alt="Optica, Advancing Optics and Photonics Worldwide" width="240" height="68" /></span>
            <span class="member__what">Miembro individual hasta septiembre de 2027 · La sociedad internacional de óptica y fotónica, fundada en 1916.</span>
          </a>
        </div>
        <ol class="rows">
          <li class="row"><p class="row__when">Nov 2026</p><p class="row__what">«Del bit al qubit: una nueva forma de resolver problemas»</p><p class="row__more">Taller de tres horas de Nacho Benito Fiz, director de Data, IA y Computación Cuántica en NTT DATA, en la Facultad de Ciencias: superposición, entrelazamiento e interferencia, los algoritmos de Grover y Shor, y lo que la computación cuántica puede aportar más allá del <em>hype</em>.</p></li>
        </ol>
        <blockquote class="feynman">
          <p>«La naturaleza no es clásica, y si quieres simularla, más vale que lo hagas de forma cuántica.»</p>
          <p class="label">Richard Feynman, 1981</p>
        </blockquote>
      </div>
    </div>
    <Photos label="Del bit al qubit" items={[
      { id: 'seminario-qubit-portada', title: 'Del bit al qubit', note: 'Universidad de Salamanca y NTT DATA' },
      { id: 'seminario-qubit-grupo', title: 'Tras el taller', note: 'Con Nacho Benito Fiz, en la Facultad de Ciencias' },
    ]} />
    <div class="wrap sec__grid">
      <figure class="fig sec__wide">
        <div class="fig__stage"><Michelson /></div>
        <figcaption class="fig__bar">
          <p class="fig__cap"><b>Fig. 6</b>Interferómetro de Michelson. Un láser de He-Ne se divide en dos brazos que vuelven a juntarse. Con un espejo apenas inclinado, franjas rectas, como las de Young, que se desplazan una entera cada vez que M₂ avanza λ/2; alineados, anillos. <span class="fig__read" data-mich-read></span></p>
          <div class="fig__ctl">
            <button class="ctl" type="button" data-mich-mode aria-pressed="false">Alinear los espejos</button>
            <label class="slider"><span class="sr-only">Posición del espejo M₂</span><input type="range" min="0" max="1600" value="0" step="1" data-mich-range /></label>
          </div>
        </figcaption>
      </figure>
      <figure class="fig sec__wide">
        <div class="fig__stage"><Fraunhofer /></div>
        <figcaption class="fig__bar">
          <p class="fig__cap"><b>Fig. 7</b>Difracción de Fraunhofer: lo que una abertura hace con la luz, lejos de ella, es su transformada de Fourier al cuadrado. Una red cristalina hexagonal, como la del grafeno, devuelve su red recíproca: puntos con simetría de seis; un pinhole, el disco de Airy. En escala logarítmica, como lo registraría una cámara.</p>
          <div class="fig__ctl" role="group" aria-label="Abertura">
            <button class="ctl" type="button" data-ap="doble" aria-pressed="false">Doble rendija</button>
            <button class="ctl" type="button" data-ap="red" aria-pressed="false">Red</button>
            <button class="ctl" type="button" data-ap="cristal" aria-pressed="true">Red cristalina</button>
            <button class="ctl" type="button" data-ap="cuadricula" aria-pressed="false">Cuadrícula</button>
            <button class="ctl" type="button" data-ap="circular" aria-pressed="false">Pinhole</button>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 04 Filosofía -->
  <section class="sec" id="filosofia" aria-labelledby="t-filosofia" data-malus-root style="--malus: 0.75">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">04</p><p class="label">Filosofía</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-filosofia">La física responde cómo. <em>La filosofía insiste en por qué.</em></h2>
        <p class="body">No quiero elegir entre las dos. De ahí salió Cosmosofía, y también lo que escribo y defiendo en voz alta.</p>
      </div>
    </div>
    <div class="wrap sec__grid">
      <figure class="fig sec__wide">
        <div class="fig__stage"><Malus /></div>
        <figcaption class="fig__bar">
          <p class="fig__cap"><b>Fig. 8</b>Ley de Malus. Tras un polarizador, la luz vibra en un solo plano; un segundo filtro girado θ deja pasar I₀ cos²θ. Gira el analizador: la frase de abajo recibe esa luz. <span class="fig__read" data-malus-read></span></p>
          <label class="slider"><span class="sr-only">Ángulo del analizador</span><input type="range" min="0" max="90" value="30" step="1" data-malus-range /></label>
        </figcaption>
      </figure>
      <div class="sec__main">
        <blockquote class="talk">
          <p class="label">27 feb 2026 · XXI Olimpiada Filosófica de Castilla y León · Conferenciante</p>
          <p class="talk__title">El naufragio de la luz.</p>
          <p class="talk__sub">Disertación filosófica acerca de la lucidez del delirio. Don Quijote, Myshkin y la estética de la bondad.</p>
        </blockquote>
        <ol class="rows">
          <li class="row"><p class="row__when">19–21 nov 2025</p><p class="row__what">«Como lágrimas en la lluvia»</p><p class="row__more">Ponente en el XXX Congreso Internacional de la Sociedad Castellano-Leonesa de Filosofía, <em>Límites del presente</em>, en la sesión «Antropocentrismo y androcentrismo como límite de la compasión», coordinada por la profesora Angélica Velasco Sesma.</p></li>
          <li class="row"><p class="row__when">5 jun 2026</p><p class="row__what">Con Eduardo Infante, sobre <em>Salvar a Sócrates</em></p><p class="row__more">En la presentación de su novela para aprender a filosofar (Ariel), en la Librería Víctor Jara de Salamanca, junto a Pablo Beato Andrés, Isabel Briones González y David Criado García.</p></li>
          <li class="row"><p class="row__when">2024 · 2025</p><p class="row__what">Dos veces finalista de la Olimpiada Filosófica</p><p class="row__more">En la XIX y la XX edición, con una disertación filosófica. Después volví como conferenciante.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 Trayectoria -->
  <section class="sec" id="trayectoria" aria-labelledby="t-trayectoria">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">05</p><p class="label">Trayectoria</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-trayectoria">Física en Salamanca, promoción de 2029.</h2>
        <dl class="figures">
          <div><dt>Nota media de Bachillerato, con Matrícula de Honor</dt><dd>9,88</dd></div>
          <div><dt>Prueba de Acceso a la Universidad, sobre 14</dt><dd>13,378</dd></div>
          <div><dt>Premio de Acceso: entre las cien mejores notas de la PAU</dt><dd>100</dd></div>
        </dl>
      </div>
    </div>
    <div class="wrap sec__grid">
      <div class="sec__main">
        <figure class="fig fig--fiber">
          <Fiber>
            <li class="row" data-node><p class="row__when">2023</p><p class="row__what">Bachillerato de Ciencias y Tecnología</p><p class="row__more">IES Federico García Bernalt, Salamanca.</p></li>
            <li class="row" data-node><p class="row__when">2024–2025</p><p class="row__what">Finalista de la Olimpiada Filosófica, dos veces</p><p class="row__more">Y Talking Hands, un guante que traduce el alfabeto dactilológico a texto.</p></li>
            <li class="row" data-node><p class="row__when">Jun 2025</p><p class="row__what">Bachillerato, con Matrícula de Honor</p><p class="row__more">Premio de Acceso a la Universidad de la USAL: la matrícula de primero, gratuita.</p></li>
            <li class="row" data-node><p class="row__when">Sep 2025</p><p class="row__what">Grado en Física, Universidad de Salamanca</p><p class="row__more">Álgebra lineal y geometría, cálculo, ecuaciones diferenciales, mecánica, ondas y óptica, electromagnetismo, termodinámica y técnicas computacionales.</p></li>
            <li class="row" data-node><p class="row__when">2026</p><p class="row__what">Matrícula de Honor en Laboratorio de Física</p><p class="row__more">Incertidumbres en serio: propagación de varianzas, medias ponderadas, ajustes por mínimos cuadrados con χ² e intervalos de Welch–Satterthwaite.</p></li>
            <li class="row" data-node><p class="row__when">Ahora</p><p class="row__what">Segundo curso</p><p class="row__more">Curso 2026–27. Óptica y fotónica, astrofísica, mecánica cuántica.</p></li>
            <li class="row row--next" data-node><p class="row__when">Próximo</p><p class="row__what">PLANCKS 2027</p><p class="row__more">La competición internacional de física teórica.</p></li>
          </Fiber>
          <figcaption class="fig__bar"><p class="fig__cap"><b>Fig. 9</b>Reflexión total interna. Más allá del ángulo crítico (unos 42° entre vidrio y aire), la luz no escapa del núcleo y avanza rebotando: así viajan los datos por fibra óptica. Aquí avanza al ritmo de la lectura.</p></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 06 Proyectos -->
  <section class="sec" id="proyectos" aria-labelledby="t-proyectos">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">06</p><p class="label">Proyectos</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-proyectos">Talking Hands.</h2>
        <p class="body">Un guante que traduce el alfabeto dactilológico español a texto, para que quien no puede hablar se entienda con quien no conoce la lengua de signos. Cinco sensores de flexión en divisores de tensión sobre un Arduino Mega 2560; firmware en C/C++ que los calibra y clasifica cada gesto por umbrales, y una app que muestra la letra y la lee en voz alta. Con Rubén González Sánchez, en el IES Federico García Bernalt, 2024–2025.</p>
      </div>
    </div>
    <div class="wrap sec__grid">
      <div class="sec__main">
        <figure class="fig">
          <div class="fig__stage"><Glove /></div>
          <figcaption class="fig__bar"><p class="fig__cap"><b>Fig. 10</b>Lecturas de los cinco sensores (ADC de 10 bits) y la letra que forman, escribiendo por el puerto serie. Simulación.</p></figcaption>
        </figure>
        <dl class="facts">
          <div><dt class="label">Mecánica cuántica</dt><dd>Apuntes en LaTeX sobre espacios de Hilbert y el formalismo de Dirac: L²(ℝ), bras y kets, operadores hermíticos, descomposición espectral, regla de Born. Ahora, cúbits y puertas cuánticas.</dd></div>
          <div><dt class="label">Modelización con IA</dt><dd>Simulaciones físicas, de variedades parametrizadas a ajustes por mínimos cuadrados, con Claude, Gemini, modelos abiertos y NotebookLM. La IA propone; cada paso lo compruebo yo.</dd></div>
          <div><dt class="label">Asociaciones</dt><dd>Supernova, asociación astronómica de la USAL · OSAL Student Chapter · Optica, miembro individual · Delegación Charra del Grupo de Estudiantes de la RSEF.</dd></div>
          <div><dt class="label">Idiomas</dt><dd>Español, nativo. Inglés, avanzado (formación C1).</dd></div>
        </dl>
        <p class="label tools-label">Con qué trabajo</p>
      </div>
    </div>
    <Tools />
  </section>

  <!-- 07 Música -->
  <section class="sec" id="musica" aria-labelledby="t-musica">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">07</p><p class="label">Música</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-musica">Lo que suena <em>mientras estudio.</em></h2>
        <p class="body">Bandas sonoras para concentrarme, rock de siempre y alguna lista para no pensar. Pulsa un disco y sonará mientras sigues leyendo; el reproductor espera abajo, en la esquina.</p>
      </div>
    </div>
    <div class="wrap">
      <Records />
    </div>
    <div class="wrap sec__grid">
      <figure class="fig sec__wide">
        <div class="fig__stage"><Chladni /></div>
        <figcaption class="fig__bar"><p class="fig__cap"><b>Fig. 11</b>Figuras de Chladni. Arena sobre placas que vibran: se aparta de lo que se mueve y se queda en las líneas nodales de cada modo. Con la música sonando, las placas vibran con fuerza y cambian de modo; pulsa una para cambiarlo tú. <span class="fig__read" data-chladni-read></span></p></figcaption>
      </figure>
    </div>
  </section>

  <!-- 08 Cine -->
  <section class="sec" id="cine" aria-labelledby="t-cine">
    <div class="wrap sec__grid" data-reveal>
      <div class="sec__side sec__rule"><p class="sec__num">08</p><p class="label">Cine</p></div>
      <div class="sec__main sec__rule">
        <h2 class="title" id="t-cine"><em lang="en">«{profile.quote}.»</em></h2>
        <p class="body">— <em>{profile.quoteSource}</em>. La frase que me cambió la forma de mirar. {profile.films} películas en Letterboxd, {profile.thisYear} este año; siempre vuelvo a Tarkovski, Lynch, Bergman y Kurosawa.</p>
        <ol class="favs">
          {favorites.map((f, i) => (
            <li><span class="favs__n">{String(i + 1).padStart(2, '0')}</span><span class="favs__t">{f.title}</span><span class="favs__m">{f.year} · {f.by}</span></li>
          ))}
        </ol>
      </div>
    </div>
    <div class="wrap">
      <ul class="strip" aria-label="Lo último que he visto">
        {recent.map((e) => (
          <li>
            <a href={e.url} class="strip__a">
              <img {...poster(e, '(max-width: 700px) 30vw, 15vw')} alt={`${e.title}${e.year ? ` (${e.year})` : ''}`} loading="lazy" decoding="async" />
