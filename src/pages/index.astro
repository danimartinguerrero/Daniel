<style>
  .skip:focus { position: fixed; top: 0.5rem; left: 0.5rem; width: auto; height: auto; clip-path: none; z-index: 10; padding: 0.5rem 1rem; background: var(--bg); border-radius: 980px; }

  /* Hero */
  .hero {
    position: relative; isolation: isolate;
    min-height: calc(100svh - var(--nav-h)); display: grid; place-items: center;
    padding-block: clamp(4rem, 10vw, 8rem); overflow: hidden;
  }
  /* Keep the still glow visible until the first rendered wave takes its place. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 45% at 50% 100%, rgba(245, 245, 247, 0.12), transparent 70%);
    transition: opacity 1600ms ease;
  }
  .hero.has-waves::before { opacity: 0; }
  .hero__waves {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    opacity: 0;
    transition: opacity 1600ms ease;
    /* The fringes rise out of the dark instead of meeting the next section at a hard edge. */
    mask-image: linear-gradient(to top, transparent, #000 24%);
    -webkit-mask-image: linear-gradient(to top, transparent, #000 24%);
  }
  .has-waves .hero__waves { opacity: 1; }
  /* The copy sits on a soft neutral shade, so the fringes never pass right behind the words. */
  .hero__copy { position: relative; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5); }
  .hero__copy::before {
    content: ''; position: absolute; z-index: -1; inset: -12% -18%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.6) 55%, transparent);
    pointer-events: none;
  }
  .hero__copy { text-align: center; display: grid; justify-items: center; gap: 1.25rem; }
  .hero__title { display: grid; justify-items: center; gap: 0.5rem; }
  .hello {
    width: min(72vw, 34rem); height: auto; overflow: visible;
  }
  .hello g { fill: none; stroke: var(--on-dark); stroke-linecap: round; stroke-linejoin: round; }
  .hero__name {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.022em;
  }
  .hero__lede {
    max-width: 38rem;
    font-size: clamp(1.1875rem, 1.7vw, 1.5rem); line-height: 1.33; font-weight: 500; letter-spacing: 0.006em;
    color: #aeaeb2; /* brighter than the usual secondary: it sits on a moving image */
    text-wrap: pretty;
  }
  .hero__lede strong { color: var(--on-dark); font-weight: 600; }
  .hero__cta { gap: 1rem; }
  .hero__cta, .intro__cta, .contact__links { display: flex; align-items: center; justify-content: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem; }

  /* Entrance, once, on load: "hello" is written stroke by stroke, then the rest arrives (scripts/hello.ts).
     Until the script takes over they wait hidden; if it never runs, a failsafe shows them anyway. */
  :global(html.js) [data-home-intro] .hello path { stroke-dasharray: 1 1; stroke-dashoffset: 1; animation: hello-failsafe-stroke 0s 5s forwards; }
  :global(html.js) [data-home-intro] [data-after] { opacity: 0; animation: hello-failsafe-after 0s 5s forwards; }
  @keyframes hello-failsafe-stroke { to { stroke-dashoffset: 0; } }
  @keyframes hello-failsafe-after { to { opacity: 1; } }



  /* Section intros: left-aligned. */
  .intro { display: grid; gap: 1rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .intro .headline { max-width: 20ch; }
  .intro .lede { max-width: 42rem; }
  .intro__cta { justify-content: flex-start; }
  .section--alt .eyebrow { color: var(--ink-2); }
  .section--dark .eyebrow { color: var(--on-dark-2); }

  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .tile {
    display: flex; flex-direction: column; gap: 0.75rem;
    margin: 0; padding: 2rem;
    min-width: 0;
    border-radius: 1.75rem;
    background: var(--bg);
  }
  .tile--half { grid-column: span 2; }
  .tile--dark { min-height: 22rem; background: var(--dark); color: var(--on-dark); justify-content: flex-end; }
  .tile__kicker { font-size: 0.875rem; font-weight: 600; color: var(--ink-2); }
  .tile--dark .tile__kicker { color: var(--on-dark-2); }
  .tile__title { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.12; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }
  .tile__text { font-size: 1.0625rem; line-height: 1.47; color: var(--ink-2); text-wrap: pretty; }
  .tile--dark .tile__text { color: var(--on-dark-2); font-size: clamp(1.1875rem, 1.7vw, 1.5rem); line-height: 1.3; font-weight: 500; max-width: 30rem; }
  .tile__big { font-size: clamp(5rem, 13vw, 10rem); line-height: 0.95; font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .tile__big span { font-size: 0.3em; letter-spacing: -0.01em; color: var(--on-dark-2); }
  .tile__num { font-size: clamp(3rem, 5vw, 4rem); line-height: 1; font-weight: 600; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
