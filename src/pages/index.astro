    </footer>
    <script>
      import { arrived, onPage } from '@/scripts/page';
      import { initScroll } from '@/scripts/scroll';
      import { initGoto } from '@/scripts/goto';
      import { initWaves } from '@/scripts/waves';
      import { playHello } from '@/scripts/hello';
      import { initContact } from '@/scripts/contact';
      // Every time the home page is shown, first load included; it all stops when the page is swapped out.
      onPage((signal) => {
        if (!document.querySelector('[data-home]')) return;
        initScroll(signal);
        initGoto(signal);
        const hello = document.querySelector<SVGSVGElement>('[data-home-intro] [data-hello]');
        if (hello) playHello(hello, [...document.querySelectorAll<HTMLElement>('.hero [data-after]')]);
        const waves = document.querySelector<HTMLCanvasElement>('[data-waves]');
        if (waves) void arrived().then(() => {
          if (!signal.aborted) initWaves(waves, signal);
        });
        const contact = document.querySelector<HTMLElement>('[data-contact]');
        if (contact) initContact(contact, signal);
        // The contact section and the footer share the last screen (see .contact): keep the footer's height current.
        const footer = document.querySelector<HTMLElement>('.footer');
        if (footer) {
          const sized = new ResizeObserver(() => document.documentElement.style.setProperty('--footer-h', `${footer.getBoundingClientRect().height}px`));
          sized.observe(footer);
          signal.addEventListener('abort', () => sized.disconnect());
        }
      });
    </script>
