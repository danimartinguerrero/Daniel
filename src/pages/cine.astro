---
import Base from '@/layouts/Base.astro';
import { clean, date, entries, favorites, fetched, lists, poster, profile, quotable, stars } from '@/data/cine';
import { href } from '@/lib/paths';

const reviews = quotable.slice(0, 8);
const counts = [
  { n: profile.films, label: 'películas' },
  { n: profile.thisYear, label: 'este año' },
  { n: profile.watchlist, label: 'por ver' },
  { n: profile.followers, label: 'seguidores' },
];
---
<Base title="Cine · Daniel Martín Guerrero" description={`${profile.films} películas en Letterboxd. Mis favoritas, mi diario y lo que escribo de lo que veo.`} path="/cine" page="cine">
  <section class="cine-top wrap">
    <p class="label">06 · Cine · Letterboxd</p>
    <h1 class="display cine-top__q" lang="en"><em>Unspoken feelings are unforgettable.</em></h1>
    <p class="cine-top__src label">— <b>{profile.quoteSource}</b></p>
    <dl class="counts">
      {counts.map((c) => <div><dt class="label">{c.label}</dt><dd>{c.n}</dd></div>)}
    </dl>
  </section>

  <section class="sec" aria-labelledby="t-favs">
    <div class="wrap sec__grid">
      <div class="sec__side sec__rule"><p class="sec__num">I</p><p class="label">Las cuatro</p></div>
      <div class="sec__main sec__rule">
        <h2 class="sr-only" id="t-favs">Mis cuatro favoritas</h2>
        <ol class="favs">
          {favorites.map((f, i) => (
            <li><span class="favs__n">{String(i + 1).padStart(2, '0')}</span><span class="favs__t">{f.title}</span><span class="favs__m">{f.year} · {f.by}</span></li>
          ))}
        </ol>
        <p class="body note">Un agujero negro, un conejo, un café y una vela. Siempre vuelvo a Tarkovski, Lynch, Bergman y Kurosawa.</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="t-reviews">
    <div class="wrap sec__grid">
      <div class="sec__side sec__rule"><p class="sec__num">II</p><p class="label">Lo que escribo</p></div>
      <div class="sec__main sec__rule">
        <h2 class="sr-only" id="t-reviews">Reseñas</h2>
        <ol class="reviews">
          {reviews.map((e) => (
            <li class="review">
              <a href={e.url} class="review__img" tabindex="-1" aria-hidden="true"><img {...poster(e, '120px')} alt="" loading="lazy" decoding="async" /></a>
              <div>
                <blockquote class="review__q"><p>{clean(e.review.join(' '))}</p></blockquote>
                <p class="review__m"><a class="link" href={e.url}>{e.title}</a>{e.year && <span> · {e.year}</span>} · <span class="review__s" aria-label={`${e.rating} de 5`}>{stars(e.rating)}</span></p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="t-diary">
    <div class="wrap sec__grid">
      <div class="sec__side sec__rule"><p class="sec__num">III</p><p class="label">Diario</p></div>
      <div class="sec__main sec__rule">
        <h2 class="sr-only" id="t-diary">Diario</h2>
        <p class="body note diary__lead">Las últimas {entries.length} entradas, de la más reciente a la más antigua.</p>
        <ul class="grid">
          {entries.map((e) => (
            <li class="film">
              <a href={e.url} class="film__a">
                {e.poster && <img {...poster(e, '(max-width: 520px) 44vw, (max-width: 1200px) 15vw, 170px')} alt="" loading="lazy" decoding="async" />}
                <span class="film__t">{e.title}</span>
                <span class="film__m"><span class="film__s" aria-label={`${e.rating} de 5`}>{stars(e.rating)}</span>{e.liked && <span class="film__like" aria-label="Me gusta">♥</span>}<time class="film__d" datetime={e.watched}>{date(e.watched)}</time></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="t-lists">
    <div class="wrap sec__grid">
      <div class="sec__side sec__rule"><p class="sec__num">IV</p><p class="label">Listas</p></div>
      <div class="sec__main sec__rule">
        <h2 class="sr-only" id="t-lists">Listas</h2>
        {lists.map((l) => (
          <div class="list">
            <h3 class="list__t"><a class="link" href={l.url}>{l.title}</a></h3>
            <p class="list__f">{l.films.join(' · ')}{l.total > l.films.length && <span> · y {l.total - l.films.length} más</span>}</p>
          </div>
        ))}
        <p class="body note">Del diario de Letterboxd a {date(fetched, { day: 'numeric', month: 'long', year: 'numeric' })}. <a class="link arrow" href={profile.url}>Todo en Letterboxd</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .cine-top { padding-top: calc(var(--head) + clamp(72px, 12vw, 160px)); }
  .cine-top__q { margin-top: 24px; max-width: 14ch; font-size: clamp(3rem, 8.4vw, 8.2rem); }
  .cine-top__src { margin-top: 24px; }
  .counts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: clamp(56px, 8vw, 96px); }
  .counts div { display: flex; flex-direction: column-reverse; gap: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .counts dd { font-family: var(--serif); font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 4rem); line-height: 1; letter-spacing: -0.02em; font-variant-numeric: lining-nums tabular-nums; }
  @media (max-width: 620px) { .counts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .note { margin-top: 28px; }

  .favs { border-top: 1px solid var(--line); }
  .favs li { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: baseline; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .favs__n { font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
  .favs__t { font-family: var(--serif); font-weight: 300; font-size: clamp(2rem, 4.6vw, 4.2rem); line-height: 1.02; letter-spacing: -0.025em; }
  .favs__m { font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ink-3); text-align: right; }
  @media (max-width: 620px) { .favs li { grid-template-columns: 2.2rem minmax(0, 1fr); } .favs__m { grid-column: 2; text-align: left; } }

  .reviews { border-top: 1px solid var(--line); }
  .review { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: clamp(16px, 2.4vw, 32px); padding: 28px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .review__img img { width: 96px; height: auto; aspect-ratio: 2 / 3; object-fit: cover; outline: 1px solid var(--line); outline-offset: -1px; }
  .review__q { font-family: var(--serif); font-weight: 300; font-size: clamp(1.3rem, 2.1vw, 1.75rem); line-height: 1.32; letter-spacing: -0.01em; max-width: 36ch; text-wrap: pretty; }
  .review__q p::before { content: '«'; } .review__q p::after { content: '»'; }
  .review__m { margin-top: 14px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ink-3); }
  .review__m .link { color: var(--ink-2); }
  .review__s { color: var(--gold); }
  @media (max-width: 620px) { .review { grid-template-columns: 64px minmax(0, 1fr); } .review__img img { width: 64px; } }

  .diary__lead { margin: 0 0 28px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 32px clamp(12px, 1.6vw, 22px); }
  .film__a { display: grid; gap: 8px; text-decoration: none; }
  .film__a img { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; outline: 1px solid var(--line); outline-offset: -1px; transition: opacity 300ms var(--ease); }
  .film__a:hover img { opacity: 0.82; }
  .film__t { font-size: 14px; line-height: 1.3; color: var(--ink); }
  .film__m { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; font-size: 11.5px; color: var(--ink-3); letter-spacing: 0.04em; }
  .film__s { white-space: nowrap; }
  .film__like { color: var(--gold); }
  .film__d { margin-left: auto; font-family: var(--mono); font-size: 10.5px; white-space: nowrap; }
  @media (max-width: 520px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .list { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .list:first-child { border-top: 1px solid var(--line); }
  .list__t { font-family: var(--serif); font-weight: 300; font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.1; letter-spacing: -0.015em; }
  .list__f { margin-top: 12px; color: var(--ink-2); font-size: 15.5px; line-height: 1.7; max-width: 70ch; }
</style>
