---
/**
 * Music, way c2 (one of four ways to carry the page on downwards): where he makes his beats. It is the
 * music page as it stands (the intro, the carousel, the climb over the records) and then the same
 * stage and camera go on: the guitar and the bass in one more passage, the MPK Mini set down in the
 * middle of the ring, the camera coming down to it, and a loop of two bars turning under a needle of
 * light as the page is scrolled, its pads, keys and knobs moving with it.
 * Behaviour: components/music/c2/climb.ts (v4's climb, carried on), film.ts, shot.ts, pattern.ts.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy } from '@/data/music';
import Headline from '@/components/music/v4/Headline.astro';
import Carousel from '@/components/music/v4/Carousel.astro';
import Caption from '@/components/music/v4/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import Beats from '@/components/music/c2/Beats.astro';
import { c2Copy } from '@/components/music/c2/copy';
import '@/components/music/v4/listening-bar.css';
import '@/components/music/c2/c2.css';

const passages = [...musicCopy.collection, c2Copy.playing];
const { credit } = c2Copy;
---
<MusicShell title="Music">
  <main id="main" class="v4" data-music-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <Headline />
          <p class="lede" data-intro-rest>{musicCopy.lede}</p>
        </div>
      </section>

      <!-- The shelf, the climb, and this way's film after it: the stage stays on screen for all of it. -->
      <section class="v4-shelf" aria-labelledby="v4-shelf-title" data-intro-rest data-climb>
        <div class="v4-climb__stage" data-climb-stage>
          <div class="v4-floor" aria-hidden="true" data-climb-floor></div>
          <div class="v4-bar">
            <div class="v4-bar__wall" aria-hidden="true" data-climb-wall></div>
            <!-- The heading hangs on the wall above the records, on the page's left edge. -->
            <header class="container v4-shelf__head" data-climb-head>
              <p class="eyebrow v4-eyebrow">{musicCopy.shelf.eyebrow}</p>
              <h2 class="v4-shelf__title" id="v4-shelf-title">{musicCopy.shelf.headline}</h2>
              <p class="lede v4-shelf__lede">{musicCopy.shelf.lede}</p>
            </header>
            <Carousel />
          </div>

          <Caption />

          <div class="v4-making" data-climb-words>
            {passages.map((passage) => (
              <p class="v4-making__page" data-climb-page>
                {passage.split(' ').map((word) => <><span class="w" data-w>{word}</span>{' '}</>)}
              </p>
            ))}
          </div>

          <Beats />
        </div>
      </section>

      <p class="c2-credit">
        3D model: <a href={credit.source} rel="noopener">“{credit.title}” by {credit.author}</a>,
        <a href={credit.licenceUrl} rel="noopener license">{credit.licence}</a>, with its logos removed and its parts set moving.
      </p>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/c2/climb';
  import '@/components/music/v4/intro';
</script>
