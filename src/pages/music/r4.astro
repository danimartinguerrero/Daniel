---
/**
 * Music, direction 4 of four: "Spectrum". The six bands of the word "music" leave it and cross the
 * page as one printed sash, behind the records, down to the floor they stand on. At rest it holds
 * still; while the island's song plays, each band follows its own part of the song's spectrum.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import Headline from '@/components/music/v4/Headline.astro';
import Carousel from '@/components/music/v4/Carousel.astro';
import Caption from '@/components/music/v4/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import Sash from '@/components/music/r4/Sash.astro';
import { copy } from '@/components/music/r4/copy';
import '@/components/music/v4/listening-bar.css';
import '@/components/music/r4/r4.css';
---
<MusicShell title="Music">
  <main id="main" class="v4 r4" data-music-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <Headline />
          <p class="lede" data-intro-rest>{copy.lede}</p>
        </div>
      </section>

      <!-- The shelf comes in part by part after the headline (intro.ts); the sash has an entrance of
           its own (r4.ts), so it is not inside anything that fades. -->
      <section class="v4-shelf" aria-labelledby="v4-shelf-title">
        <div class="v4-bar">
          <!-- The wall behind the records: the sash, from the top of the page down behind the row. -->
          <Sash />
          <header class="container v4-shelf__head" data-intro-rest>
            <p class="eyebrow v4-eyebrow">{copy.shelf.eyebrow}</p>
            <h2 class="v4-shelf__title" id="v4-shelf-title">{copy.shelf.headline}</h2>
            <p class="lede v4-shelf__lede">{copy.shelf.lede.map((line, i) => <>{i > 0 && ' '}<span class="r4-sentence">{line}</span></>)}</p>
          </header>
          <!-- The records, standing on the floor: a printed rule along their feet. -->
          <div class="r4-stand" data-intro-rest>
            <Carousel />
          </div>
        </div>

        <div data-intro-rest>
          <Caption />
        </div>
      </section>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/v4/intro';
  import '@/components/music/r4/r4';
</script>
