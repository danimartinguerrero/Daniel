---
/**
 * Music, direction 2 of four: "Listening room". The first screen is one room: a slatted wall lit by a
 * single lamp from above, the headline on that wall, and the records standing on a dark lacquered
 * counter that reflects them. The intro and the records are today's (v4); what is new is the room.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import Headline from '@/components/music/v4/Headline.astro';
import Carousel from '@/components/music/r2/Carousel.astro';
import Caption from '@/components/music/v4/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import { copy } from '@/components/music/r2/copy';
import '@/components/music/v4/listening-bar.css';
import '@/components/music/r2/r2.css';
---
<MusicShell title="Music">
  <main id="main" class="v4 r2" data-music-page data-intro data-intro-own>
    <div class="v4-page" data-v4-page>
      <!-- One room: everything down to the counter's front is in it. Its wall, light and counter are
           drawn under the records' row, anchored to it (.r2-stage), and painted beneath everything. -->
      <div class="v4-bar r2-room">
        <!-- The wall, lit by the lamp: the cone, then the light it throws back into the room. Each is
             the same slats seen in that light (a face tile, and the chamfers that face the lamp). -->
        <div class="r2-wall" aria-hidden="true">
          <div class="r2-light r2-light--cone" data-r2-light="cone"><i class="r2-slats"></i><i class="r2-slats r2-slats--l"></i><i class="r2-slats r2-slats--r"></i></div>
          <div class="r2-light r2-light--spill" data-r2-light="spill"><i class="r2-slats"></i><i class="r2-slats r2-slats--l"></i><i class="r2-slats r2-slats--r"></i></div>
        </div>
        <section class="v4-intro r2-intro" aria-labelledby="v4-title">
          <div class="container v4-intro__inner">
            <Headline />
            <p class="lede" data-intro-rest>{copy.lede}</p>
          </div>
        </section>

        <section class="v4-shelf r2-shelf" aria-labelledby="v4-shelf-title">
          <header class="container v4-shelf__head r2-shelf__head" data-intro-rest>
            <h2 class="v4-shelf__title" id="v4-shelf-title">{copy.shelf.headline}</h2>
            <p class="lede v4-shelf__lede">{copy.shelf.lede}</p>
          </header>
          <div class="r2-stage">
            <div class="r2-counter" aria-hidden="true"><div class="r2-counter__lit" data-r2-light="counter"></div></div>
            <div class="r2-records" data-intro-rest>
              <Carousel />
            </div>
          </div>
          <div class="r2-caption" data-intro-rest>
            <Caption />
          </div>
        </section>
      </div>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/r2/intro';
  import '@/components/music/r2/r2';
</script>
