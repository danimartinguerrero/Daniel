---
/**
 * Music: the "Listening bar" (design 4 of the four that were tried). The records stand in a carousel
 * that turns sideways and comes round again; the one in the middle faces you. Tap it and it comes to
 * the front, still sealed, and its tear tape appears. Pull the
 * tab across the plastic to unwrap it; the disc slides out of the sleeve and the details follow. Put
 * it back and it goes back sealed, ready to be unwrapped again.
 * Behaviour lives in components/music/v4/listening-bar.ts.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy, vinyls } from '@/data/music';
import { sleeveImg, stripTone, labelColor } from '@/components/music/v4/sleeve';
import '@/components/music/v4/listening-bar.css';

// The record the carousel opens on (the script uses the same index).
const START = 3;
const first = vinyls[START]!;
// The headline in its parts for the intro (intro.ts): "I love", then the word that takes the rainbow,
// then what follows it.
const at = musicCopy.headline.lastIndexOf('music');
const love = musicCopy.headline.slice(0, at).trimEnd();
const tail = musicCopy.headline.slice(at + 'music'.length);
// The carousel's resting pose before the script takes over (it recomputes the same pose in px). It is
// a ring: a record more than half-way round is counted from the other side.
const pose = (i: number) => {
  const n = vinyls.length;
  const d = i - START - n * Math.round((i - START) / n);
  const ad = Math.abs(d), near = Math.min(ad, 1), sg = Math.sign(d);
  const far = Math.max(0, ad - 1), deep = Math.max(0, far - 2);
  const spread = far - deep + 0.6 * (1 - Math.exp(-deep / 0.6)); // the pile at each end
  const x = sg * (near * 66 + Math.sin(Math.PI * near) * 5 + spread * 26);
  return {
    transform: `translate3d(${x.toFixed(2)}%,0,0) perspective(572px) rotateY(${-sg * near * 60}deg) scale(${(1 - near * 0.14 - Math.min(deep, 1) * 0.04).toFixed(4)})`,
    zIndex: String(1000 - Math.round(ad)),
    shade: (near * 0.38 + Math.min(far, 2) * 0.12 + 0.38 * Math.min(1, (deep / Math.max(0.5, n / 2 - 3)) * 1.6)).toFixed(3),
    opacity: String(Math.max(0, Math.min(1, (n / 2 - ad) * 2))),
  };
};
---
<MusicShell title="Music">
  <main id="main" class="v4" data-music-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <h1 class="headline v4-intro__title" id="v4-title"><span class="v4-love" data-intro-love>{love.split(' ').map((w, i) => <>{i > 0 && ' '}<span data-intro-w>{w}</span></>)}</span> <span class="v4-word" data-intro-word><span class="v4-music">music<span class="v4-music__bands" aria-hidden="true"><span class="v4-music__rush" data-rainbow-rush><span class="v4-music__rainbow" data-rainbow></span></span></span></span><span class="v4-tail">{tail}</span></span></h1>
          <p class="lede" data-intro-rest>{musicCopy.lede}</p>
        </div>
      </section>

      <section class="v4-shelf" aria-labelledby="v4-shelf-title" data-intro-rest>
        <div class="v4-bar">
          <div class="v4-bar__wall" aria-hidden="true"></div>
          <!-- The heading hangs on the wall above the records, on the page's left edge. -->
          <header class="container v4-shelf__head">
            <p class="eyebrow v4-eyebrow">{musicCopy.shelf.eyebrow}</p>
            <h2 class="v4-shelf__title" id="v4-shelf-title">{musicCopy.shelf.headline}</h2>
            <p class="lede v4-shelf__lede">{musicCopy.shelf.lede}</p>
          </header>
          <div class="v4-row" data-v4-row>
            <div class="v4-row__track">
              {vinyls.map((v, i) => {
                const p = pose(i);
                return (
                  <button
                    class="v4-vinyl"
                    type="button"
                    data-vinyl={v.id}
                    data-tone={stripTone(v)}
                    data-label={labelColor(v)}
                    data-start={i === START ? '' : undefined}
                    aria-label={`${v.title} by ${v.artist}`}
                    style={`transform:${p.transform};z-index:${p.zIndex};opacity:${p.opacity}`}
                  >
                    <span class="v4-vinyl__face">
                      <span class="v4-art" set:html={sleeveImg(v)} />
                      <span class="v4-vinyl__gloss" />
                      <span class="v4-vinyl__shade" data-v4-shade style={`opacity:${p.shade}`} />
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <p class="v4-caption" aria-hidden="true" data-v4-caption>
          <span class="v4-caption__title" data-v4-cap-title>{first.title}</span>
          <span class="v4-caption__meta" data-v4-cap-meta>{first.artist}, {first.year}</span>
        </p>
      </section>
    </div>

    <div class="v4-open" data-v4-open hidden role="dialog" aria-modal="true" aria-labelledby="v4-open-title">
      <div class="v4-open__scrim" data-v4-scrim></div>
      <div class="v4-open__scroll" data-v4-scroll>
        <div class="v4-open__inner">
          <div class="v4-stage" data-v4-stage>
            <div class="v4-rec" data-v4-hero>
              <div class="v4-rec__group" data-v4-group>
                <div class="v4-disc" data-v4-disc aria-hidden="true">
                  <div class="v4-disc__shadow" data-v4-disc-shadow></div>
                  <div class="v4-disc__sheen"></div>
                  <div class="v4-disc__label"></div>
                </div>
                <div class="v4-rec__sleeve">
                  <div class="v4-rec__shadow" data-v4-shadow aria-hidden="true"></div>
                  <div class="v4-art v4-rec__art" data-v4-art aria-hidden="true"></div>
                  <!-- The shrink-wrap: clear film in two pieces either side of the tear strip. Each piece
                       carries two lights: the film pulled taut, and the same film gone slack, which shows
                       as the strip comes off. -->
                  <div class="v4-plastic" data-v4-plastic aria-hidden="true">
                    {(['top', 'bottom'] as const).map((side) => (
                      <div class={`v4-film v4-film--${side}`} data-v4-film={side}>
                        <div class="v4-film__win"><div class="v4-film__body" data-v4-film-body></div><div class="v4-film__sheet" data-v4-sheet></div><div class="v4-film__slack" data-v4-slack></div><div class="v4-film__edge" data-v4-film-edge></div></div>
                      </div>
                    ))}
                    <!-- In the row the film is one unbroken sheet. This piece is the film where the tape
                         will be: it is there as the record comes out and goes as the tape appears. -->
                    <div class="v4-film v4-film--mid" data-v4-film-mid>
                      <div class="v4-film__win"><div class="v4-film__sheet"></div></div>
                    </div>
                  </div>
                  <!-- The lamp's light and the film's edge as a sleeve in the row has them: the record
                       takes them on as it flies back, and lets them go as it comes out. -->
                  <div class="v4-rec__lamp" data-v4-lamp aria-hidden="true"></div>
                  <div class="v4-strip" data-unwrap>
                    <div class="v4-strip__win" data-v4-strip-win>
                      <div class="v4-strip__band" data-v4-strip-band>
                        <span class="v4-strip__sweep" data-v4-sweep></span>
                        <span class="v4-strip__label" data-v4-strip-label aria-hidden="true">{musicCopy.record.unwrap}</span>
                      </div>
                    </div>
                  </div>
                  <div
                    class="v4-tab"
                    data-unwrap-handle
                    role="slider"
                    tabindex="0"
                    aria-label={musicCopy.record.unwrap}
                    aria-describedby="v4-unwrap-hint"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                    aria-orientation="horizontal"
                  >
                    <span class="v4-tab__knob">
                      <span class="v4-tab__dot">
                        <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M2.5 8h10.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div class="v4-open__titles" data-v4-titles>
              <h2 class="v4-open__title" id="v4-open-title" tabindex="-1" data-v4-title></h2>
              <p class="v4-open__meta" data-v4-meta></p>
              <p class="v4-open__hint" id="v4-unwrap-hint" data-v4-hint>{musicCopy.record.unwrapHint}</p>
            </div>
          </div>

          <div class="v4-details" data-v4-details hidden>
            <section class="v4-block v4-block--why">
              <h3 class="v4-block__title">{musicCopy.record.about}</h3>
              <p class="v4-why" data-v4-about></p>
              <a class="v4-source" data-v4-source target="_blank" rel="noopener">
                <!-- Apple Music's mark: its red tile with the note in white (the note is Hugeicons' AppleMusicIcon). -->
                <svg class="v4-source__logo" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <defs><linearGradient id="v4-am" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fa5c76" /><stop offset="1" stop-color="#fa233b" /></linearGradient></defs>
                  <rect width="24" height="24" rx="5.4" fill="url(#v4-am)" />
                  <path d="M9.05181 16.0523L7.44711 16.6596C7.17802 16.7615 7 17.0193 7 17.3071C7 17.7968 7.49439 18.1317 7.94888 17.9498L8.87139 17.5806C9.25105 17.4287 9.5 17.0608 9.5 16.6517V9.5M15.5518 14.5517L13.9471 15.159C13.678 15.2608 13.5 15.5186 13.5 15.8064C13.5 16.2961 13.9944 16.631 14.4489 16.4491L15.3714 16.08C15.751 15.928 16 15.5602 16 15.1511V8.20125M9.5 9.5L16 8.20125M9.5 9.5V8.65872M16 8.20125V7.35063M16 7.35063V6.5L9.5 7.81743V8.65872M16 7.35063L9.5 8.65872" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span data-v4-source-label></span>
              </a>
            </section>
            <section class="v4-block v4-block--tracks">
              <h3 class="v4-block__title">{musicCopy.record.tracklist}</h3>
              <ol class="v4-tracks" data-tracklist></ol>
            </section>
            <section class="v4-block v4-block--info" data-record-info>
              <h3 class="v4-block__title">{musicCopy.record.info}</h3>
              <dl class="v4-facts" data-v4-facts></dl>
            </section>
          </div>

          <div class="v4-open__bar" data-v4-bar>
            <button class="pill pill--glass v4-close" type="button" data-record-close>{musicCopy.record.close}</button>
          </div>
        </div>
      </div>
      <div class="v4-open__edge" data-v4-edge aria-hidden="true"></div>
    </div>
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/v4/intro';
</script>
