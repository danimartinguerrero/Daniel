---
/**
 * Music, design 1: "Spines". The records stand spine-out on a walnut shelf. Tap one and it slides up
 * out of the row and turns to face you, still sealed; slide the tab across the plastic to unwrap it.
 * Behaviour: src/components/music/v1/shelf.ts. Styles: src/components/music/v1/v1.css.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy, vinyls } from '@/data/music-sleeves';
import { sleeveSvg } from '@/components/music/v1/sleeve';
import '@/components/music/v1/v1.css';

// Thickness of a spine, as a share of the record's height: a double album is fatter.
const thickness = (format: string) => (format.startsWith('2') ? 0.2 : 0.15);
// Ink for the tear tab's arrow: dark on a light accent, white on a dark one.
const ink = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b! > 0.3 ? '#1d1d1f' : '#fff';
};
---
<MusicShell title={musicCopy.eyebrow}>
  <main id="main" class="v1" data-music-page>
    <div class="v1-backdrop" data-backdrop>
      <section class="v1-hero" aria-labelledby="v1-hero-title">
        <div class="container v1-hero__inner">
          <p class="eyebrow v1-eyebrow">{musicCopy.eyebrow}</p>
          <h1 class="headline" id="v1-hero-title">{musicCopy.headline}</h1>
          <p class="lede v1-lede">{musicCopy.lede}</p>
        </div>
      </section>

      <section class="v1-shelf" aria-labelledby="v1-shelf-title">
        <header class="container v1-shelf__intro">
          <p class="eyebrow v1-eyebrow">{musicCopy.shelf.eyebrow}</p>
          <h2 class="headline" id="v1-shelf-title">{musicCopy.shelf.headline}</h2>
          <p class="lede v1-lede">{musicCopy.shelf.lede}</p>
        </header>

        <div class="v1-scroller" data-scroller>
          <div class="v1-cab">
            <div class="v1-cab__niche">
              <ul class="v1-row" role="list">
                {vinyls.map((v) => (
                  <li class="v1-row__item">
                    <button
                      type="button"
                      class="v1-spine"
                      data-vinyl={v.id}
                      aria-label={`${v.title} by ${v.artist}`}
                      aria-haspopup="dialog"
                      style={`--k: ${thickness(v.format)}; --bg: ${v.palette[1]}; --fg: ${v.palette[2]}; --ac: ${v.palette[3]}; --deep: ${v.palette[0]}`}
                    >
                      <span class="v1-spine__face v1-spineart" aria-hidden="true">
                        <span class="v1-spineart__cap"></span>
                        <span class="v1-spineart__text"><span class="v1-spineart__title">{v.title}</span><span class="v1-spineart__artist">{v.artist}</span></span>
                        <span class="v1-spineart__fmt">{v.format}</span>
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
            <div class="v1-cab__ledge" aria-hidden="true"></div>
          </div>
        </div>
      </section>
    </div>

    <div class="v1-stage" data-stage hidden>
      <div class="v1-stage__scrim" data-scrim></div>
      <div class="v1-stage__scroll" data-stage-scroll>
        {vinyls.map((v) => (
          <template data-tpl={v.id}><article
            class="v1-rec"
            data-rec={v.id}
            role="dialog"
            aria-modal="true"
            aria-labelledby={`v1-rec-${v.id}-title`}
            style={`--k: ${thickness(v.format)}; --bg: ${v.palette[1]}; --fg: ${v.palette[2]}; --ac: ${v.palette[3]}; --deep: ${v.palette[0]}; --light: ${v.palette[2]}; --ink: ${ink(v.palette[3])}`}
          >
            <div class="v1-rec__glow" data-glow aria-hidden="true"></div>

            <div class="v1-rec__slot" data-slot>
              <div class="v1-rec__shadow" data-shadow aria-hidden="true"></div>
              <div class="v1-box" data-box aria-hidden="true">
                <div class="v1-disc" data-disc>
                  <div class="v1-disc__label"><span>{v.title}</span><span>{v.artist}</span></div>
                </div>
                <div class="v1-face v1-face--back"></div>
                <div class="v1-face v1-face--right"></div>
                <div class="v1-face v1-face--top"></div>
                <div class="v1-face v1-face--bottom"></div>
                <div class="v1-face v1-face--spine v1-spineart">
                  <span class="v1-spineart__cap"></span>
                  <span class="v1-spineart__text"><span class="v1-spineart__title">{v.title}</span><span class="v1-spineart__artist">{v.artist}</span></span>
                  <span class="v1-spineart__fmt">{v.format}</span>
                </div>
                <div class="v1-face v1-face--front">
                  <Fragment set:html={sleeveSvg(v)} />
                  <div class="v1-film" data-film>
                    <div class="v1-film__half v1-film__half--top" data-film-half>
                      <div class="v1-film__sheen" data-sheen></div>
                      <span class="v1-sticker"><span>{v.format}</span></span>
                    </div>
                    <div class="v1-film__half v1-film__half--bottom" data-film-half>
                      <div class="v1-film__sheen" data-sheen></div>
                    </div>
                    <div class="v1-strip">
                      <div class="v1-strip__win" data-strip-win>
                        <div class="v1-strip__band" data-strip-band><span>{musicCopy.record.unwrap}</span></div>
                      </div>
                      <div class="v1-strip__tab" data-tab>
                        <svg viewBox="0 0 16 16"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="v1-unwrap" data-unwrap>
                <span class="sr-only" id={`v1-rec-${v.id}-hint`}>{musicCopy.record.unwrapHint}</span>
                <div
                  class="v1-unwrap__handle"
                  data-unwrap-handle
                  role="slider"
                  tabindex="0"
                  aria-label={musicCopy.record.unwrap}
                  aria-describedby={`v1-rec-${v.id}-hint`}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                ></div>
              </div>
            </div>

            <div class="v1-rec__lift" data-lift>
              <header class="v1-rec__head" data-head>
                <h2 class="v1-rec__title" id={`v1-rec-${v.id}-title`} tabindex="-1">{v.title}</h2>
                <p class="v1-rec__artist">{v.artist}</p>
              </header>

              <div class="v1-details">
                <section class="v1-details__why" data-record-why>
                  <h3 class="v1-details__label">{musicCopy.record.about}</h3>
                  <p>{v.about}</p>
                </section>
                <section class="v1-details__tracks">
                  <h3 class="v1-details__label">{musicCopy.record.tracklist}</h3>
                  <ol class="v1-tracks" data-tracklist role="list">
                    {v.tracks.map((t, i) => <li><span class="v1-tracks__n" aria-hidden="true">{i + 1}</span><span class="v1-tracks__t">{t}</span></li>)}
                  </ol>
                </section>
                <section class="v1-details__info" data-record-info>
                  <h3 class="v1-details__label">{musicCopy.record.info}</h3>
                  <dl class="v1-info">
                    <div><dt>{musicCopy.record.fields.year}</dt><dd>{v.year}</dd></div>
                    <div><dt>{musicCopy.record.fields.tracks}</dt><dd>{v.tracks.length}</dd></div>
                    <div class="v1-info__wide"><dt>{musicCopy.record.fields.label}</dt><dd>{v.label}</dd></div>
                    <div><dt>{musicCopy.record.fields.genre}</dt><dd>{v.genre}</dd></div>
                    <div><dt>{musicCopy.record.fields.format}</dt><dd>{v.format}</dd></div>
                  </dl>
                </section>
              </div>
            </div>

            <div class="v1-rec__fade-top" data-fade-top aria-hidden="true"></div>
            <div class="v1-rec__fade" data-fade aria-hidden="true"></div>
            <button type="button" class="pill pill--glass v1-rec__close" data-record-close>{musicCopy.record.close}</button>
          </article></template>
        ))}
      </div>
    </div>
  </main>
</MusicShell>

<script>
  import '@/components/music/v1/shelf';
</script>
