---
/**
 * Music, way "radio": the music page as it is, carried on downwards by a radio session. Past the ring
 * and its three passages, the records come up out of the ring one at a time, oldest first, and stand
 * in the middle of it, named underneath with the year rolling on from the one before; twice the
 * presenter talks between them (components/music/radio/session.ts). Everything above that is /music.
 *
 * The page's modules are copies in components/music/radio, so the live page is left alone; the root is
 * marked data-radio-page rather than data-music-page, so the music page's own modules, if the visit has
 * loaded them, leave it alone too.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy } from '@/data/music';
import Headline from '@/components/music/radio/Headline.astro';
import Carousel from '@/components/music/radio/Carousel.astro';
import Caption from '@/components/music/radio/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import Session from '@/components/music/radio/Session.astro';
import { RUN } from '@/components/music/radio/session';
import '@/components/music/radio/base.css';
import '@/components/music/radio/radio.css';
---
<MusicShell title="Music">
  <main id="main" class="v4 radio" data-radio-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <Headline />
          <p class="lede" data-intro-rest>{musicCopy.lede}</p>
        </div>
      </section>

      <!-- The shelf, the climb over the records, and the session in the ring (climb.ts). The stage stays
           on screen for that whole stretch of the scroll. -->
      <section class="v4-shelf" aria-labelledby="v4-shelf-title" data-intro-rest data-climb style={`--climb-run:${RUN}svh`}>
        <div class="v4-climb__stage" data-climb-stage>
          <div class="v4-floor" aria-hidden="true" data-climb-floor></div>
          <div class="v4-bar">
            <div class="v4-bar__wall" aria-hidden="true" data-climb-wall></div>
            <header class="container v4-shelf__head" data-climb-head>
              <p class="eyebrow v4-eyebrow">{musicCopy.shelf.eyebrow}</p>
              <h2 class="v4-shelf__title" id="v4-shelf-title">{musicCopy.shelf.headline}</h2>
              <p class="lede v4-shelf__lede">{musicCopy.shelf.lede}</p>
            </header>
            <Carousel />
          </div>

          <Caption />

          <div class="v4-making" data-climb-words>
            {musicCopy.collection.map((passage) => (
              <p class="v4-making__page" data-climb-page>
                {passage.split(' ').map((word) => <><span class="w" data-w>{word}</span>{' '}</>)}
              </p>
            ))}
          </div>

          <Session />
        </div>
      </section>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/radio/listening-bar';
  import '@/components/music/radio/climb';
  import '@/components/music/radio/intro';
</script>
