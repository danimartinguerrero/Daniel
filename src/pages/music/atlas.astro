---
/**
 * Music, way "atlas": what the records share. It is the music page (index.astro) with a longer climb:
 * once the passages in the middle of the ring have been read, the camera rises a little further and
 * the floor becomes a map. One route at a time, a thread of light is drawn with the scroll from one
 * record to another (a guest, a producer, a genre, an idea they share), its name written along it,
 * the records it isn't about stepping back into the dark, and a line under the ring saying what it is.
 * At the end every thread is there at once, and they go round with the ring under a hand.
 * Everything above that is /music as it is. Behaviour: components/music/atlas/climb.ts.
 */
import MusicShell from '@/components/music/MusicShell.astro';
import { musicCopy } from '@/data/music';
import Headline from '@/components/music/v4/Headline.astro';
import Carousel from '@/components/music/v4/Carousel.astro';
import Caption from '@/components/music/v4/Caption.astro';
import OpenRecord from '@/components/music/v4/OpenRecord.astro';
import Atlas from '@/components/music/atlas/Atlas.astro';
import '@/components/music/v4/listening-bar.css';
import '@/components/music/atlas/atlas.css';
---
<MusicShell title="Music">
  <main id="main" class="v4 atlas" data-music-page data-intro>
    <div class="v4-page" data-v4-page>
      <section class="v4-intro" aria-labelledby="v4-title">
        <div class="container v4-intro__inner">
          <Headline />
          <p class="lede" data-intro-rest>{musicCopy.lede}</p>
        </div>
      </section>

      <!-- The shelf and the climb, as on the music page; the stage stays on screen for longer, and the
           scroll goes on to the threads between the records once the passages have been read
           (atlas/climb.ts). -->
      <section class="v4-shelf" aria-labelledby="v4-shelf-title" data-intro-rest data-climb style="--climb-run: 735svh">
        <div class="v4-climb__stage" data-climb-stage>
          <div class="v4-floor" aria-hidden="true" data-climb-floor></div>
          <Atlas part="threads" />
          <div class="v4-bar">
            <div class="v4-bar__wall" aria-hidden="true" data-climb-wall></div>
            <header class="container v4-shelf__head" data-climb-head>
              <p class="eyebrow v4-eyebrow">{musicCopy.shelf.eyebrow}</p>
              <h2 class="v4-shelf__title" id="v4-shelf-title">{musicCopy.shelf.headline}</h2>
              <p class="lede v4-shelf__lede">{musicCopy.shelf.lede}</p>
            </header>
            <Carousel />
          </div>

          <div class="atlas-capwrap" data-atlas-capwrap><Caption /></div>

          <div class="v4-making" data-climb-words>
            {musicCopy.collection.map((passage) => (
              <p class="v4-making__page" data-climb-page>
                {passage.split(' ').map((word) => <><span class="w" data-w>{word}</span>{' '}</>)}
              </p>
            ))}
          </div>

          <Atlas part="map" />
        </div>
      </section>
    </div>

    <OpenRecord />
  </main>
</MusicShell>

<script>
  import '@/components/music/v4/listening-bar';
  import '@/components/music/atlas/climb';
  import '@/components/music/v4/intro';
</script>
