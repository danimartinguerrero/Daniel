---
/**
 * Daniel's photographs as plates on a light table: justified rows that fill the width, each picture at
 * its own proportions (flex-grow by aspect ratio, so no crop). Each one develops as it comes into view,
 * like an exposed plate: light uncovers it from the centre and the overexposure settles. Under the
 * pointer, a loupe shows it at full resolution; pressed, it opens whole (Zoom.astro). Items name a file
 * in public/photos/ (sizes in src/data/photos.json).
 */
import meta from '@/data/photos.json';
import { href } from '@/lib/paths';

interface Item { id: keyof typeof meta; title: string; note?: string }
interface Props { items: Item[]; label: string; tall?: boolean }
const { items, label, tall = false } = Astro.props;
const src = (id: string, w: number) => href(`/photos/${id}-${w}.webp`);
const group = label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<div class:list={['plates', { 'plates--tall': tall }]}>
  <div class="wrap">
    <ol class="plates__grid" aria-label={label}>
      {items.map((it, i) => {
        const m = meta[it.id];
        const big = m.w[m.w.length - 1];
        return (
          <li class="plate" style={`--r: ${m.ratio}`} data-plate>
            <figure>
              <span class="plate__frame">
                <img src={src(it.id, m.w[0])} srcset={m.w.map((w) => `${src(it.id, w)} ${w}w`).join(', ')}
                  sizes={`(max-width: 700px) 92vw, ${Math.round(Math.min(1, m.ratio / 3) * 100)}vw`} alt={it.title}
                  width={m.w[0]} height={Math.round(m.w[0] / m.ratio)} loading="lazy" decoding="async" data-wave="pan"
                  data-zoom data-full={src(it.id, big)} data-full-w={big} data-group={group} data-caption={`${it.title}${it.note ? ` — ${it.note}` : ''}`} />
              </span>
              <figcaption><span class="plate__n">{String(i + 1).padStart(2, '0')}</span><span class="plate__t">{it.title}</span>{it.note && <span class="plate__note">{it.note}</span>}</figcaption>
            </figure>
          </li>
        );
      })}
      <li class="plates__end" aria-hidden="true"></li>
    </ol>
  </div>
</div>

<style>
  .plates { margin-top: clamp(40px, 5vw, 64px); }
  /* Justified rows: every plate grows in proportion to its aspect ratio from a base height, so a row's
     plates share one height and keep their shape; the last row doesn't stretch (the filler soaks it up). */
  .plates__grid { --h: clamp(200px, 26vw, 330px); display: flex; flex-wrap: wrap; gap: clamp(10px, 1.2vw, 18px); }
  .plates--tall .plates__grid { --h: clamp(220px, 30vw, 400px); }
  .plate { flex: var(--r) var(--r) calc(var(--h) * var(--r)); min-width: 0; }
  .plates__end { flex: 1000 1 0; height: 0; }
  .plates__grid.is-laid .plate { flex: none; }
  .plates__grid.is-laid .plates__end { display: none; }
  .plate figure { margin: 0; display: grid; gap: 10px; }
  .plate__frame { display: block; aspect-ratio: var(--r); overflow: hidden; background: #050506; outline: 1px solid var(--line); outline-offset: -1px; }
  .plate__frame img { display: block; width: 100%; height: 100%; cursor: zoom-in; }
  .plate figcaption { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 10px; align-items: baseline; font-size: 13px; line-height: 1.4; }
  .plate__n { grid-row: span 2; font-family: var(--mono); font-size: 10.5px; color: var(--gold); }
  .plate__t { font-family: var(--serif); font-size: 1.02rem; color: var(--ink); }
  .plate__note { color: var(--ink-3); }
  /* Developing: light spreads from the centre of the plate and the overexposure settles. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .plate__frame img { clip-path: circle(0% at 50% 50%); filter: brightness(2.6) contrast(0.6) saturate(0); transition: clip-path 1500ms cubic-bezier(0.65, 0, 0.35, 1), filter 2600ms var(--ease) 300ms; }
    :global(html.js) .plate.is-in .plate__frame img { clip-path: circle(75% at 50% 50%); filter: none; }
  }
  @media (max-width: 700px) {
    .plates__grid { --h: 170px; }
  }
</style>

<script>
  // Justified rows, laid out properly: plates are added to a row until, scaled to fill the width, the
  // row would be no taller than the target height; the last row keeps the target height and is not
  // stretched. (Without the script, CSS flex-grow gives an approximation.)
  document.querySelectorAll<HTMLElement>('.plates__grid').forEach((grid) => {
    const plates = [...grid.querySelectorAll<HTMLElement>('[data-plate]')];
    const ratios = plates.map((p) => parseFloat(p.style.getPropertyValue('--r')));
    const layout = () => {
      const cs = getComputedStyle(grid);
      const W = grid.clientWidth, gap = parseFloat(cs.columnGap) || 12;
      const probe = document.createElement('div'); probe.style.height = 'var(--h)'; grid.append(probe);
      const target = probe.getBoundingClientRect().height || 280; probe.remove();
      let row: number[] = [], sum = 0;
      const place = (idx: number[], h: number) => idx.forEach((i) => { plates[i].style.width = `${Math.floor(ratios[i] * h)}px`; });
      ratios.forEach((r, i) => {
        row.push(i); sum += r;
        const h = (W - gap * (row.length - 1)) / sum;
        if (h <= target) { place(row, h); row = []; sum = 0; }
      });
      if (row.length) place(row, Math.min(target, (W - gap * (row.length - 1)) / sum));
      grid.classList.add('is-laid');
    };
    new ResizeObserver(layout).observe(grid);
  });

  // Each plate develops once, as it comes into view, a little after the one before it.
  const io = new IntersectionObserver((entries) => {
    entries.filter((e) => e.isIntersecting).forEach((e, k) => {
      setTimeout(() => e.target.classList.add('is-in'), k * 140);
      io.unobserve(e.target);
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('[data-plate]').forEach((p) => io.observe(p));
</script>
