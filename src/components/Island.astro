---
/**
 * The navigation as the island. The shape, springs and crossfades are islandcn's engine
 * (src/lib/island, MIT, vendored from github.com/opencoredev/islandcn); IslandNav.tsx decides when it
 * opens and what it holds. Without JavaScript the links show as a plain bar instead.
 */
import { IslandNav } from './IslandNav';
---
<IslandNav client:load />
<noscript>
  <nav class="island-fallback" aria-label="Primary">
    <a href="#projects">Projects</a>
    <a href="#studies">Studies</a>
    <a href="#how-i-work">How I work</a>
    <a href="#contact">Contact</a>
  </nav>
</noscript>

<style is:global>
  /* The hit area sits exactly over the resting pill (islandMetrics.idle, 13.91 from the top). */
  .island-nav__hit {
    position: fixed; top: 13.91px; left: 50%; z-index: 51;
    translate: -50% 0;
    width: 94.85px; height: 36.84px; border-radius: 18.42px;
    border: 0; padding: 0; background: none; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 200ms ease;
  }
  .island-nav__hit:focus-visible { outline-offset: 3px; }
  /* On a dark page the resting pill would melt into it: a hairline ring keeps it findable. Open, the
     engine's own keyline takes over. */
  .island-nav[data-dark]:not([data-open]) .island-nav__hit { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22); }

  .island-nav__links {
    display: flex; align-items: center; justify-content: center; gap: 2px;
    padding-top: 2px;
    white-space: nowrap;
  }
  .island-nav__link {
    display: block; padding: 8px 11px; border-radius: 20px;
    font: 500 15px/20px -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    letter-spacing: -0.01em; color: var(--on-dark); text-decoration: none;
    transition: background-color 150ms ease;
  }
  .island-nav__link:last-child { background: var(--on-dark); color: #000; margin-left: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .island-nav__link:not(:last-child):hover { background: rgba(255, 255, 255, 0.14); }
  }
  .island-nav__link:not(:last-child):active { background: rgba(255, 255, 255, 0.14); transition-duration: 0ms; }
  .island-nav__link:last-child:active { background: #d2d2d7; transition-duration: 0ms; }

  /* Narrow phones: two by two, so every label keeps its size. */
  @media (max-width: 400px) {
    .island-nav__links { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .island-nav__link { text-align: center; padding: 10px 12px; font-size: 16px; }
    .island-nav__link:last-child { margin: 0; }
  }

  .island-fallback {
    position: fixed; top: 11px; left: 50%; z-index: 10; translate: -50% 0;
    display: flex; gap: 2px; padding: 8px; border-radius: 28px; background: #000;
  }
  .island-fallback a { padding: 8px 14px; color: #fff; text-decoration: none; font-size: 15px; font-weight: 500; }
</style>
