---
/**
 * The Grado en Física at Salamanca, from the faculty's study plan (240 ECTS): four years by semester.
 * The first year is done, the second under way; a subject with notes or reports on the site links down
 * to them (#pdf-<slug of the subject>).
 */
import apuntes from '@/data/apuntes.json';

type Subject = [name: string, sem: 1 | 2, ects: number, note?: string];
const years: { n: string; state: 'hecho' | 'ahora' | 'luego'; subjects: Subject[] }[] = [
  { n: 'Primero', state: 'hecho', subjects: [
    ['Física I', 1, 6], ['Física II', 1, 6], ['Análisis Matemático I', 1, 6], ['Álgebra Lineal y Geometría I', 1, 6], ['Técnicas Informáticas en Física', 1, 6],
    ['Física III', 2, 6], ['Física IV', 2, 6], ['Análisis Matemático II', 2, 6], ['Álgebra Lineal y Geometría II', 2, 6], ['Laboratorio de Física', 2, 6, 'Matrícula de Honor'],
  ] },
  { n: 'Segundo', state: 'ahora', subjects: [
    ['Mecánica I', 1, 6], ['Electromagnetismo I', 1, 6], ['Termodinámica I', 1, 6], ['Ecuaciones Diferenciales', 1, 6], ['Laboratorio de Mecánica y Ondas', 1, 3], ['Instrumentación Electrónica', 1, 3],
    ['Mecánica II', 2, 6], ['Electromagnetismo II', 2, 6], ['Termodinámica II', 2, 6], ['Variable Compleja', 2, 6], ['Laboratorio de Electromagnetismo', 2, 3], ['Laboratorio de Termodinámica', 2, 3],
  ] },
  { n: 'Tercero', state: 'luego', subjects: [
    ['Física Cuántica I', 1, 6], ['Óptica I', 1, 6], ['Mecánica Teórica', 1, 4.5], ['Electrodinámica Clásica', 1, 4.5], ['Métodos Numéricos', 1, 6], ['Laboratorio de Óptica', 1, 3],
    ['Física Cuántica II', 2, 6], ['Óptica II', 2, 6], ['Física del Estado Sólido I', 2, 6], ['Física Estadística', 2, 4.5], ['Astrofísica y Cosmología', 2, 4.5], ['Laboratorio de Física Cuántica', 2, 3],
  ] },
  { n: 'Cuarto', state: 'luego', subjects: [
    ['Física Nuclear y de Partículas', 1, 6], ['Mecánica Cuántica', 1, 6], ['Electrónica Física', 1, 6], ['Física de Fluidos', 1, 4.5], ['Física Computacional', 1, 4.5], ['Laboratorio de Electrónica', 1, 3],
    ['Trabajo de Fin de Grado', 2, 6],
  ] },
];
const optativas = ['Fotónica', 'Óptica Coherente', 'Gravitación', 'Física de Partículas', 'Mecánica Cuántica Avanzada', 'Física Estadística Avanzada', 'Física del Estado Sólido II', 'Ondas Electromagnéticas Guiadas', 'Radiación y Propagación Electromagnéticas', 'Laboratorio de Física Nuclear', 'Meteorología', 'Física del Clima', 'Física de Convertidores Energéticos', 'Electrónica de Comunicaciones', 'Sistemas Electrónicos Digitales', 'Prácticas externas'];

const count = new Map<string, number>();
for (const i of apuntes.items) count.set(i.subject, (count.get(i.subject) ?? 0) + 1);
const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
const ects = (n: number) => String(n).replace('.', ',');
const label = { hecho: 'Superado', ahora: 'En curso', luego: '' };
---
<div class="plan">
  <ol class="plan__years">
    {years.map((y) => (
      <li class:list={['plan__year', `plan__year--${y.state}`]}>
        <p class="plan__head"><span class="plan__n">{y.n}</span>{label[y.state] && <span class="plan__state">{label[y.state]}</span>}</p>
        {[1, 2].map((sem) => {
          const list = y.subjects.filter((s) => s[1] === sem);
          return list.length > 0 && (
            <div class="plan__sem">
              <p class="plan__semn">{sem}.º semestre</p>
              <ul>
                {list.map(([name, , e, note]) => {
                  const n = count.get(name);
                  return (
                    <li class:list={['plan__subj', { 'has-pdf': n }]}>
                      {n ? <a href={`#pdf-${slug(name)}`}>{name}</a> : <span>{name}</span>}
                      <span class="plan__meta">{note ? <em>{note}</em> : null}{n ? <span class="plan__pdf">{n} PDF</span> : null}<span class="plan__ects">{ects(e)}</span></span>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </li>
    ))}
  </ol>
  <p class="plan__opt"><span class="label">Optativas, hasta 24 ECTS</span> {optativas.join(' · ')}</p>
  <p class="plan__src">Plan de estudios del Grado en Física, Facultad de Ciencias de la Universidad de Salamanca: 240 ECTS, créditos en la columna de la derecha.</p>
</div>

<style>
  .plan { margin-top: clamp(48px, 6vw, 80px); }
  .plan__years { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 clamp(16px, 2vw, 32px); }
  .plan__year { border-top: 1px solid var(--line); padding-top: 16px; }
  .plan__year--ahora { border-top-color: var(--gold); }
  .plan__head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 14px; }
  .plan__n { font-family: var(--serif); font-size: 1.5rem; font-weight: 300; letter-spacing: -0.01em; }
  .plan__state { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .plan__year--ahora .plan__state { color: var(--gold); }
  .plan__sem + .plan__sem { margin-top: 16px; }
  .plan__semn { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 6px; }
  .plan__subj { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: baseline; padding: 5px 0; border-bottom: 1px solid rgba(236, 235, 230, 0.06); font-size: 14px; line-height: 1.35; color: var(--ink-2); }
  .plan__year--luego .plan__subj { color: var(--ink-3); }
  .plan__subj a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 0.2em; }
  .plan__subj a:hover { color: var(--gold); text-decoration-color: currentColor; }
  .plan__meta { display: flex; gap: 8px; align-items: baseline; white-space: nowrap; }
  .plan__meta em { font-family: var(--serif); font-size: 12.5px; color: var(--gold); }
  .plan__pdf { font-family: var(--mono); font-size: 10.5px; color: var(--gold); }
  .plan__ects { font-family: var(--mono); font-size: 11px; color: var(--ink-3); min-width: 2.2em; text-align: right; font-variant-numeric: tabular-nums; }
  .plan__opt { margin-top: 28px; font-size: 14px; line-height: 1.7; color: var(--ink-3); max-width: 90ch; }
  .plan__opt .label { margin-right: 0.8em; }
  .plan__src { margin-top: 12px; font-size: 12.5px; color: var(--ink-3); }
  @media (max-width: 1000px) { .plan__years { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; } }
  @media (max-width: 560px) { .plan__years { grid-template-columns: 1fr; } }
</style>
