---
/**
 * Fig. 1: gravitational lensing. A point mass in front of a field of stars and three faint galaxies.
 * Every source at angle β from the lens has two images, at θ± = (β ± √(β² + 4θE²)) / 2, magnified by
 * μ = |1 − (θE/θ)⁴|⁻¹. Galaxies are clouds of points, so they stretch into arcs and, aligned with the
 * lens, into an Einstein ring. The lens follows the pointer; left alone it drifts.
 */
---
<div class="lens" data-lens>
  <canvas data-lens-canvas aria-hidden="true"></canvas>
</div>

<style>
  .lens { position: relative; aspect-ratio: 16 / 7; cursor: crosshair; touch-action: pan-y; }
  .lens canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 700px) { .lens { aspect-ratio: 4 / 3; } }
</style>

<script>
  import { loop, surface } from '@/lib/figure';

  const box = document.querySelector<HTMLElement>('[data-lens]');
  if (box) {
    const canvas = box.querySelector<HTMLCanvasElement>('[data-lens-canvas]')!;
    // A fixed field (seeded), in coordinates relative to the canvas: 0..1.
    let seed = 7;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    type Src = { x: number; y: number; m: number; c: [number, number, number] };
    const tint = (): [number, number, number] => {
      const r = rnd();
      return r < 0.12 ? [190, 210, 255] : r < 0.22 ? [255, 222, 170] : [240, 238, 232];
    };
    const stars: Src[] = Array.from({ length: 2600 }, () => ({ x: rnd(), y: rnd(), m: Math.pow(rnd(), 3.2), c: tint() }));
    const galaxy = (cx: number, cy: number, rx: number, ry: number, rot: number, k: number) =>
      Array.from({ length: k }, () => {
        const a = rnd() * Math.PI * 2, r = Math.sqrt(-Math.log(1 - rnd() * 0.95)) * 0.5;
        const x = Math.cos(a) * r * rx, y = Math.sin(a) * r * ry;
        return { x: cx + x * Math.cos(rot) - y * Math.sin(rot), y: cy + x * Math.sin(rot) + y * Math.cos(rot), m: 0.04 + rnd() * 0.07, c: [214, 206, 255] as [number, number, number] };
      });
    const galaxies = [galaxy(0.5, 0.5, 0.05, 0.03, 0.5, 2200), galaxy(0.2, 0.3, 0.03, 0.016, -0.4, 900), galaxy(0.82, 0.7, 0.028, 0.02, 1.1, 900), galaxy(0.66, 0.22, 0.018, 0.012, 0.2, 500)].flat();

    const s = surface(canvas);
    let target: { x: number; y: number } | null = null;
    const lens = { x: 0.5, y: 0.5 };

    box.addEventListener('pointermove', (e) => {
      const r = box.getBoundingClientRect();
      target = { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height };
    });
    box.addEventListener('pointerleave', () => { target = null; });

    const draw = (srcs: Src[], thetaE: number, dot: number) => {
      const { ctx, w, h } = s;
      const lx = lens.x * w, ly = lens.y * h;
      for (const p of srcs) {
        const bx = p.x * w - lx, by = p.y * h - ly;
        const b = Math.hypot(bx, by) || 0.001;
        const ux = bx / b, uy = by / b;
        const root = Math.sqrt(b * b + 4 * thetaE * thetaE);
        for (const th of [(b + root) / 2, (b - root) / 2]) {
          const mu = Math.min(14, 1 / Math.abs(1 - Math.pow(thetaE / th, 4)));
          const a = Math.min(1, (0.22 + p.m * 0.95) * Math.sqrt(mu) * (th < 0 ? 0.85 : 1));
          if (a < 0.03) continue;
          const x = lx + ux * th, y = ly + uy * th;
          if (x < -4 || y < -4 || x > w + 4 || y > h + 4) continue;
          ctx.fillStyle = `rgba(${p.c[0]},${p.c[1]},${p.c[2]},${a})`;
          const r = dot * (0.5 + p.m * 1.6) * Math.min(2.2, Math.pow(mu, 0.25));
          ctx.fillRect(x - r / 2, y - r / 2, r, r);
        }
      }
    };

    loop(box, (t) => {
      const { ctx, w, h } = s;
      const goal = target ?? { x: 0.5 + 0.34 * Math.sin(t * 0.11), y: 0.5 + 0.18 * Math.sin(t * 0.17 + 0.6) };
      lens.x += (goal.x - lens.x) * 0.08; lens.y += (goal.y - lens.y) * 0.08;
      ctx.clearRect(0, 0, w, h);
      const thetaE = Math.min(w, h) * 0.15;
      ctx.globalCompositeOperation = 'lighter';
      draw(stars, thetaE, 1.1);
      draw(galaxies, thetaE, 1.15);
      ctx.globalCompositeOperation = 'source-over';
      // The Einstein radius, barely there, around the (invisible) mass.
      ctx.strokeStyle = 'rgba(226,194,125,0.18)';
      ctx.setLineDash([2, 5]);
      ctx.beginPath(); ctx.arc(lens.x * w, lens.y * h, thetaE, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(226,194,125,0.7)';
      ctx.fillRect(lens.x * w - 1, lens.y * h - 1, 2, 2);
    });
  }
</script>
