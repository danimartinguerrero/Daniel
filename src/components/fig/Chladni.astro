---
/**
 * Fig. 11: Chladni figures. Sand on three vibrating square plates drifts to the nodal lines of each
 * mode, where f(x, y) = cos(mπx) cos(nπy) − cos(nπx) cos(mπy) vanishes: each grain is shaken in
 * proportion to |f| and slides down |f|². While the music plays the plates are driven hard and move on
 * through their modes; paused, the sand settles. Pressing a plate moves it to its next mode.
 */
---
<div class="chladni" data-chladni>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .chladni { position: relative; aspect-ratio: 16 / 6.2; cursor: pointer; }
  .chladni canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 760px) { .chladni { aspect-ratio: 1 / 1.08; } }
</style>

<script>
  import { loop, surface } from '@/lib/figure';

  const box = document.querySelector<HTMLElement>('[data-chladni]');
  if (box) {
    const canvas = box.querySelector('canvas')!;
    const read = box.closest('figure')?.querySelector<HTMLElement>('[data-chladni-read]');
    const s = surface(canvas, () => layout());
    const MODES: [number, number][] = [[1, 2], [2, 3], [1, 4], [3, 4], [2, 5], [1, 5], [3, 5], [4, 5], [2, 7], [3, 7], [5, 6], [4, 7], [1, 6], [5, 8]];
    const N = 3600;
    interface Plate { x: number; y: number; size: number; mode: number; px: Float32Array; py: Float32Array }
    let plates: Plate[] = [];
    let playing = false, drive = 0.35, clock = 0;

    const scatter = (p: Plate) => { for (let i = 0; i < N; i++) { p.px[i] = Math.random(); p.py[i] = Math.random(); } };
    function layout() {
      const count = s.w < 760 ? 1 : 3;
      const label = 26;
      const size = Math.min(s.h - label - 16, (s.w - (count - 1) * 32) / count * 0.94);
      const gap = count > 1 ? (s.w - count * size) / (count + 1) : (s.w - size) / 2;
      const prev = plates;
      plates = Array.from({ length: count }, (_, i) => {
        const old = prev[i];
        const p: Plate = { x: count > 1 ? gap + i * (size + gap) : gap, y: 8, size, mode: old?.mode ?? i * 2, px: old?.px ?? new Float32Array(N), py: old?.py ?? new Float32Array(N) };
        if (!old) scatter(p);
        return p;
      });
    }

    const describe = () => {
      if (read) read.textContent = plates.map((p) => `(${MODES[p.mode % MODES.length].join(', ')})`).join(' · ');
    };
    const next = (p: Plate) => { p.mode = (p.mode + 1) % MODES.length; describe(); };

    document.addEventListener('music:state', (e) => { playing = (e as CustomEvent).detail.playing; });
    box.addEventListener('click', (e) => {
      const r = box.getBoundingClientRect(); const x = e.clientX - r.left;
      const p = plates.find((q) => x >= q.x && x <= q.x + q.size) ?? plates[0];
      next(p);
    });

    loop(box, (t, dt) => {
      const { ctx, w, h } = s;
      clock += dt;
      drive += ((playing ? 1 : 0.32) - drive) * Math.min(1, dt * 1.5);
      // While the music plays the plates move on every few seconds, one after another.
      if (playing && clock > 7) { clock = 0; plates.forEach((p, i) => setTimeout(() => next(p), i * 600)); }
      ctx.clearRect(0, 0, w, h);
      ctx.font = '11px "JetBrains Mono Variable", monospace';
      for (const p of plates) {
        const [m, n] = MODES[p.mode % MODES.length];
        const pm = Math.PI * m, pn = Math.PI * n;
        const k = 0.022 * drive, kick = 0.018 * drive;
        const steps = dt > 0 ? 2 : 0;
        for (let st = 0; st < steps; st++) {
          for (let i = 0; i < N; i++) {
            const x = p.px[i], y = p.py[i];
            const cmx = Math.cos(pm * x), cnx = Math.cos(pn * x), cmy = Math.cos(pm * y), cny = Math.cos(pn * y);
            const smx = Math.sin(pm * x), snx = Math.sin(pn * x), smy = Math.sin(pm * y), sny = Math.sin(pn * y);
            const f = cmx * cny - cnx * cmy;
            const fx = -pm * smx * cny + pn * snx * cmy;
            const fy = -pn * cmx * sny + pm * cnx * smy;
            const a = Math.abs(f);
            let nx = x - k * f * fx * 0.02 + (Math.random() - 0.5) * kick * a;
            let ny = y - k * f * fy * 0.02 + (Math.random() - 0.5) * kick * a;
            if (nx < 0) nx = -nx; if (nx > 1) nx = 2 - nx;
            if (ny < 0) ny = -ny; if (ny > 1) ny = 2 - ny;
            p.px[i] = nx; p.py[i] = ny;
          }
        }
        // The plate and its sand.
        ctx.strokeStyle = 'rgba(236,235,230,0.2)'; ctx.lineWidth = 1;
        ctx.strokeRect(p.x + 0.5, p.y + 0.5, p.size - 1, p.size - 1);
        ctx.fillStyle = 'rgba(236,231,218,0.82)';
        for (let i = 0; i < N; i++) ctx.fillRect(p.x + p.px[i] * p.size - 0.6, p.y + p.py[i] * p.size - 0.6, 1.2, 1.2);
        ctx.fillStyle = 'rgba(236,235,230,0.4)';
        ctx.fillText(`m = ${m} · n = ${n}`, p.x, p.y + p.size + 18);
      }
    });
    describe();
  }
</script>
