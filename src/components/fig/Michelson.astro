---
/**
 * Fig. 5: a Michelson interferometer. A He-Ne laser (632.8 nm) is split in two; the arms return to the
 * splitter and interfere on the screen as rings, I(θ) ∝ cos²(2π d cos θ / λ), where d is the difference
 * between the arms (1.2 mm here, as on a lab bench). Every λ/2 the mirror moves, one ring is born at the centre (or swallowed by it).
 * With M₁ tilted by a hair (the default), the rings open into straight, Young-like fringes,
 * I ∝ cos²(2πΔ/λ + πx/x₀), that slide sideways as the mirror moves. The slider moves the mirror;
 * left alone, it drifts.
 */
---
<div class="mich" data-mich>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .mich { position: relative; aspect-ratio: 16 / 7; }
  .mich canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 700px) { .mich { aspect-ratio: 4 / 3.6; } }
</style>

<script>
  import { loop, surface, wavelengthRGB } from '@/lib/figure';

  const box = document.querySelector<HTMLElement>('[data-mich]');
  if (box) {
    const canvas = box.querySelector('canvas')!;
    const fig = box.closest('figure');
    const range = fig?.querySelector<HTMLInputElement>('[data-mich-range]');
    const read = fig?.querySelector<HTMLElement>('[data-mich-read]');
    const s = surface(canvas);
    const LAMBDA = 632.8; // nm
    const [lr, lg, lb] = wavelengthRGB(LAMBDA).map((c, i) => Math.round(c * 0.85 + [236, 235, 230][i] * 0.15));
    const D0 = 1.2e6; // base path difference, nm (1.2 mm): about eight rings across the screen
    let user: number | null = null; // extra displacement in nm, from the slider
    range?.addEventListener('input', () => { user = Number(range.value); });
    const modeBtn = fig?.querySelector<HTMLButtonElement>('[data-mich-mode]');
    let tilted = true; // straight fringes; false: the aligned interferometer's rings
    modeBtn?.addEventListener('click', () => {
      tilted = !tilted;
      modeBtn.setAttribute('aria-pressed', String(!tilted));
      modeBtn.textContent = tilted ? 'Alinear los espejos' : 'Inclinar M₁';
    });

    const low = document.createElement('canvas'); const lctx = low.getContext('2d')!;
    let img: ImageData | null = null;

    loop(box, (t) => {
      const { ctx, w, h } = s;
      ctx.clearRect(0, 0, w, h);
      const shift = user ?? (Math.sin(t * 0.25) * 0.5 + 0.5) * 1600;
      if (range && user === null) range.value = String(Math.round(shift));
      const d = D0 + shift;
      const narrow = w < 700;

      // --- The set-up (left, or top on small screens) ---
      const sx = narrow ? w * 0.04 : w * 0.04, sw = narrow ? w * 0.92 : w * 0.5, sy = narrow ? h * 0.04 : h * 0.1, sh = narrow ? h * 0.46 : h * 0.8;
      const bs = { x: sx + sw * 0.46, y: sy + sh * 0.52 };
      const laser = { x: sx + sw * 0.02, y: bs.y };
      const m1 = { x: bs.x, y: sy + sh * 0.04 };               // fixed mirror, up
      const m2 = { x: sx + sw * 0.9 + (shift / 1600) * sw * 0.05, y: bs.y }; // moving mirror, right
      const det = { x: bs.x, y: sy + sh * 0.98 };               // to the screen, down
      const beam = `rgba(${lr},${lg},${lb},0.85)`;
      ctx.lineWidth = 1.4; ctx.strokeStyle = beam;
      const seg = (a: { x: number; y: number }, b: { x: number; y: number }) => { ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); };
      seg(laser, bs); seg(bs, m1); seg(bs, m2); seg(bs, det);
      // Light travelling: dashes running along each arm.
      ctx.setLineDash([3, 9]); ctx.lineDashOffset = -t * 40; ctx.strokeStyle = `rgba(255,255,255,0.5)`; ctx.lineWidth = 1;
      seg(laser, bs); seg(bs, m1); seg(bs, m2); seg(bs, det);
      ctx.setLineDash([]);
      // Components.
      ctx.strokeStyle = 'rgba(236,235,230,0.55)'; ctx.lineWidth = 1;
      ctx.strokeRect(laser.x - 2, laser.y - 7, 30, 14);
      ctx.save(); ctx.translate(bs.x, bs.y); ctx.rotate(-Math.PI / 4); ctx.fillStyle = 'rgba(236,235,230,0.12)'; ctx.fillRect(-16, -1.5, 32, 3); ctx.strokeRect(-16, -1.5, 32, 3); ctx.restore();
      ctx.fillStyle = 'rgba(236,235,230,0.8)';
      ctx.fillRect(m1.x - 16, m1.y - 2, 32, 3);
      ctx.fillRect(m2.x, m2.y - 16, 3, 32);
      ctx.strokeRect(det.x - 18, det.y - 1, 36, 2);
      ctx.fillStyle = 'rgba(236,235,230,0.42)';
      ctx.font = '11px "JetBrains Mono Variable", monospace';
      ctx.fillText('He-Ne 632,8 nm', laser.x, laser.y - 14);
      ctx.fillText('M₁', m1.x + 22, m1.y + 4);
      ctx.fillText('M₂ ⟷', m2.x - 10, m2.y + 32);
      ctx.fillText('divisor', bs.x + 14, bs.y + 22);

      // --- The screen: circular fringes ---
      const R = narrow ? Math.min(w * 0.42, h * 0.24) : Math.min(h * 0.44, w * 0.2);
      const cx = narrow ? w / 2 : w * 0.78, cy = narrow ? h * 0.74 : h / 2;
      const size = Math.round(Math.min(300, R * 2));
      if (!img || low.width !== size) { low.width = low.height = size; img = lctx.createImageData(size, size); }
      const data = img!.data;
      const thetaMax = 0.085; // rad at the screen's edge
      for (let j = 0; j < size; j++) for (let i = 0; i < size; i++) {
        const u = (i / (size - 1)) * 2 - 1, v = (j / (size - 1)) * 2 - 1;
        const rr = Math.hypot(u, v); const o = (j * size + i) * 4;
        if (rr > 1) { data[o + 3] = 0; continue; }
        const th = rr * thetaMax;
        const I = tilted
          ? Math.cos((2 * Math.PI * shift) / LAMBDA + Math.PI * u * 4.5) ** 2 // nine straight fringes across
          : Math.cos((2 * Math.PI * d * Math.cos(th)) / LAMBDA) ** 2;
        const edge = Math.min(1, (1 - rr) * 14) * (0.35 + 0.65 * Math.exp(-rr * rr * 1.4));
        data[o] = lr * I * edge; data[o + 1] = lg * I * edge; data[o + 2] = lb * I * edge; data[o + 3] = 255 * edge;
      }
      lctx.putImageData(img!, 0, 0);
      ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(low, cx - R, cy - R, R * 2, R * 2);
      ctx.strokeStyle = 'rgba(236,235,230,0.2)';
      ctx.beginPath(); ctx.arc(cx, cy, R + 0.5, 0, Math.PI * 2); ctx.stroke();
      ctx.fillStyle = 'rgba(236,235,230,0.42)';
      ctx.fillText('pantalla', cx - R, cy + R + 18);
      if (read) read.textContent = `Δd = ${(shift / 1000).toFixed(2).replace('.', ',')} µm · ${(2 * shift / LAMBDA).toFixed(1).replace('.', ',')} franjas`;
    });
  }
</script>
