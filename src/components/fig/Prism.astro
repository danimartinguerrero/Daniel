---
/**
 * Fig. 4: dispersion in a prism. A white beam meets a 60° prism of crown glass; each wavelength bends by
 * Snell's law with its own index, n(λ) = 1.5046 + 4200 nm² / λ² (Cauchy, BK7), so violet turns more than
 * red and the beam leaves as a spectrum. The angle of incidence follows the pointer.
 */
---
<div class="prism" data-prism>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .prism { position: relative; aspect-ratio: 16 / 7; cursor: ns-resize; touch-action: pan-y; }
  .prism canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 700px) { .prism { aspect-ratio: 4 / 3; } }
</style>

<script>
  import { loop, surface, wavelengthRGB } from '@/lib/figure';

  const box = document.querySelector<HTMLElement>('[data-prism]');
  if (box) {
    const canvas = box.querySelector('canvas')!;
    const read = box.closest('figure')?.querySelector<HTMLElement>('[data-prism-read]');
    const s = surface(canvas);
    const n = (nm: number) => 1.5046 + 4200 / (nm * nm);
    const lambdas = Array.from({ length: 48 }, (_, i) => 400 + (i * 300) / 47);
    let aim = 0.5, goal: number | null = null;

    box.addEventListener('pointermove', (e) => { const r = box.getBoundingClientRect(); goal = (e.clientY - r.top) / r.height; });
    box.addEventListener('pointerleave', () => { goal = null; });

    type V = { x: number; y: number };
    const sub = (a: V, b: V) => ({ x: a.x - b.x, y: a.y - b.y });
    const dot = (a: V, b: V) => a.x * b.x + a.y * b.y;
    const norm = (a: V) => { const l = Math.hypot(a.x, a.y); return { x: a.x / l, y: a.y / l }; };
    // Where the ray p + t·d meets segment ab (t > 0), or null.
    const hit = (p: V, d: V, a: V, b: V) => {
      const e = sub(b, a), den = d.x * e.y - d.y * e.x;
      if (Math.abs(den) < 1e-9) return null;
      const w = sub(a, p), t = (w.x * e.y - w.y * e.x) / den, u = (w.x * d.y - w.y * d.x) / den;
      return t > 1e-6 && u >= 0 && u <= 1 ? { x: p.x + d.x * t, y: p.y + d.y * t, t } : null;
    };
    // Snell's law in vector form; null on total internal reflection.
    const refract = (d: V, nrm: V, n1: number, n2: number) => {
      let N = nrm; let c = -dot(N, d);
      if (c < 0) { N = { x: -N.x, y: -N.y }; c = -c; }
      const r = n1 / n2, k = 1 - r * r * (1 - c * c);
      if (k < 0) return null;
      return norm({ x: r * d.x + (r * c - Math.sqrt(k)) * N.x, y: r * d.y + (r * c - Math.sqrt(k)) * N.y });
    };

    loop(box, (t) => {
      const { ctx, w, h } = s;
      aim += ((goal ?? 0.5 + 0.18 * Math.sin(t * 0.35)) - aim) * 0.06;
      ctx.clearRect(0, 0, w, h);
      // The prism: an equilateral triangle, apex up.
      const side = Math.min(h * 0.86, w * 0.34) / 0.866;
      const cx = w * 0.44, cy = h * 0.5;
      const A = { x: cx, y: cy - side * 0.866 * 0.62 }, B = { x: cx - side / 2, y: cy + side * 0.866 * 0.38 }, C = { x: cx + side / 2, y: B.y };
      ctx.beginPath(); ctx.moveTo(A.x, A.y); ctx.lineTo(B.x, B.y); ctx.lineTo(C.x, C.y); ctx.closePath();
      ctx.fillStyle = 'rgba(236,235,230,0.035)'; ctx.fill();
      ctx.strokeStyle = 'rgba(236,235,230,0.38)'; ctx.lineWidth = 1; ctx.stroke();

      // The incoming beam, aimed at the middle of the left face from an angle set by the pointer.
      const target = { x: (A.x + B.x) / 2, y: (A.y + B.y) / 2 };
      const ang = (-0.15 + (aim - 0.5) * 0.9);
      const dir = norm({ x: Math.cos(ang), y: Math.sin(ang) });
      const src = { x: target.x - dir.x * w, y: target.y - dir.y * w };
      ctx.strokeStyle = 'rgba(245,243,236,0.95)'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(src.x, src.y); ctx.lineTo(target.x, target.y); ctx.stroke();

      const leftN = norm({ x: -(A.y - B.y), y: A.x - B.x });
      const rightN = norm({ x: C.y - A.y, y: -(C.x - A.x) });
      let devMin = Infinity, devMax = -Infinity;
      ctx.globalCompositeOperation = 'lighter';
      for (const nm of lambdas) {
        const nn = n(nm);
        const d1 = refract(dir, leftN, 1, nn); if (!d1) continue;
        const p2 = hit(target, d1, A, C) ?? hit(target, d1, B, C); if (!p2) continue;
        const onRight = hit(target, d1, A, C) !== null;
        const d2 = onRight ? refract(d1, rightN, nn, 1) : null; if (!d2) continue;
        const [r, g, b] = wavelengthRGB(nm);
        // Inside the glass: faint.
        ctx.strokeStyle = `rgba(${r},${g},${b},0.07)`; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(target.x, target.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
        // Out: to the edge of the figure.
        const far = { x: p2.x + d2.x * w, y: p2.y + d2.y * w };
        const grad = ctx.createLinearGradient(p2.x, p2.y, far.x, far.y);
        grad.addColorStop(0, `rgba(${r},${g},${b},0.22)`); grad.addColorStop(0.5, `rgba(${r},${g},${b},0.14)`); grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
        ctx.strokeStyle = grad; ctx.lineWidth = 2.2;
        ctx.beginPath(); ctx.moveTo(p2.x, p2.y); ctx.lineTo(far.x, far.y); ctx.stroke();
        const dev = (Math.atan2(d2.y, d2.x) - ang) * 180 / Math.PI;
        devMin = Math.min(devMin, dev); devMax = Math.max(devMax, dev);
      }
      ctx.globalCompositeOperation = 'source-over';
      const inc = Math.acos(Math.min(1, -dot(dir, leftN))) * 180 / Math.PI;
      if (read && isFinite(devMin)) read.textContent = `incidencia ${inc.toFixed(0)}° · desviación ${Math.abs(devMax).toFixed(1)}°–${Math.abs(devMin).toFixed(1)}°`;
      else if (read) read.textContent = `incidencia ${inc.toFixed(0)}° · reflexión total`;
    });
  }
</script>
