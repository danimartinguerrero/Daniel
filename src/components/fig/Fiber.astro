---
/**
 * Fig. 9: total internal reflection. The milestones hang off an optical fibre; a ray beyond the critical
 * angle bounces down its core as far as the reader has scrolled, and each milestone lights as it passes.
 * Children are the milestones: <li data-node>…</li>.
 */
---
<div class="fiber" data-fiber>
  <canvas class="fiber__canvas" aria-hidden="true"></canvas>
  <ol class="fiber__list"><slot /></ol>
</div>

<style>
  .fiber { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr); }
  .fiber__canvas { grid-column: 1; grid-row: 1; width: 44px; height: 100%; }
  .fiber__list { grid-column: 2; grid-row: 1; }
  .fiber__list :global([data-node]) { transition: opacity 500ms var(--ease); }
  :global(html.js) .fiber__list :global([data-node]:not(.is-lit)) { opacity: 0.38; }
</style>

<script>
  import { reduceMotion, surface, token } from '@/lib/figure';

  document.querySelectorAll<HTMLElement>('[data-fiber]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const nodes = [...root.querySelectorAll<HTMLElement>('[data-node]')];
    const gold = token('--gold');
    const s = surface(canvas, () => draw());
    const still = reduceMotion();

    function draw() {
      const { ctx, w, h } = s;
      const r = root.getBoundingClientRect();
      const p = still ? 1 : Math.max(0, Math.min(1, (innerHeight * 0.62 - r.top) / r.height));
      ctx.clearRect(0, 0, w, h);
      const a = 10, b = 30, period = 46; // core walls at x = a and x = b
      // Cladding walls.
      ctx.strokeStyle = 'rgba(236,235,230,0.18)'; ctx.lineWidth = 1;
      for (const x of [a - 0.5, b + 0.5]) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
      // The ray: a zigzag between the walls, all of it faint, the travelled part in gold.
      const at = (y: number) => { const u = (y / period) % 1; return u < 0.5 ? a + (b - a) * (u * 2) : b - (b - a) * ((u - 0.5) * 2); };
      ctx.strokeStyle = 'rgba(236,235,230,0.1)';
      ctx.beginPath(); ctx.moveTo(at(0), 0);
      for (let y = 0; y <= h; y += period / 2) ctx.lineTo(at(y), y);
      ctx.stroke();
      const end = p * h;
      ctx.strokeStyle = gold; ctx.globalAlpha = 0.9;
      ctx.beginPath(); ctx.moveTo(at(0), 0);
      for (let y = period / 2; y < end; y += period / 2) ctx.lineTo(at(y), y);
      ctx.lineTo(at(end), end); ctx.stroke(); ctx.globalAlpha = 1;
      // The pulse.
      if (p > 0 && p < 1) {
        const g = ctx.createRadialGradient(at(end), end, 0, at(end), end, 12);
        g.addColorStop(0, 'rgba(226,194,125,0.9)'); g.addColorStop(1, 'rgba(226,194,125,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(at(end), end, 12, 0, Math.PI * 2); ctx.fill();
      }
      // Milestones light as the pulse reaches them.
      for (const n of nodes) {
        const y = n.getBoundingClientRect().top - r.top + 20;
        n.classList.toggle('is-lit', y <= end + 1);
        ctx.fillStyle = y <= end + 1 ? gold : 'rgba(236,235,230,0.25)';
        ctx.fillRect(b + 6, y - 0.5, 8, 1);
      }
    }
    let queued = false;
    const onScroll = () => { if (queued) return; queued = true; requestAnimationFrame(() => { queued = false; draw(); }); };
    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(onScroll).observe(root);
    draw();
  });
</script>
