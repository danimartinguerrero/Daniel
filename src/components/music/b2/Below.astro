---
/**
 * Everything version b2 adds under the records: one block of very large type, a few statements stacked
 * close together, whose words light one by one as they rise past a reading line (b2.ts). Words live in
 * ./copy.ts. Without the script, or with reduced motion, every word is simply lit.
 */
import { statements, note } from './copy';

const words = (text: string) => text.split(' ');
---
<div class="b2-below" data-intro-rest data-b2>
  <div class="b2-wall">
    {statements.map((s) => (
      <p class:list={['b2-st', `b2-st--${s.id}`]}>
        {s.parts.map((p) => (
          <span class:list={['b2-st__part', { 'b2-st__part--line': p.line === true, 'b2-st__part--wide': p.line === 'wide' }]}>
            {words(p.text).map((w) => <><span class="b2-w">{w}</span>{' '}</>)}
          </span>
        ))}
      </p>
    ))}
    <p class="b2-note">{words(note).map((w) => <><span class="b2-w">{w}</span>{' '}</>)}</p>
  </div>
  <div class="b2-probe" aria-hidden="true"></div>
</div>
