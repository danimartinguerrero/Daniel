---
/**
 * Music, way scroll-3: what follows the ring of records, in the page's ordinary scroll. A sentence for
 * each thing he plays or tries, and under it a drawing of what it names, seen from above as the
 * records were. Words and drawings wait dim and fill with light as the page goes up the screen, the
 * same light that filled the passages in the ring (playing.ts). Nothing here needs a press.
 */
import { playingCopy as c } from './copy';
import { guitar, bass, piano, controller, NECK_W, NECK_H, PIANO_W, PIANO_H, MPK_W, MPK_H } from './draw';

// Names stay on one line, and on a wide screen a sentence breaks where its sense does (after "bass,",
// after "FL Studio") rather than wherever balancing puts it.
const NAMES = ['FL Studio', 'MPK Mini'];
const BREAK_AFTER = new Set(['bass,', 'FL\u00a0Studio']);
const words = (s: string) => NAMES.reduce((t, n) => t.replace(n, n.replace(' ', '\u00a0')), s).split(' ');
const art = (id: string, w: number, h: number) => ({ id, w, h });
const neckG = art('s3-guitar', NECK_W, NECK_H);
const neckB = art('s3-bass', NECK_W, NECK_H);
const keys = art('s3-piano', PIANO_W, PIANO_H);
const mpk = art('s3-controller', MPK_W, MPK_H);
---
<section class="s3" aria-labelledby="s3-first">
  <svg class="s3-symbols" aria-hidden="true" focusable="false" set:html={guitar() + bass() + piano() + controller()} />

  <!-- 1. The guitar and the bass. -->
  <div class="s3-part">
    <div class="container s3-say">
      <p class="eyebrow s3-eyebrow">{c.eyebrow}</p>
      <p class="s3-line" id="s3-first" data-s3-text>{words(c.strings).map((w) => <><span class="w" data-w>{w}</span>{BREAK_AFTER.has(w) ? [' ', <br class="s3-br" />] : ' '}</>)}</p>
    </div>
    {[[c.labels.guitar, neckG], [c.labels.bass, neckB]].map(([label, a]) => {
      const d = a as typeof neckG;
      return (
        <figure class="s3-fig s3-fig--neck">
          <figcaption class="container s3-label">{label as string}</figcaption>
          <div class="s3-band">
            <div class="s3-art" data-s3-art style={`aspect-ratio:${d.w}/${d.h}`}>
              <svg class="s3-art__dim" viewBox={`0 0 ${d.w} ${d.h}`} aria-hidden="true"><use href={`#${d.id}`} /></svg>
            </div>
          </div>
        </figure>
      );
    })}
  </div>

  <!-- 2. The piano. -->
  <div class="s3-part">
    <div class="container s3-say">
      <p class="s3-line" data-s3-text>{words(c.piano).map((w) => <><span class="w" data-w>{w}</span>{BREAK_AFTER.has(w) ? [' ', <br class="s3-br" />] : ' '}</>)}</p>
    </div>
    <figure class="s3-fig s3-fig--piano">
      <div class="s3-band">
        <div class="s3-art" data-s3-art style={`aspect-ratio:${keys.w}/${keys.h}`}>
          <svg class="s3-art__dim" viewBox={`0 0 ${keys.w} ${keys.h}`} aria-hidden="true"><use href={`#${keys.id}`} /></svg>
        </div>
      </div>
    </figure>
  </div>

  <!-- 3. FL Studio and the MPK Mini. -->
  <div class="s3-part s3-part--last">
    <div class="container s3-say">
      <p class="s3-line" data-s3-text>{words(c.controller).map((w) => <><span class="w" data-w>{w}</span>{BREAK_AFTER.has(w) ? [' ', <br class="s3-br" />] : ' '}</>)}</p>
    </div>
    <figure class="s3-fig s3-fig--controller">
      <div class="container">
        <div class="s3-art" data-s3-art style={`aspect-ratio:${mpk.w}/${mpk.h}`}>
          <svg class="s3-art__dim" viewBox={`0 0 ${mpk.w} ${mpk.h}`} aria-hidden="true"><use href={`#${mpk.id}`} /></svg>
        </div>
      </div>
    </figure>
  </div>
</section>
