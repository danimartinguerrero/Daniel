---
/**
 * The records seen from the side: a pile of spines in the shelf's order. Each spine is its record's
 * colour (the disc label's colour, measured from the cover in data/music-covers.json) and a double
 * album's is thicker than a single's. A spine has two faces in the same place: at rest it is in the
 * dark, a deep tone of its own colour with light ink, and lit it is the true colour with whichever ink
 * reads best on it. Only the record in the middle of the carousel is lit, and its spine is pulled out
 * of the pile (r3.ts moves the light and the pull with the carousel). Pressing a spine turns the
 * carousel to its record.
 */
import { vinyls } from '@/data/music';
import { labelColor } from '@/components/music/v4/sleeve';
import { START } from '@/components/music/v4/start';
import { r3Copy } from './copy';

const rgb = (hex: string) => [0, 2, 4].map((k) => parseInt(hex.replace('#', '').slice(k, k + 2), 16) / 255) as [number, number, number];
const lum = (hex: string) => {
  const ch = rgb(hex).map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * ch[0]! + 0.7152 * ch[1]! + 0.0722 * ch[2]!;
};
const ratio = (a: string, b: string) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
const DARK_INK = '#1d1d1f';
const LIGHT_INK = '#f5f5f7';
const litInk = (bg: string) => (ratio(bg, DARK_INK) >= ratio(bg, LIGHT_INK) ? 'dark' : 'light');

/** The same hue brought down into the dark, at 17% lightness. Its saturation follows how much colour
    the record really has (its chroma), held back, so a pale or grey record (The Wall, To Pimp a
    Butterfly) comes down to a neutral dark as far as a coloured one does, not to an olive. */
const deep = (hex: string) => {
  const [r, g, b] = rgb(hex);
  const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
  const s = Math.min(0.5, d * 1.2);
  let h = 0;
  if (d) h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
  return `hsl(${Math.round(((h * 60) + 360) % 360)} ${Math.round(s * 100)}% 17%)`;
};
const discs = (format: string) => Number(/^(\d+)×/.exec(format)?.[1] ?? 1);
---
<ol class="r3-stack" data-r3-stack aria-label="The records, seen from the side">
  {vinyls.map((v, i) => {
    const bg = labelColor(v);
    const n = discs(v.format);
    const face = (<><span class="r3-spine__name"><span class="r3-spine__title">{v.title}</span><span class="r3-spine__artist">{v.artist}</span></span><span class="r3-spine__year">{v.year}</span></>);
    return (
      <li class="r3-spine" data-r3-spine={i} data-discs={n} aria-current={i === START ? 'true' : undefined} style={`--spine:${bg};--deep:${deep(bg)}`}>
        <span class="r3-spine__shadow" data-r3-shadow aria-hidden="true"></span>
        <button class="r3-spine__body" type="button" data-r3-go={v.id} aria-label={r3Copy.show(v.title, v.artist)}>
          <span class="r3-spine__face r3-spine__face--rest" aria-hidden="true">{face}</span>
          <span class="r3-spine__face r3-spine__face--lit" data-r3-lit data-ink={litInk(bg)} aria-hidden="true">{face}</span>
        </button>
      </li>
    );
  })}
</ol>
