---
/**
 * Everything version b1 adds under the records: one heading and one grid of tiles that sums the rest
 * of it up. The largest tile is about making beats and holds the one drawing; the others are type, or
 * the record sleeves themselves. Every fact about the collection is worked out here from data/music.ts,
 * so it stays true when a record is added. Words live in ./copy.ts.
 */
import { vinyls } from '@/data/music';
import { copy } from './copy';

// The collection, oldest first (by year, then shelf order for a tie).
const byYear = vinyls.map((v, i) => ({ v, i })).sort((a, b) => a.v.year - b.v.year || a.i - b.i).map(({ v }) => v);
const first = byYear[0]?.year ?? 0;
const last = byYear[byYear.length - 1]?.year ?? 0;

// The artist with the most records on the shelf. The tile is only there when one artist clearly leads
// (two records or more, and no one else with as many); without it the shelf tile takes the whole row.
const counts = new Map<string, number>();
for (const v of vinyls) counts.set(v.artist, (counts.get(v.artist) ?? 0) + 1);
const ranked = [...counts].sort((a, b) => b[1] - a[1]);
const lead = ranked[0] && ranked[0][1] >= 2 && (ranked[1]?.[1] ?? 0) < ranked[0][1] ? ranked[0] : null;
// At most four sleeves fit the tile as equal squares; the sentence still gives the true count.
const leadRecords = lead ? vinyls.filter((v) => v.artist === lead[0]).slice(0, 4) : [];

// The drawing: four channels of sixteen steps, in four bars. A plain, common pattern, not a beat of his.
const pattern = [
  'x......x..x.....',
  '....x.......x...',
  'x.x.x.x.x.x.x.xx',
  '.........x.....x',
];
const bars = [0, 1, 2, 3].map((g) => [0, 1, 2, 3].map((k) => g * 4 + k));
---
<section class="b1-below" aria-labelledby="b1-heading" data-intro-rest>
  <h2 class="container b1-heading" id="b1-heading">{copy.heading}</h2>

  <div class="b1-bento" data-lead={lead ? '' : undefined}>
    <article class="b1-tile b1-tile--beats" aria-labelledby="b1-beats-title">
      <h3 class="b1-title" id="b1-beats-title">{copy.beats.title}</h3>
      <figure class="b1-rack-wrap">
        <div class="b1-rack" role="img" aria-label={copy.beats.drawingLabel} data-b1-rack>
          <div class="b1-rack__row b1-rack__row--lights" aria-hidden="true">
            <span class="b1-rack__name"></span>
            <span class="b1-rack__steps">
              {bars.map((b) => (
                <span class="b1-bar">{b.map((c) => <span class="b1-light" style={`--c:${c}`} />)}</span>
              ))}
            </span>
          </div>
          {pattern.map((row, r) => (
            <div class="b1-rack__row" aria-hidden="true">
              <span class="b1-rack__name">{copy.beats.channels[r]}</span>
              <span class="b1-rack__steps">
                {bars.map((b, g) => (
                  <span class="b1-bar" data-group={g % 2}>
                    {b.map((c) => <span class={`b1-step${row[c] === 'x' ? ' b1-step--on' : ''}`} style={`--c:${c}`} />)}
                  </span>
                ))}
              </span>
            </div>
          ))}
        </div>
        <figcaption class="b1-caption">{copy.beats.caption}</figcaption>
      </figure>
    </article>

    <article class="b1-tile b1-tile--play">
      <h3 class="b1-play">
        {copy.play.title} <span class="b1-play__honest">{copy.play.honest}</span>
      </h3>
    </article>

    <article class="b1-tile b1-tile--gear">
      <p class="b1-gear">
        {copy.gear.line} <span class="b1-gear__gloss">{copy.gear.gloss}</span>
      </p>
    </article>

    {lead && (
      <article class="b1-tile b1-tile--artist">
        <ul class="b1-trio" aria-hidden="true" style={`--n:${leadRecords.length}`}>
          {leadRecords.map((v) => (
            <li class="b1-sleeve">
              <img src={`/img/music/${v.id}.webp`} width="800" height="800" alt="" loading="lazy" decoding="async" draggable="false" />
            </li>
          ))}
        </ul>
        <p class="b1-line">{copy.artist.line(lead[1], vinyls.length, lead[0])}</p>
      </article>
    )}

    <article class="b1-tile b1-tile--shelf">
      <p class="b1-line">{copy.shelf.line(vinyls.length, first, last)}</p>
      <div class="b1-strip-wrap" style={`--n:${byYear.length}`}>
        <ol class="b1-strip" aria-label={copy.shelf.coversLabel}>
          {byYear.map((v, i) => (
            <li class="b1-sleeve" style={`--i:${i}`}>
              <img src={`/img/music/${v.id}.webp`} width="800" height="800" alt={`${v.title}, ${v.artist}, ${v.year}`} loading="lazy" decoding="async" draggable="false" />
            </li>
          ))}
        </ol>
        <p class="b1-strip__ends" aria-hidden="true"><span>{first}</span><span>{last}</span></p>
      </div>
    </article>
  </div>
</section>
