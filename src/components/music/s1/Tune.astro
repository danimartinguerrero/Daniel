---
/**
 * s1, sketch B: "Out of tune, off the grid". Two sentences about me, set as type that is a little off,
 * the way playing is: the letters of "Not very well." sit off their line like strings out of tune, and
 * a hand brushed across them pulls each one true, until it slips back. The words of the sentence about
 * beats sit off the beat on a grid like FL Studio's; drag the playhead (or the words) along and every
 * word it passes snaps onto the grid, as FL Studio quantizes notes; drag it back and they come off again.
 * Behaviour in tune.ts. Without the script both read as plain sentences.
 */
const off = 'Not very well.';
const beats = 'In my spare time I make beats in FL Studio, with an Akai MPK Mini.';
---
<section class="s1b" aria-label="Guitar, bass and beats" data-intro-rest data-s1-tune>
  <div class="container s1b-tune" data-s1b-tune>
    <p class="s1b-line">I play guitar and bass.</p>
    <p class="s1b-line s1b-off" aria-label={off} data-s1b-off>
      {[...off].map((ch) => (
        ch === ' ' ? <span class="s1b-sp"> </span> : <span class="s1b-l" aria-hidden="true"><span class="s1b-l__g">{ch}</span><span class="s1b-l__w">{ch}</span></span>
      ))}
    </p>
    <p class="s1b-note" aria-hidden="true">Run a finger along it.</p>
  </div>

  <div class="s1b-q" data-s1b-q>
    <div class="s1b-q__ruler" data-s1b-ruler aria-hidden="true"></div>
    <div class="s1b-q__rows" data-s1b-rows>
      <p class="s1b-q__text" data-s1b-text aria-label={beats}>
        {beats.split(' ').map((w) => (
          <span class="s1b-w" aria-hidden="true"><span class="s1b-w__g">{w}</span><span class="s1b-w__w">{w}</span></span>
        ))}
      </p>
    </div>
    <div class="s1b-ph" data-s1b-ph aria-hidden="true">
      <div class="s1b-ph__line"></div>
      <div class="s1b-ph__grip" data-s1b-grip></div>
    </div>
    <button class="s1b-chip" type="button" data-s1b-chip>Quantize</button>
  </div>
</section>
