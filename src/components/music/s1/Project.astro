---
/**
 * s1, sketch C: "The project". One of my beats as it looks in FL Studio, its whole arrangement laid out
 * as a surface in a dark window: drag it along (1:1, thrown with momentum, soft at the ends), pinch or
 * ctrl-scroll to zoom, and the strip under it shows where you are in the song (project.ts).
 *
 * NEEDS REAL MATERIAL. What is drawn here is a stand-in, and says so on it: generic lanes and patterns.
 * The owner would supply one screenshot (or a few stitched) of an FL Studio project's Playlist with the
 * whole arrangement in view, wide: about 3600 px or more across, PNG. It would replace `canvas` below
 * (the same size, one <img>), and its bar width (BAR) would be measured from it.
 */
import { labelColour } from './facts';

const BAR = 56; // px per bar in the canvas
const BARS = 64;
const LANES = 8;
const TOP = 40; // the ruler
const LANE = 90;
const W = BAR * BARS;
const H = TOP + LANES * LANE;

// Seeded, so the stand-in is the same on every load.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

const hues = ['the-wall', 'igor', 'ye', 'good-kid-maad-city', 'in-the-court', 'illmatic', 'we-dont-trust-you', 'damn'].map(labelColour);
// Each lane comes in at its own bar, plays in 4- or 8-bar patterns, and drops out now and then:
// enough to read as an arrangement, nothing that pretends to be his.
const starts = [1, 1, 9, 17, 5, 25, 33, 17];
let n = 0;
const blocks: { x: number; y: number; w: number; lane: number; label: string }[] = [];
for (let lane = 0; lane < LANES; lane++) {
  const len = rnd() < 0.5 ? 4 : 8;
  const id = ++n;
  for (let bar = starts[lane]!; bar <= BARS; bar += len) {
    if (rnd() < 0.18 || (bar > 41 && bar < 49 && lane > 2)) continue; // a breakdown in the middle
    blocks.push({ x: (bar - 1) * BAR, y: TOP + lane * LANE, w: Math.min(len, BARS - bar + 1) * BAR, lane, label: `Pattern ${id}` });
  }
}

const notes = (b: (typeof blocks)[number]) => {
  let s = '';
  const steps = (b.w / BAR) * 8;
  for (let i = 0; i < steps; i++) {
    if (rnd() < 0.42) continue;
    const y = b.y + 30 + Math.floor(rnd() * 5) * 9;
    s += `<rect x="${b.x + 4 + i * (BAR / 8)}" y="${y}" width="${BAR / 8 - 2}" height="4" rx="1" />`;
  }
  return s;
};

const ruler = Array.from({ length: BARS }, (_, i) =>
  `<line x1="${i * BAR}" x2="${i * BAR}" y1="${i % 4 ? 30 : 18}" y2="${H}" class="${i % 4 ? 'g' : 'G'}" />` + (i % 4 ? '' : `<text x="${i * BAR + 6}" y="28">${i + 1}</text>`),
).join('');
const lanes = Array.from({ length: LANES + 1 }, (_, i) => `<line x1="0" x2="${W}" y1="${TOP + i * LANE}" y2="${TOP + i * LANE}" class="l" />`).join('');
const body = blocks.map((b) =>
  `<g style="--h:${hues[b.lane]}"><rect class="b" x="${b.x + 1}" y="${b.y + 3}" width="${b.w - 2}" height="${LANE - 6}" rx="6" /><text class="t" x="${b.x + 10}" y="${b.y + 21}">${b.label}</text><g class="n">${notes(b)}</g></g>`,
).join('');
const canvas = `<svg class="s1c-svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" aria-hidden="true">${ruler}${lanes}${body}</svg>`;
const mini = `<svg class="s1c-mini__svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${blocks.map((b) => `<rect x="${b.x}" y="${b.y}" width="${b.w - 8}" height="${LANE - 16}" rx="10" style="fill:${hues[b.lane]}" />`).join('')}</svg>`;
---
<section class="s1c" aria-labelledby="s1c-title" data-intro-rest data-s1-project data-bar={BAR} data-bars={BARS} data-w={W} data-h={H}>
  <header class="container s1-head">
    <p class="eyebrow s1-eyebrow">Spare time</p>
    <h2 class="s1-title" id="s1c-title">I make beats.</h2>
    <p class="lede s1-lede">In FL Studio, with an Akai MPK Mini. <span class="s1-hi">This is one of them, the way it looks while I make it.</span> Drag it along.</p>
  </header>

  <div class="s1c-stage" data-s1c-stage>
    <div class="s1c-win" data-s1c-win role="img" aria-label="The arrangement of one of my beats in FL Studio">
      <div class="s1c-canvas" data-s1c-canvas set:html={canvas} />
      <div class="s1c-ph" aria-hidden="true"></div>
      <p class="s1c-readout" aria-hidden="true"><span>Bar</span> <b data-s1c-bar>1</b></p>
      <p class="s1c-standin">Stand-in. A screenshot of one of my FL Studio projects goes here.</p>
    </div>
    <div class="s1c-mini" data-s1c-mini aria-hidden="true">
      <Fragment set:html={mini} />
      <div class="s1c-lens" data-s1c-lens></div>
    </div>
  </div>
</section>
