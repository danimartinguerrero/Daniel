---
/**
 * s1, sketch A: hype stickers. A kiss-cut sheet of stickers under the shelf: a few things about me,
 * and the collection in numbers (worked out from data/music.ts, see facts.ts). Each one can be peeled
 * off and stuck anywhere in the section (stickers.ts). Positions are in % of the sheet and sizes in
 * cqw of it, one set for wide screens (x, y, r, w) and one for phones (px, py, pr, pw).
 */
import * as f from './facts';

type Shape = 'rect' | 'oval' | 'pill' | 'round' | 'burst';
interface Sticker {
  id: string;
  shape: Shape;
  /** Fill and ink. Fills are the label colours of the records (music-covers.json). */
  c: string;
  ink: string;
  /** Width / height. */
  a: number;
  /** Text size as a share of the sticker's width. */
  fs: number;
  at: [x: number, y: number, r: number, w: number];
  phone: [x: number, y: number, r: number, w: number];
  html: string;
}

const L = f.labelColour;
const stickers: Sticker[] = [
  { id: 'guitar', shape: 'rect', c: '#f4f2ec', ink: '#1d1d1f', a: 2.2, fs: 0.15, at: [6, 12, -3, 29], phone: [4, 4, -3, 64], html: 'Guitar<br>and bass.' },
  { id: 'notwell', shape: 'oval', c: L('igor'), ink: '#1d1d1f', a: 2.1, fs: 0.13, at: [26, 30, 9, 15], phone: [48, 17, 9, 40], html: 'Not very<br>well.' },
  { id: 'beats', shape: 'round', c: L('damn'), ink: '#fff', a: 1, fs: 0.2, at: [42.5, 6, 6, 19], phone: [8, 31, 6, 48], html: '' },
  { id: 'fl', shape: 'pill', c: L('ye'), ink: '#fff', a: 3, fs: 0.13, at: [41, 66, -5, 15], phone: [52, 40, -6, 42], html: 'FL Studio' },
  { id: 'mpk', shape: 'pill', c: L('good-kid-maad-city'), ink: '#fff', a: 3.6, fs: 0.105, at: [58, 76, 3, 19], phone: [40, 50, 4, 54], html: 'Akai MPK Mini' },
  { id: 'records', shape: 'burst', c: L('in-the-court'), ink: '#1d1d1f', a: 1, fs: 0.1, at: [71, 7, -8, 18], phone: [56, 59, -8, 40], html: `<b>${f.records}</b><span>records<br>on vinyl</span>` },
  { id: 'discs', shape: 'round', c: L('illmatic'), ink: '#fff', a: 1, fs: 0.1, at: [84, 46, 10, 14], phone: [6, 66, 10, 36], html: `<b>${f.discs}</b><span>discs.<br>${f.doubles} doubles.</span>` },
  { id: 'tracks', shape: 'rect', c: L('low-end-theory'), ink: '#fff', a: 1.9, fs: 0.15, at: [8, 63, 4, 16], phone: [8, 84, 4, 40], html: `${f.tracks}<br>tracks` },
  { id: 'years', shape: 'pill', c: L('we-dont-trust-you'), ink: '#fff', a: 3.2, fs: 0.11, at: [22, 50, -2, 17], phone: [48, 76, -3, 46], html: `${f.firstYear} to ${f.lastYear}` },
  { id: 'kendrick', shape: 'rect', c: L('to-pimp-a-butterfly'), ink: '#1d1d1f', a: 2.3, fs: 0.105, at: [60, 41, -4, 17], phone: [44, 88, -4, 48], html: `${f.topArtist}<br><b>×${f.topArtistCount}</b>` },
  { id: 'guests', shape: 'oval', c: L('the-wall'), ink: '#1d1d1f', a: 1.6, fs: 0.12, at: [26, 76, 7, 12], phone: [74, 31, 8, 26], html: `<b>${f.guests.size}</b><span>guests</span>` },
];

// A hype sticker's star: 18 points.
const burst = Array.from({ length: 36 }, (_, i) => {
  const a = (i / 36) * Math.PI * 2 - Math.PI / 2;
  const r = i % 2 ? 43 : 49;
  return `${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
const style = (s: Sticker) =>
  `--x:${s.at[0]};--y:${s.at[1]};--r:${s.at[2]}deg;--w:${s.at[3]};--px:${s.phone[0]};--py:${s.phone[1]};--pr:${s.phone[2]}deg;--pw:${s.phone[3]};--a:${s.a};--fs:${s.fs};--c:${s.c};--ink:${s.ink}`;
---
<section class="s1-stk" aria-labelledby="s1-stk-title" data-intro-rest data-s1-stickers>
  <header class="container s1-head">
    <p class="eyebrow s1-eyebrow">Hype stickers</p>
    <h2 class="s1-title" id="s1-stk-title">A few things about me.</h2>
    <p class="lede s1-lede"><span class="s1-hi">Guitar, bass and beats,</span> and the records in numbers. Peel one off and stick it anywhere.</p>
  </header>

  <div class="s1-sheet" data-s1-sheet>
    {stickers.map((s) => (
      <div class={`s1-slot s1-slot--${s.shape}`} style={style(s)} data-shape={s.shape}>
        <span class="s1-cut" aria-hidden="true">
          {s.shape === 'burst' && <svg viewBox="0 0 100 100"><polygon points={burst} /></svg>}
        </span>
        <div class={`s1-st s1-st--${s.id}`} data-s1-st tabindex="0">
          <span class="s1-st__flat" aria-hidden="true">{s.shape === 'burst' && <svg viewBox="0 0 100 100"><polygon points={burst} /></svg>}</span>
          <span class="s1-st__lift" aria-hidden="true">{s.shape === 'burst' && <svg viewBox="0 0 100 100"><polygon points={burst} /></svg>}</span>
          <span class="s1-st__body" data-s1-body>
            {s.shape === 'burst' && <svg class="s1-st__shape" viewBox="0 0 100 100" aria-hidden="true"><polygon points={burst} /></svg>}
            {s.id === 'beats' ? (
              <svg class="s1-st__shape s1-beats" viewBox="0 0 100 100" role="img" aria-label="Beats, made in my spare time">
                <circle cx="50" cy="50" r="48.5" />
                <path id="s1-beats-ring" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" fill="none" />
                <text class="s1-beats__ring"><textPath href="#s1-beats-ring" textLength="228">made in my spare time · made in my spare time ·</textPath></text>
                <text class="s1-beats__word" x="50" y="57" text-anchor="middle">Beats</text>
              </svg>
            ) : (
              <span class="s1-st__text" set:html={s.html} />
            )}
            <span class="s1-st__gloss" aria-hidden="true"></span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
