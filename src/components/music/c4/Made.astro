---
/**
 * Music, way c4: what the scroll makes once the camera is above the ring (c4/climb.ts). A sliver of
 * each of the eleven covers lifts off its sleeve and they stand together in the middle as a twelfth
 * sleeve; it comes to the front, its disc rolls out, and the disc's two sides say what its owner plays
 * and what he makes. Then it is sealed in film and laid down in the middle of the ring.
 *
 * Without the script, or with reduced motion, it is simply the finished sleeve with its disc half out
 * and the two sentences under it.
 */
import { vinyls } from '@/data/music';
import { sleeveImg } from '../v4/sleeve';
import { made } from './copy';

const n = vinyls.length;
// The bands lean as the rainbow in "music" does (115deg): 25 degrees off upright, top to the right.
const LEAN = 50 * Math.tan((25 * Math.PI) / 180); // % of the sleeve's width, either side of the middle
const OVER = 0.12; // they overlap by a hair, so no black shows between two of them
/** The j-th band of the sleeve, as a clip: the same on the sleeve it is lifted from and on the new one. */
const band = (j: number) => {
  const l = j === 0 ? -200 : (j / n) * 100 - OVER;
  const r = j === n - 1 ? 300 : ((j + 1) / n) * 100 + OVER;
  const f = (v: number) => `${v.toFixed(2)}%`;
  return `polygon(${f(l + LEAN)} 0, ${f(r + LEAN)} 0, ${f(r - LEAN)} 100%, ${f(l - LEAN)} 100%)`;
};
const words = (text: string) => text.split(' ');
---
<div class="c4-film" data-c4-film>
  <div class="c4-scrim" aria-hidden="true" data-c4-scrim></div>
  <div class="c4-cast" aria-hidden="true" data-c4-cast></div>

  <div class="c4-rec" aria-hidden="true" data-c4-rec>
    <div class="c4-disc" data-c4-disc>
      <div class="c4-disc__flip" data-c4-flip>
        <span class="v4-disc">
          <span class="v4-disc__shadow"></span>
          <span class="c4-turn" data-c4-turn>
            {made.sides.map((s) => (
              <span class={`c4-label c4-label--${s.side.toLowerCase()}`} data-c4-label>
                <svg viewBox="0 0 100 100" focusable="false">
                  <path id={`c4-arc-${s.side}`} d="M50,50 m-39,0 a39,39 0 1,1 78,0 a39,39 0 1,1 -78,0" fill="none" />
                  <text class="c4-label__ring" font-size={s.size} textLength="243" lengthAdjust="spacing"><textPath href={`#c4-arc-${s.side}`} textLength="243" lengthAdjust="spacing">{s.ring}</textPath></text>
                  <text class="c4-label__side" x="68" y="72" text-anchor="middle">{s.side}</text>
                </svg>
              </span>
            ))}
          </span>
          <span class="v4-disc__sheen"></span>
        </span>
      </div>
    </div>
    <div class="c4-cover">
      {vinyls.map((v, j) => (
        <span class="c4-slice" data-c4-slice style={`clip-path:${band(j)}`}>
          <Fragment set:html={sleeveImg(v)} />
          <span class="c4-slice__glint" data-c4-glint></span>
        </span>
      ))}
      <span class="c4-finish" data-c4-finish></span>
      <span class="c4-wrap c4-wrap--slack" data-c4-slack></span>
      <span class="c4-wrap c4-wrap--taut" data-c4-taut></span>
    </div>
  </div>

  <div class="c4-notes" data-c4-notes>
    {made.sides.map((s) => (
      <p class="c4-note" data-c4-note>
        {words(s.text).map((word) => <><span class="w" data-w>{word}</span>{' '}</>)}
      </p>
    ))}
  </div>

  <p class="v4-caption c4-caption" data-c4-caption>
    <span class="v4-caption__title">{made.caption.title}</span>
    <span class="v4-caption__meta">{made.caption.meta}</span>
  </p>
</div>
