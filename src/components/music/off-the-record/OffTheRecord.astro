---
/**
 * Music, way "Off the record": after the ring of records, what I do with music when I'm not listening
 * to it. Four plates, one word each, cut in titanium: the guitar, the bass, the piano and FL Studio.
 * They are moved by hand (dragged 1:1, thrown, held back at the ends, caught mid-flight) and by the
 * glass control under them, whose thumb is the same position seen small. Light runs across the metal as
 * the page scrolls and as a plate is moved. Behaviour in off-the-record.ts.
 *
 * Without JavaScript the plates stand one under the other and the control is not shown.
 */
import { offTheRecordCopy as copy } from './copy';
interface Props { vertical?: boolean }
const { vertical = false } = Astro.props;
const stringStory = Astro.slots.has('strings');
---
<section class="otr" aria-labelledby="otr-title" data-otr={vertical ? undefined : true} data-otr-vertical={vertical || undefined}>
  <header class="container otr__head">
    <p class="eyebrow otr__eyebrow">{copy.eyebrow}</p>
    <h2 class="headline otr__title" id="otr-title">{copy.headline}</h2>
    <p class="lede otr__lede">{copy.lede}</p>
  </header>

  {stringStory ? <slot name="strings" /> : <div class="otr__stage" data-otr-stage role="group" aria-roledescription={vertical ? undefined : "carousel"} aria-label={copy.label}>
    {copy.plates.map((plate) => (
      <article
        class="otr__plate"
        id={`otr-plate-${plate.id}`}
        role={vertical ? undefined : "tabpanel"}
        aria-labelledby={vertical ? `otr-word-${plate.id}` : `otr-tab-${plate.id}`}
        aria-roledescription={vertical ? undefined : "slide"}
        data-otr-plate
      >
        <h3 id={`otr-word-${plate.id}`} class="otr__word" data-otr-word>
          <span class="otr__metal">{plate.word.map((line) => <span class="otr__line">{line}</span>)}</span>
          <!-- The light on the metal: a bright copy of the word, seen through a soft-edged window that
               slides one way while the copy slides back, so only the light moves (two transforms). -->
          <span class="otr__glint" aria-hidden="true" data-otr-glint>
            <span class="otr__glint-copy" data-otr-glint-copy>{plate.word.map((line) => <span class="otr__line">{line}</span>)}</span>
          </span>
        </h3>
        <div class="otr__body" data-otr-body>
          <p class="otr__status"><i class="otr__dot" style={`--hue: ${plate.hue}`} aria-hidden="true"></i>{plate.status}</p>
          <p class="otr__text">{plate.text}</p>
        </div>
      </article>
    ))}
  </div>}

  {!vertical && !stringStory && <div class="otr__control-wrap">
    <div class="otr__control" role="tablist" aria-label={copy.label} data-otr-control>
      <span class="otr__thumb" aria-hidden="true" data-otr-thumb></span>
      {copy.plates.map((plate, i) => (
        <button
          class="otr__seg"
          type="button"
          role="tab"
          id={`otr-tab-${plate.id}`}
          aria-controls={`otr-plate-${plate.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-otr-seg
        >{plate.tab}</button>
      ))}
    </div>
  </div>}

  <p class="container otr__back"><a class="more" href="#v4-shelf-title" data-otr-back>{copy.back}</a></p>
</section>
