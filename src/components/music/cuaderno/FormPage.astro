---
/**
 * A record's page in the notebook: the right-hand page, a printed log form filled in by hand, with the
 * cover printed small and held in by photo corners. Only the record's own data: nothing on it is an
 * opinion the owner hasn't written.
 */
import { musicCopy, type Vinyl } from '@/data/music';

interface Props { v: Vinyl; i: number }
const { v, i } = Astro.props;
const { fields } = musicCopy.record;
---
<div class="cn-sheet cn-sheet--front">
  <figure class="cn-print">
    <img src={`/img/music/${v.id}.webp`} width="800" height="800" alt="" decoding="async" draggable="false" />
    <i class="cn-corner cn-corner--tl"></i><i class="cn-corner cn-corner--tr"></i>
    <i class="cn-corner cn-corner--bl"></i><i class="cn-corner cn-corner--br"></i>
  </figure>
  <p class="cn-hand cn-title">{v.title}</p>
  <p class="cn-hand cn-artist">{v.artist}</p>
  <dl class="cn-form">
    <div><dt>{fields.year}</dt><dd class="cn-hand">{v.year}</dd></div>
    <div><dt>{fields.label}</dt><dd class="cn-hand">{v.label}</dd></div>
    <div><dt>{fields.genre}</dt><dd class="cn-hand">{v.genre}</dd></div>
    <div><dt>{fields.format}</dt><dd class="cn-hand">{v.format}</dd></div>
    <div><dt>{fields.tracks}</dt><dd class="cn-hand">{v.tracks.length}</dd></div>
  </dl>
  <span class="cn-folio">{i + 1}</span>
</div>
