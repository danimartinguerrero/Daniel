---
/**
 * The instruments, direction "Macro" (/music/instruments-macro). Each instrument fills the screen and
 * the story is told along it: a camera travels in close, without a cut, from the headstock down the
 * neck to the strings and pickups, and each sentence of the story waits with the part of the
 * instrument it talks about; at the end the camera draws back and the whole instrument stands there.
 * The words fill with light as text fills everywhere on the site (../v4/text-fill.ts).
 *
 * The camera and the words are driven by macro.ts; the instrument is drawn live with WebGL
 * (instrument.ts). Without the script, without WebGL or with reduced motion, each chapter is its
 * sentences, lit, beside the upright still.
 */
import './macro.css';
import '@/styles/statement.css';
import '../v4/text-fill.css';

const heading = 'I play a few instruments, too.';
// The story as it is on the live page, cut where the camera moves on (its path is in macro.ts). Each
// beat says where its words sit on a wide screen (t/m/b, l/r) and on a phone (t/b): where that
// beat's framing leaves room.
const chapters = [
  {
    instrument: 'pj-bass', paint: 'BodyMaterial',
    beats: [
      ['My dad taught me to play bass.', 'bl', 't'],
      ['I used to play bass in my school band.', 'tr', 't'],
      ['At home I could stop and ask my dad to show me a part again.', 'br', 't'],
      ['At school I had to keep an ear on the drums and stay with everyone else.', 'tl', 't'],
    ],
  },
  {
    instrument: 'les-paul', paint: 'MainBake',
    beats: [
      ['Acoustic came next.', 'tl', 't'],
      ['My dad taught me acoustic guitar, too.', 'mr', 't'],
      ['When I switched to electric, I learned on my own.', 'tl', 't'],
      ['I still love putting on a song and working out where those notes are on the fretboard.', 'tr', 't'],
    ],
  },
];
---
<div class="mc" data-mc>
  <section class="mc__intro" id="instruments" aria-labelledby="part-instruments" data-mc-intro>
    <div class="mc__intro-stage statement__slide" data-mc-stage>
      <h2 class="mc__heading" id="part-instruments" data-fill-text>{heading.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h2>
    </div>
  </section>
  {chapters.map(({ instrument, paint, beats }, index) => (
    <section class="mc__chapter" aria-labelledby={`mc-${index}`} data-mc-chapter={instrument}
      data-model={`/music/macro/${instrument}.glb`} data-paint={paint}>
      <div class="mc__stage statement__slide" data-mc-stage>
        <img class="mc__still" loading="lazy" decoding="async" alt="" width="960" height="960"
          src={`/music/instruments/${instrument}/rest.webp`} />
        <canvas class="mc__canvas" width="1" height="1" aria-hidden="true"></canvas>
        <div class="mc__shade" aria-hidden="true"></div>
        <div class="container mc__beats">
          {beats.map(([beat, place, narrow], i) => i === 0
            ? <h3 class="mc__beat mc__title" id={`mc-${index}`} data-place={place} data-place-narrow={narrow} data-mc-beat data-fill-text>{beat.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h3>
            : <p class="mc__beat mc__line" data-place={place} data-place-narrow={narrow} data-mc-beat data-fill-text>{beat.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</p>)}
        </div>
      </div>
    </section>
  ))}
</div>

<script>
  import './macro';
</script>
