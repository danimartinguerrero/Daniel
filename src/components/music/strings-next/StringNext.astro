---
/**
 * The instruments, prototype "B, further" (/music/instruments-next), next to the live one in
 * ../strings. Each chapter is one held screen, built in three layers like a product page:
 *
 *   1. the instrument's name, huge and dark, the back wall of the screen;
 *   2. the instrument, drawn live with WebGL (instrument.ts, the live page's with a clear background),
 *      rising from lying under the words to standing in front of its name as the words fill;
 *   3. the words, at the left (at the top on a phone): a two-line title in white, the story in grey.
 *
 * Once it stands, the instrument is yours: drag it sideways to turn it round, flick it and it keeps
 * turning, and it settles facing you again; the glass pill under it gives it one full turn. Behaviour
 * lives in strings-next.ts. Without the script, or with reduced motion, it is lit text and an upright still.
 */
import './strings-next.css';
import '@/styles/statement.css';
import '../v4/text-fill.css';

const heading = 'I play a few instruments, too.';
const chapters = [
  {
    name: 'Bass', noun: 'bass', instrument: 'pj-bass', paint: 'BodyMaterial',
    title: 'My dad taught me to play bass.',
    body: 'I used to play bass in my school band. At home I could stop and ask my dad to show me a part again. At school I had to keep an ear on the drums and stay with everyone else.',
  },
  {
    name: 'Guitar', noun: 'guitar', instrument: 'les-paul', paint: 'MainBake',
    title: 'Acoustic came next.',
    body: 'My dad taught me acoustic guitar, too. When I switched to electric, I learned on my own. I still love putting on a song and working out where those notes are on the fretboard.',
  },
];
---
<div class="sn" data-sn>
  <section class="sn__intro" id="instruments" aria-labelledby="part-instruments" data-fill-section>
    <div class="sn__intro-stage statement__slide" data-fill-stage>
      <h2 class="sn__heading" id="part-instruments" data-fill-text>{heading.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h2>
    </div>
  </section>
  {chapters.map(({ name, noun, instrument, paint, title, body }, index) => (
    <section class="sn__chapter" aria-labelledby={`sn-${index}`} data-fill-section
      data-model={`/music/instruments/${instrument}.glb`} data-paint={paint} style={`--name-chars:${name.length}`}>
      <div class="sn__stage statement__slide" data-fill-stage>
        <p class="sn__name" aria-hidden="true" data-sn-name>{name}</p>
        <div class="sn__art" data-sn-art>
          <img class="sn__still" loading="lazy" decoding="async" alt="" width="960" height="960"
            src={`/music/instruments/${instrument}/rest.webp`} />
          <canvas class="sn__frame" width="1" height="1" aria-hidden="true"></canvas>
          <div class="sn__grab" role="slider" tabindex="-1" aria-label={`Turn the ${noun}`}
            aria-valuemin="0" aria-valuemax="359" aria-valuenow="0" aria-valuetext="Facing you"
            data-sn-grab></div>
          <button type="button" class="sn__turn pill--glass" tabindex="-1" data-sn-turn>
            <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="M15.5 8.2A6 6 0 1 0 16 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16.4 4.6v3.9h-3.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Turn the {noun}</span>
          </button>
        </div>
        <div class="container sn__content">
          <div class="sn__copy">
            <h3 id={`sn-${index}`} class="sn__title" data-fill-text>{title.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h3>
            <p class="sn__body" data-fill-text>{body.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</p>
          </div>
        </div>
      </div>
    </section>
  ))}
</div>

<script>
  import './strings-next';
</script>
