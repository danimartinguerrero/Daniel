---
/**
 * What lies on the floor under the records (engine.ts draws it from the scene climb.ts works out):
 * each record's shadow while it is carried over the floor, the year printed beside its place in the
 * line, and the threads of light from each person's name to their records. All of it is decoration
 * for the eye; the same facts are in the page's text (Still.astro) for everyone else.
 */
import { vinyls } from '@/data/music';
import { people } from './people';
---
<div class="dsc-under" aria-hidden="true" data-dsc-under>
  {vinyls.map(() => <span class="dsc-shadow" data-dsc-shadow></span>)}
  {vinyls.map((v) => <span class="dsc-year" data-dsc-year><span class="dsc-year__n">{v.year}</span></span>)}
  {people.map((p, pi) => p.records.map((r) => (
    <span class="dsc-thread" data-dsc-thread data-person={pi} data-record={r}></span>
  )))}
</div>
