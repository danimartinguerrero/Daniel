---
/**
 * The floor's two arrangements as plain page content: the records in the order they came out, and the
 * people on more than one of them. It is what the page shows with reduced motion or without its
 * script; otherwise it is there only for screen readers (the floor itself is aria-hidden).
 */
import { vinyls } from '@/data/music';
import { byYear, people } from './people';
---
<section class="dsc-still" aria-labelledby="dsc-years-title">
  <div class="container dsc-still__inner">
    <h2 class="dsc-still__title" id="dsc-years-title">In the order they came out</h2>
    <ol class="dsc-still__years">
      {byYear.map((i) => {
        const v = vinyls[i]!;
        return (
          <li class="dsc-still__rec">
            <img src={`/img/music/${v.id}.webp`} width="800" height="800" alt="" loading="lazy" decoding="async" />
            <span class="dsc-still__year">{v.year}</span>
            <span class="dsc-still__name">{v.title}</span>
            <span class="dsc-still__by">{v.artist}</span>
          </li>
        );
      })}
    </ol>

    <h2 class="dsc-still__title">On more than one record</h2>
    <ul class="dsc-still__people">
      {people.map((p) => (
        <li class="dsc-still__person">
          <p class="dsc-still__who">{p.name}</p>
          <div class="dsc-still__covers" aria-hidden="true">
            {p.records.map((i) => <img src={`/img/music/${vinyls[i]!.id}.webp`} width="800" height="800" alt="" loading="lazy" decoding="async" />)}
          </div>
          <ul class="dsc-still__lines">{p.lines.map((l) => <li>{l}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>
