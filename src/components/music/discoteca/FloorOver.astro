---
/**
 * What stands above the records on the floor: the names of the people on more than one record, as
 * glass pills where their threads meet (engine.ts places them and answers a tap), and the dark edge
 * the floor fades into under the record's name.
 */
import { people } from './people';
---
<div class="dsc-over" data-dsc-over>
  <div class="dsc-edge" aria-hidden="true" data-dsc-edge></div>
  {people.map((p, pi) => (
    <div class="dsc-pin" data-dsc-pin>
      <button type="button" class="dsc-pill" data-dsc-pill={pi} aria-pressed="false" aria-describedby={`dsc-who-${pi}`}>{p.name}</button>
      <span class="sr-only" id={`dsc-who-${pi}`}>On {p.lines.join('; ')}.</span>
    </div>
  ))}
</div>
