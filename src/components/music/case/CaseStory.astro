---
/**
 * The instruments, prototype "Estuche" (/music/instruments-case). The records above come sealed in their
 * plastic and you open them; the instruments come in their cases. Each chapter is one held screen
 * filled by the instrument's hard case, lying shut on the floor under a soft light: as the words fill,
 * the lid lifts and the velvet lining comes into the light, then the instrument rises out of its cavity
 * and turns its face to you. The lid is also the hand's: lift it or shut it by its front edge.
 * Drawn live with WebGL (scene.ts); behaviour in case.ts. Without the script, without WebGL or with
 * reduced motion, it is lit text and the instrument's still.
 */
import './case.css';
import '@/styles/statement.css';
import '../v4/text-fill.css';

const heading = 'I play a few instruments, too.';
// lining/sheen: the velvet. Oxblood for the bass, ink for the guitar: deep enough to sit beside the
// page's black, warm enough to read as cloth.
const chapters = [
  {
    noun: 'bass', instrument: 'pj-bass', paint: 'BodyMaterial', lining: '#2a0c10', sheen: '#7a3a3c',
    title: 'My dad taught me to play bass.',
    body: 'I used to play bass in my school band. At home I could stop and ask my dad to show me a part again. At school I had to keep an ear on the drums and stay with everyone else.',
  },
  {
    noun: 'guitar', instrument: 'les-paul', paint: 'MainBake', lining: '#0c1424', sheen: '#41557a',
    title: 'Acoustic came next.',
    body: 'My dad taught me acoustic guitar, too. When I switched to electric, I learned on my own. I still love putting on a song and working out where those notes are on the fretboard.',
  },
];
---
<div class="case" data-case>
  <section class="case__intro" id="instruments" aria-labelledby="part-instruments" data-fill-section>
    <div class="case__intro-stage statement__slide" data-fill-stage>
      <h2 class="case__heading" id="part-instruments" data-fill-text>{heading.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h2>
    </div>
  </section>
  {chapters.map(({ noun, instrument, paint, lining, sheen, title, body }, index) => (
    <section class="case__chapter" aria-labelledby={`case-${index}`} data-fill-section
      data-model={`/music/instruments/${instrument}.glb`} data-paint={paint} data-lining={lining} data-sheen={sheen}>
      <div class="case__stage statement__slide" data-fill-stage>
        <img class="case__still" loading="lazy" decoding="async" alt="" width="960" height="960"
          src={`/music/instruments/${instrument}/rest.webp`} />
        <canvas class="case__scene" aria-hidden="true" data-case-scene></canvas>
        <button type="button" class="case__lip" tabindex="-1" aria-pressed="false"
          aria-label={`Open the ${noun}'s case`} data-label-open={`Open the ${noun}'s case`}
          data-label-shut={`Close the ${noun}'s case`} data-case-lip></button>
        <h3 id={`case-${index}`} class="case__title" data-fill-text>{title.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</h3>
        <p class="case__body" data-fill-text>{body.split(' ').map(word => <><span class="w" data-w>{word}</span>{' '}</>)}</p>
      </div>
    </section>
  ))}
</div>

<script>
  import './case';
</script>
