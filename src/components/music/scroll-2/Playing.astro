---
/**
 * Music, way scroll-2: the page after the ring of records, read by scrolling on as the rest of the site
 * is. One sentence opens each part and a picture under it shows what the sentence is about: the necks
 * of a guitar and a bass, a stretch of piano keys, the MPK Mini. The pictures move only to show the
 * thing in use (playing.ts): the strings ring as they come into view, and the keys and the pads are
 * pressed in turn as the page is scrolled past them, backwards when it is scrolled back.
 */
import { Image } from 'astro:assets';
import { playingCopy as t } from './copy';
import mpkOff from './mpk-off.webp';
import mpkOn from './mpk-on.webp';

/* ---------------------------------------------------------------- the necks
   Frets fall where a real neck has them: fret n is 1 − 2^(−n/12) of the scale along. Frets 1 to 15 are
   spread across the band; the dots go between frets 2–3, 4–5, 6–7, 8–9, 11–12 (two), 14–15. */
const at = (n: number) => 1 - 2 ** (-n / 12);
const span = at(15) - at(1);
const fretX = (n: number) => -4 + ((at(n) - at(1)) / span) * 108; // % of the band, a little past each end
const frets = Array.from({ length: 15 }, (_, i) => fretX(i + 1));
const dot = (n: number) => (fretX(n - 1) + fretX(n)) / 2;
const dots = [3, 5, 7, 9, 15].map(dot);
const twelfth = dot(12);

/** Strings from the lowest, at the top (the neck as its player sees it), with their gauges in inches. */
const guitar = [0.046, 0.036, 0.026, 0.017, 0.013, 0.01].map((g, i) => ({ g, wound: i < 3 }));
const bass = [0.105, 0.085, 0.065, 0.045].map((g) => ({ g, wound: true }));
const strings = (set: { g: number; wound: boolean }[], from: number, to: number) =>
  set.map((s, i) => ({ ...s, y: from + ((to - from) * i) / (set.length - 1), i }));

/* ---------------------------------------------------------------- the keys
   C2 to C7, with middle C's octave in the middle of the screen. The scale is C4 to C5. */
const NAMES = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
const whites = Array.from({ length: 36 }, (_, i) => ({ name: NAMES[i % 7]!, octave: 2 + Math.floor(i / 7), i }));
const blackAfter = new Set(['C', 'D', 'F', 'G', 'A']);
const blacks = whites.filter((w, i) => blackAfter.has(w.name) && i < whites.length - 1).map((w) => w.i);
const SCALE_FROM = 14; // C4
const fingers = [1, 2, 3, 1, 2, 3, 4, 5];

/* ---------------------------------------------------------------- the pads
   Where each pad is on the picture, as % of it: left, top, width, height. Pads 1–4 are the near row.
   Measured on the render (the lit picture against the unlit one). */
const pads: [number, number, number, number][] = [
  [20.72, 23.3, 8.15, 14], [30.53, 23.3, 7.99, 14], [40.65, 23.3, 7.83, 14], [50.45, 23.3, 7.88, 14],
  [21.26, 6.67, 7.99, 13.57], [30.85, 6.67, 7.88, 13.57], [40.81, 6.67, 7.73, 13.57], [50.45, 6.67, 7.73, 13.57],
];
const f = (n: number) => n.toFixed(2);
---
<section class="sc2" aria-labelledby="sc2-eyebrow" data-sc2 data-intro-rest>
  <!-- Guitar and bass: the sentence that opens the chapter, then the two necks. -->
  <header class="container sc2-head">
    <h2 class="eyebrow v4-eyebrow" id="sc2-eyebrow">{t.eyebrow}</h2>
    <h3 class="sc2-title">{t.title}</h3>
    <p class="lede sc2-lede">{t.lede}</p>
  </header>

  <div class="sc2-necks" aria-hidden="true">
    {[{ name: t.guitar, set: strings(guitar, 14, 86), kind: 'guitar' }, { name: t.bass, set: strings(bass, 17, 83), kind: 'bass' }].map((neck) => (
      <figure class={`sc2-neck sc2-neck--${neck.kind}`} data-sc2-strum>
        <figcaption class="container sc2-label">{neck.name}</figcaption>
        <div class="sc2-board">
          {frets.map((x) => <span class="sc2-fret" style={`left:${f(x)}%`} />)}
          {dots.map((x) => <span class="sc2-dot" style={`left:${f(x)}%`} />)}
          <span class="sc2-dot sc2-dot--a" style={`left:${f(twelfth)}%`} />
          <span class="sc2-dot sc2-dot--b" style={`left:${f(twelfth)}%`} />
          {neck.set.map((s) => (
            <span class:list={['sc2-string', { 'is-wound': s.wound }]} style={`top:${f(s.y)}%;--g:${(s.g * 92).toFixed(2)};--i:${s.i}`}>
              <span class="sc2-string__ring" />
            </span>
          ))}
        </div>
      </figure>
    ))}
  </div>

  <!-- The piano: the sentence, then the keys, with the fingering of the scale they are pressed in. -->
  <div class="container sc2-part">
    <h3 class="sc2-say">{t.piano}</h3>
  </div>
  <figure class="sc2-piano" aria-hidden="true" data-sc2-keys>
    <figcaption class="container sc2-label">{t.pianoNote}</figcaption>
    <div class="sc2-keyboard">
      <div class="sc2-keys" style={`--from:${SCALE_FROM}`}>
        {whites.map((w) => {
          const k = w.i - SCALE_FROM;
          const inScale = k >= 0 && k < fingers.length;
          return (
            <span class:list={['sc2-white', { 'is-c4': w.name === 'C' && w.octave === 4 }]} style={`--x:${w.i}`} data-sc2-key={inScale ? k : undefined}>
              {inScale && <span class="sc2-white__down" />}
              {inScale && <span class="sc2-finger"><span>{fingers[k]}</span><span class="sc2-finger__on">{fingers[k]}</span></span>}
            </span>
          );
        })}
        {blacks.map((i) => <span class="sc2-black" style={`--x:${i + 1}`} />)}
      </div>
    </div>
  </figure>

  <!-- FL Studio and the MPK Mini: the sentence, then the controller, its pads lit in turn by the scroll. -->
  <div class="container sc2-part">
    <h3 class="sc2-say">{t.studio}</h3>
  </div>
  <figure class="sc2-mpk" aria-hidden="true" data-sc2-pads>
    <div class="sc2-mpk__frame">
      <Image class="sc2-mpk__img" src={mpkOff} widths={[800, 1600]} sizes="(min-width: 960px) 56rem, 100vw" alt="" loading="lazy" decoding="async" />
      {pads.map(([l, top, w, h]) => (
        <span class="sc2-pad" style={`left:${f(l)}%;top:${f(top)}%;width:${f(w)}%;height:${f(h)}%`} data-sc2-pad>
          <span class="sc2-pad__glow" />
          <span class="sc2-pad__lit" style={`background-image:url(${mpkOn.src});background-size:${f((100 / w) * 100)}% ${f((100 / h) * 100)}%;background-position:${f((l / (100 - w)) * 100)}% ${f((top / (100 - h)) * 100)}%`} />
        </span>
      ))}
    </div>
  </figure>

  <p class="container sc2-credit">
    The MPK Mini is drawn from a 3D model, <a href={t.credit.source} rel="noopener">“{t.credit.title}” by {t.credit.author}</a>{' '}(<a href={t.credit.licenceUrl} rel="noopener license">{t.credit.licence}</a>), with its logos removed.
  </p>
</section>
