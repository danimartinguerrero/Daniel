---
/**
 * One sheet of shrink-wrap, the size of the sleeve: a faint haze with two bands of sheen where the
 * light from above catches it, creases near the corners and along the heat seal, and the hype sticker
 * with the record's format. The page shows it in two windows (above and below the tear strip), so the
 * film reads as one continuous sheet; the sheen layer is separate so it can thin as the strip comes off.
 */
interface Props {
  format: string;
}
const { format } = Astro.props;
---
<span class="sheet" aria-hidden="true">
  <span class="sheet__gloss">
    <svg class="sheet__creases" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <g fill="none" stroke-linecap="round">
        <g stroke="#fff" stroke-opacity="0.32" stroke-width="0.35">
          <path d="M2 9 C 8 7, 12 3, 15 1" />
          <path d="M1 17 C 5 15, 9 12, 11 9" />
          <path d="M86 1 C 90 4, 94 6, 99 7" />
          <path d="M91 2 C 93 6, 97 10, 99 13" />
          <path d="M1 86 C 5 88, 8 92, 9 99" />
          <path d="M97 84 C 95 89, 92 94, 87 99" />
          <path d="M99 91 C 96 94, 95 97, 94 99" />
          <path d="M3 30 C 4 36, 2 40, 3 43" />
          <path d="M3 58 C 4 64, 2 70, 3 75" />
          <path d="M40 98.6 C 52 97.6, 61 98.4, 72 97.8" />
          <path d="M30 1.4 C 42 2.2, 50 1.2, 58 2" />
        </g>
        <g stroke="#000" stroke-opacity="0.22" stroke-width="0.35">
          <path d="M2.6 10 C 8.6 8, 12.6 4, 15.6 2" />
          <path d="M91.6 3 C 93.6 7, 97.6 11, 99.6 14" />
          <path d="M1.6 87 C 5.6 89, 8.6 93, 9.6 99.6" />
          <path d="M3.6 59 C 4.6 65, 2.6 71, 3.6 76" />
        </g>
      </g>
    </svg>
  </span>
  <span class="sheet__sticker"><span>{format}</span></span>
</span>
