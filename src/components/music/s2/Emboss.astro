---
/**
 * Sketch s2/b, "Blind emboss": under the eleven printed sleeves, a twelfth that is blank, the plain
 * white card a test pressing comes in, with a die-cut hole onto its disc. What he makes is pressed
 * into the card with no ink: the words are only relief, and the lamp reads them. Turn the card and the
 * light rakes across the letters (emboss.ts). The text is real text; the copies that draw the relief's
 * light and shadow are hidden from assistive technology.
 */
const words = [
  ['big', 'I make beats.'],
  ['line', 'In my spare time, in FL Studio, on an Akai MPK Mini.'],
  ['side', 'I play guitar and bass too. Not very well.'],
  ['name', 'Nicolás Muñoz García'],
] as const;
const layers = [
  { cls: 's2e-type--shade', attr: 'data-s2e-shade', hidden: true },
  { cls: 's2e-type--light', attr: 'data-s2e-light', hidden: true },
  { cls: 's2e-type--face', attr: 'data-s2e-face', hidden: false },
];
---
<section class="s2e" aria-label="What I make" data-intro-rest data-s2e>
  <div class="s2e__stage">
    <div class="s2e-card" data-s2e-card>
      <div class="s2e-body" data-s2e-body>
        <div class="s2e-disc" data-s2e-disc aria-hidden="true">
          <span class="s2e-disc__label"></span>
        </div>
        <div class="s2e-board">
          {layers.map((l) => (
            <div class={`s2e-type ${l.cls}`} {...{ [l.attr]: '' }} aria-hidden={l.hidden ? 'true' : undefined}>
              {words.map(([k, t]) => <span class={`s2e-t s2e-t--${k}`}>{t}</span>)}
            </div>
          ))}
          <span class="s2e-board__sheen" data-s2e-sheen aria-hidden="true"></span>
          <span class="s2e-board__dim" data-s2e-dim aria-hidden="true"></span>
        </div>
        <span class="s2e-rim" data-s2e-rim aria-hidden="true"></span>
      </div>
    </div>
  </div>
  <p class="s2e__hint">Tilt it to the light.</p>
</section>
