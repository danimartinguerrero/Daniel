---
/**
 * Sketch s2/a, "Vellum" (the name stuck from the paper version; it is clear film now). One clear
 * sheet per record, printed in white with the record in an index on the left and every name on it
 * in a field on the right. All eleven sheets carry the same index and the same field, laid out
 * identically, and each inks only what is its own; so stacked, a name the records share is printed
 * several times on the same spot and its light adds up. The sheet on top is sharp, the ones under it
 * dimmer and softer the deeper they lie. vellum.ts moves them.
 */
import { vinyls } from '@/data/music';
import { names } from './collection';
import { START } from '../v4/start';

const order = [vinyls[START]!, ...vinyls.filter((_, i) => i !== START)];
---
<section class="s2v" aria-labelledby="s2v-title" data-intro-rest data-s2v>
  <header class="container s2v__head">
    <h2 class="s2v__title" id="s2v-title">Everyone on them.</h2>
    <p class="lede s2v__lede">One clear sheet for each record, printed with who made it, who is on it and who put it out. Stacked, the names they share come through brighter.</p>
  </header>

  <div class="s2v__stage" data-s2v-stage>
    <div class="container s2v__frame">
      <div class="s2v-stack" data-s2v-stack>
        {order.map((v, depth) => (
          <div class="s2v-sheet" data-s2v-sheet={v.id} style={`z-index:${100 - depth}`} aria-hidden={depth === 0 ? undefined : 'true'}>
            <span class="s2v-sheet__edge" data-s2v-edge />
            <span class="s2v-sheet__glint" data-s2v-glint />
            <div class="s2v-sheet__ink" data-s2v-ink>
              <ol class="s2v-index">
                {vinyls.map((w) => (
                  <li class:list={['s2v-index__row', { 'is-on': w.id === v.id }]} data-s2v-pick={w.id}>
                    <span class="s2v-index__title">{w.title}</span>
                    <span class="s2v-index__meta">{w.artist}, {w.year} · {w.format}</span>
                  </li>
                ))}
              </ol>
              <p class="s2v-names">
                {names.map((n) => (
                  <span class:list={['s2v-name', `s2v-name--${n.kind}`, { 'is-on': n.on.has(v.id) }]}>{n.text}</span>
                ))}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <p class="container s2v__hint">Turn the records above, tap a title, or slide the top sheet off.</p>
</section>
