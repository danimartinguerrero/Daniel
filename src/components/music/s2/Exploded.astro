---
/**
 * Sketch s2/c, "Exploded beat": one of his FL Studio projects, taken apart as you scroll. It starts as
 * one window facing you, tips back onto the desk, and its four layers lift apart in depth, the nearest
 * lit, the deeper ones darker, each with a line saying what it is (exploded.ts).
 *
 * THIS SKETCH NEEDS MATERIAL FROM THE OWNER. The four panes are stand-ins, deliberately obvious: hatched
 * grey with a label. He would supply four screenshots of one real project (Playlist, Channel rack, Piano
 * roll of one pattern, Mixer), each at 2× of a 1920×1080 window, plus the beat's name and the year he
 * made it. They would go in public/img/music/s2/ as playlist.webp, channel-rack.webp, piano-roll.webp
 * and mixer.webp.
 */
const layers = [
  { id: 'playlist', name: 'Playlist', line: 'The arrangement: the patterns laid out in time, start to end.' },
  { id: 'channel-rack', name: 'Channel rack', line: 'The sounds, and the steps that set them off.' },
  { id: 'piano-roll', name: 'Piano roll', line: 'The notes of one pattern.' },
  { id: 'mixer', name: 'Mixer', line: 'Where each sound is levelled and everything is summed.' },
];
---
<section class="s2x" aria-labelledby="s2x-title" data-intro-rest data-s2x>
  <header class="container s2x__head">
    <h2 class="s2x__title" id="s2x-title">Inside one of my beats.</h2>
    <p class="lede s2x__lede">I make them in my spare time, in FL Studio, on an Akai MPK Mini. Here is one project, taken apart.</p>
  </header>
  <div class="s2x__track" data-s2x-track>
    <div class="s2x__stage">
      <div class="s2x-scene">
        <div class="s2x-group" data-s2x-group>
          {/* Bottom layer first: each layer carries its whole 3D transform (no preserve-3d, which some
              WebKit builds flatten), so the order they are painted in is the order in the DOM. */}
          {[...layers].reverse().map((l) => (
            <div class="s2x-layer" data-s2x-layer={layers.indexOf(l)}>
              <div class="s2x-pane" data-s2x-pane>
                <div class="s2x-pane__stand">
                  <span class="s2x-pane__tag">Stand-in</span>
                  <span class="s2x-pane__what">Screenshot of the {l.name}</span>
                  <span class="s2x-pane__file">public/img/music/s2/{l.id}.webp</span>
                </div>
                <span class="s2x-pane__shade" data-s2x-shade />
              </div>
            </div>
          ))}
        </div>
        <ol class="s2x-labels">
          {layers.map((l) => (
            <li class="s2x-label" data-s2x-label>
              <span class="s2x-label__name">{l.name}</span>
              <span class="s2x-label__line">{l.line}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="s2x__beat" data-s2x-beat><span class="s2x__beat-name">[Name of the beat]</span> <span class="s2x__beat-meta">[year] · FL Studio</span></p>
    </div>
  </div>
</section>
