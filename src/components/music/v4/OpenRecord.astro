---
/**
 * The record out of the row: sealed, with its tear tape, then unwrapped, with its details
 * (listening-bar.ts). It covers the page, so it sits beside the page's content, not inside it.
 */
import { musicCopy } from '@/data/music';
---
<div class="v4-open" data-v4-open hidden role="dialog" aria-modal="true" aria-labelledby="v4-open-title">
  <div class="v4-open__scrim" data-v4-scrim></div>
  <!-- The shadow a record throws on the floor and on its neighbours while it is put down into the ring
       seen from above, or picked up out of it (listening-bar.ts). -->
  <div class="v4-open__cast" data-v4-cast aria-hidden="true"></div>
  <div class="v4-open__scroll" data-v4-scroll>
    <div class="v4-open__inner">
      <div class="v4-stage" data-v4-stage>
        <div class="v4-rec" data-v4-hero>
          <div class="v4-rec__group" data-v4-group>
            <div class="v4-disc" data-v4-disc aria-hidden="true">
              <div class="v4-disc__shadow" data-v4-disc-shadow></div>
              <div class="v4-disc__sheen"></div>
              <div class="v4-disc__label"></div>
            </div>
            <div class="v4-rec__sleeve">
              <div class="v4-rec__shadow" data-v4-shadow aria-hidden="true"></div>
              <div class="v4-art v4-rec__art" data-v4-art aria-hidden="true"></div>
              <!-- The shrink-wrap: clear film in two pieces either side of the tear strip. Each piece
                   carries two lights: the film pulled taut, and the same film gone slack, which shows
                   as the strip comes off. -->
              <div class="v4-plastic" data-v4-plastic aria-hidden="true">
                {(['top', 'bottom'] as const).map((side) => (
                  <div class={`v4-film v4-film--${side}`} data-v4-film={side}>
                    <div class="v4-film__win"><div class="v4-film__body" data-v4-film-body></div><div class="v4-film__sheet" data-v4-sheet></div><div class="v4-film__slack" data-v4-slack></div><div class="v4-film__edge" data-v4-film-edge></div></div>
                  </div>
                ))}
                <!-- In the row the film is one unbroken sheet. This piece is the film where the tape
                     will be: it is there as the record comes out and goes as the tape appears. -->
                <div class="v4-film v4-film--mid" data-v4-film-mid>
                  <div class="v4-film__win"><div class="v4-film__sheet"></div></div>
                </div>
              </div>
              <!-- The lamp's light and the film's edge as a sleeve in the row has them: the record
                   takes them on as it flies back, and lets them go as it comes out. -->
              <div class="v4-rec__lamp" data-v4-lamp aria-hidden="true"></div>
              <div class="v4-strip" data-unwrap>
                <div class="v4-strip__win" data-v4-strip-win>
                  <div class="v4-strip__band" data-v4-strip-band>
                    <span class="v4-strip__sweep" data-v4-sweep></span>
                    <span class="v4-strip__label" data-v4-strip-label aria-hidden="true">{musicCopy.record.unwrap}</span>
                  </div>
                </div>
              </div>
              <div
                class="v4-tab"
                data-unwrap-handle
                role="slider"
                tabindex="0"
                aria-label={musicCopy.record.unwrap}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                aria-orientation="horizontal"
              >
                <span class="v4-tab__knob">
                  <span class="v4-tab__dot">
                    <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M2.5 8h10.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="v4-open__titles" data-v4-titles>
          <p class="v4-open__edition" data-v4-edition></p>
          <h2 class="v4-open__title" id="v4-open-title" tabindex="-1" data-v4-title></h2>
          <p class="v4-open__meta" data-v4-meta></p>
        </div>
      </div>

      <div class="v4-details" data-v4-details hidden>
        <div class="v4-aside">
          <section class="v4-block v4-block--why">
            <h3 class="v4-block__title">{musicCopy.record.about}</h3>
            <p class="v4-why" data-v4-about></p>
            <a class="v4-source" data-v4-source target="_blank" rel="noopener">
              <!-- Apple Music's logo: its tile (Simple Icons, CC0) in Apple's red, the note cut out of it showing white. -->
              <svg class="v4-source__logo" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <defs><linearGradient id="v4-am" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fa5c76" /><stop offset="1" stop-color="#fa233b" /></linearGradient></defs>
                <rect x="2" y="2" width="20" height="20" rx="4" fill="#fff" />
                <path fill="url(#v4-am)" d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.801.42.127.856.187 1.293.228.555.053 1.11.06 1.667.06h11.03a12.5 12.5 0 001.57-.1c.822-.106 1.596-.35 2.295-.81a5.046 5.046 0 001.88-2.207c.186-.42.293-.87.37-1.324.113-.675.138-1.358.137-2.04-.002-3.8 0-7.595-.003-11.393zm-6.423 3.99v5.712c0 .417-.058.827-.244 1.206-.29.59-.76.962-1.388 1.14-.35.1-.706.157-1.07.173-.95.045-1.773-.6-1.943-1.536a1.88 1.88 0 011.038-2.022c.323-.16.67-.25 1.018-.324.378-.082.758-.153 1.134-.24.274-.063.457-.23.51-.516a.904.904 0 00.02-.193c0-1.815 0-3.63-.002-5.443a.725.725 0 00-.026-.185c-.04-.15-.15-.243-.304-.234-.16.01-.318.035-.475.066-.76.15-1.52.303-2.28.456l-2.325.47-1.374.278c-.016.003-.032.01-.048.013-.277.077-.377.203-.39.49-.002.042 0 .086 0 .13-.002 2.602 0 5.204-.003 7.805 0 .42-.047.836-.215 1.227-.278.64-.77 1.04-1.434 1.233-.35.1-.71.16-1.075.172-.96.036-1.755-.6-1.92-1.544-.14-.812.23-1.685 1.154-2.075.357-.15.73-.232 1.108-.31.287-.06.575-.116.86-.177.383-.083.583-.323.6-.714v-.15c0-2.96 0-5.922.002-8.882 0-.123.013-.25.042-.37.07-.285.273-.448.546-.518.255-.066.515-.112.774-.165.733-.15 1.466-.296 2.2-.444l2.27-.46c.67-.134 1.34-.27 2.01-.403.22-.043.442-.088.663-.106.31-.025.523.17.554.482.008.073.012.148.012.223.002 1.91.002 3.822 0 5.732z" />
              </svg>
              <span data-v4-source-label></span>
            </a>
          </section>
          <section class="v4-block v4-block--personal" data-v4-personal hidden aria-labelledby="v4-personal-title">
            <h3 class="v4-block__title" id="v4-personal-title">Why I like it</h3>
            <p class="v4-why" data-v4-personal-copy></p>
          </section>
        </div>
        <section class="v4-block v4-block--tracks">
          <h3 class="v4-block__title">{musicCopy.record.tracklist}<span class="v4-track-count" aria-hidden="true" data-track-count></span></h3>
          <ol class="v4-tracks" data-tracklist></ol>
        </section>
        <!-- The record's small print, set under the last track as Apple Music sets an album's. -->
        <section class="v4-block v4-block--info" data-record-info aria-labelledby="v4-info-title">
          <h3 class="sr-only" id="v4-info-title">{musicCopy.record.info}</h3>
          <dl class="v4-colophon">
            {(['year', 'format', 'tracks', 'genre', 'label'] as const).map((field) => (
              <div class={`v4-colophon__item v4-colophon__item--${field}`}>
                <dt class="sr-only">{musicCopy.record.fields[field]}</dt>
                <dd data-v4-fact={field}></dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

    </div>
  </div>
  <div class="v4-open__bar" data-v4-bar>
    <button class="pill v4-close" type="button" data-record-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m9.5 3-5 5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>{musicCopy.record.close}</span>
    </button>
  </div>
  <div class="v4-open__edge" data-v4-edge aria-hidden="true"></div>
</div>
