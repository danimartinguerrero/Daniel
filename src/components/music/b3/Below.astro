---
/**
 * Everything version b3 adds under the records: the back of a sleeve. The records above are fronts; this
 * is one turned over. Side A is the shelf itself, one dense line a record, computed from
 * src/data/music.ts; Side B, set large, is what I play and make; the small print runs along the foot.
 * Words live in ./copy.ts.
 *
 * A row of Side A is a button: it takes the visitor up to that record and turns the carousel to it
 * (b3.ts). The row of the record in the middle of the carousel is lit, so the back and the front agree.
 */
import { vinyls } from '@/data/music';
import { START } from '@/components/music/v4/start';
import { copy } from './copy';
---
<section class="b3-below" aria-labelledby="b3-title" data-intro-rest>
  <header class="container b3-head">
    <p class="eyebrow v4-eyebrow">{copy.eyebrow}</p>
    <h2 class="b3-title" id="b3-title">{copy.title}</h2>
  </header>

  <div class="container--wide b3-stage">
    <article class="b3-sleeve" aria-labelledby="b3-title" data-b3-sleeve>
      <section class="b3-side b3-side--a" aria-labelledby="b3-a">
        <h3 class="b3-side__head" id="b3-a">
          <span class="b3-side__name">{copy.sideA.name}</span>
          <span class="b3-side__what">{copy.sideA.what}</span>
        </h3>
        <ol class="b3-list b3-list--a">
          {vinyls.map((v, i) => (
            <li>
              <button
                type="button"
                class="b3-row b3-row--record"
                data-b3-row={v.id}
                aria-current={i === START ? 'true' : undefined}
                aria-label={copy.sideA.show(v.title)}
              >
                <span class="b3-row__no">A{i + 1}</span>
                <span class="b3-row__body">
                  <span class="b3-row__title">{v.title}</span>{' '}
                  <span class="b3-row__credit">{v.artist}</span>
                </span>
                <span class="b3-row__year">{v.year}</span>
                <span class="b3-row__format">{v.format}</span>
              </button>
            </li>
          ))}
        </ol>
      </section>

      <section class="b3-side b3-side--b" aria-labelledby="b3-b">
        <h3 class="b3-side__head" id="b3-b">
          <span class="b3-side__name">{copy.sideB.name}</span>
          <span class="b3-side__what">{copy.sideB.what}</span>
        </h3>
        <ol class="b3-list b3-list--b">
          {copy.sideB.tracks.map((t, i) => (
            <li class="b3-big">
              <span class="b3-big__no">B{i + 1}</span>
              <span class="b3-big__body">
                <span class="b3-big__title">{t.title}</span>
                {'credit' in t && <span class="b3-big__credit">{t.credit}</span>}
              </span>
              <span class="b3-big__aside">{t.aside}</span>
            </li>
          ))}
        </ol>
      </section>

      <footer class="b3-foot">
        <p class="b3-foot__total">{copy.foot.total}</p>
        {copy.foot.lines.map((line) => <p class="b3-foot__line">{line}</p>)}
      </footer>
    </article>
  </div>
</section>
