---
/**
 * Sketch s3/b, "Groove": the record in the middle of the carousel, as a disc whose grooves are its
 * words (groove.ts presses them and turns it). The list under it is the same words for screen readers.
 */
import { vinyls } from '@/data/music';
import { START } from '@/components/music/v4/start';

const first = vinyls[START]!;
---
<section class="s3b" aria-label="The record in the middle, as a disc" data-s3b data-intro-rest>
  <div class="s3b-stage">
    <div class="s3b-disc" data-s3b-disc>
      <div class="s3b-spin" data-s3b-spin>
        <svg class="s3b-svg" viewBox="0 0 1000 1000" aria-hidden="true" data-s3b-svg></svg>
      </div>
      <div class="s3b-sheen" aria-hidden="true"></div>
    </div>
  </div>
  <div class="sr-only" data-s3b-text>
    <p>{first.title}, {first.artist}, {first.year}.</p>
    <ol>{first.tracks.map((t) => <li>{typeof t === 'string' ? t : `${t.title} (feat. ${t.feat})`}</li>)}</ol>
    <p>I play guitar and bass, though not very well. I make beats in my spare time, in FL Studio, with an Akai MPK Mini.</p>
  </div>
</section>
