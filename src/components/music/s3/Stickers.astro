---
/**
 * Sketch s3/c, "Hype stickers". The stickers a record's shrink-wrap carries ("2×LP", "featuring…"),
 * written honestly: two about him, two about the collection, every number counted from data/music.ts.
 * stickers.ts lays them down as the page scrolls and lets a hand peel one off and stick it elsewhere.
 */
import { vinyls } from '@/data/music';

const years = vinyls.map((v) => v.year);
const doubles = vinyls.filter((v) => v.format.startsWith('2')).length;
// Everyone featured on the shelf, in the order they first appear.
const guests: string[] = [];
for (const v of vinyls) for (const t of v.tracks) {
  if (typeof t === 'string') continue;
  for (const name of t.feat.split(/, | & /)) if (!guests.includes(name)) guests.push(name);
}
const shown = guests.slice(0, 9);
const words = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const say = (n: number) => words[n] ?? String(n);
---
<section class="s3c" aria-label="Stickers" data-s3c data-intro-rest>
  <div class="container--wide s3c-stage" data-s3c-stage>
    <div class="s3c-sticker s3c-sticker--round s3c-yellow" data-s3c-sticker style="--x:17%;--y:3%;--r:-8deg;--px:0%;--py:0%">
      <div class="s3c-face">
        <p class="s3c-small">Includes</p>
        <p class="s3c-big">Guitar and&nbsp;bass</p>
        <p class="s3c-mid">Not very well.</p>
      </div>
    </div>

    <div class="s3c-sticker s3c-sticker--rect s3c-white" data-s3c-sticker style="--x:39%;--y:0%;--r:3.5deg;--px:22%;--py:33%">
      <div class="s3c-face">
        <p class="s3c-big">Beats</p>
        <p class="s3c-mid">Made in my spare time, in FL&nbsp;Studio, with an Akai MPK&nbsp;Mini.</p>
      </div>
    </div>

    <div class="s3c-sticker s3c-sticker--round s3c-red" data-s3c-sticker style="--x:66%;--y:24%;--r:9deg;--px:42%;--py:52%">
      <div class="s3c-face">
        <p class="s3c-huge">{vinyls.length}</p>
        <p class="s3c-mid">records on vinyl, from {Math.min(...years)} to&nbsp;{Math.max(...years)}</p>
        <p class="s3c-small">{say(doubles)[0]!.toUpperCase() + say(doubles).slice(1)} of them double</p>
      </div>
    </div>

    <div class="s3c-sticker s3c-sticker--rect s3c-blue" data-s3c-sticker style="--x:25%;--y:53%;--r:-2.5deg;--px:0%;--py:74%">
      <div class="s3c-face">
        <p class="s3c-small">Featuring</p>
        <p class="s3c-names">{shown.join(', ')}</p>
        <p class="s3c-small">and {guests.length - shown.length} more</p>
      </div>
    </div>
  </div>
</section>
