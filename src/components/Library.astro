---
/**
 * Daniel's notes and lab reports as a wave packet. The documents ride a travelling wave,
 * ψ(x, t) = e^(−x²/2σ²) sin(kx − ωt): the one at the packet's centre is large, lit and selected; the
 * envelope shrinks and dims the rest. Drag it (it carries on with some inertia), use the arrows or the
 * keyboard; left alone it drifts. Pressing the selected one opens the PDF itself — the copy the build
 * brought from danimartinguerrero/apuntes and /fotos (scripts/apuntes.mjs), or GitHub's if it could not.
 * Without JavaScript, and for screen readers, the same documents are a plain list.
 */
import { existsSync } from 'node:fs';
import apuntes from '@/data/apuntes.json';
import { href } from '@/lib/paths';

// Notes first, by subject in the order of the degree, then the lab reports.
const order = ['Física I', 'Análisis Matemático I', 'Análisis Matemático II', 'Álgebra Lineal y Geometría II', 'Mecánica I', 'Electromagnetismo I', 'Ecuaciones Diferenciales', 'Termodinámica I', 'Laboratorio de Física', 'Laboratorio de Mecánica y Ondas'];
const rank = (s: string) => { const i = order.indexOf(s); return i < 0 ? order.length : i; };
const docs = [...apuntes.items].sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'apuntes' ? -1 : 1) || rank(a.subject) - rank(b.subject) || a.title.localeCompare(b.title, 'es', { numeric: true }));
const link = (i: typeof docs[number]) => (existsSync(`public/apuntes/${i.slug}.pdf`) ? href(`/apuntes/${i.slug}.pdf`) : i.github);
const cover = (s: string) => (existsSync(`public/apuntes-portadas/${s}.webp`) ? href(`/apuntes-portadas/${s}.webp`) : '');
const pages = docs.reduce((n, i) => n + (i.pages ?? 0), 0);
const items = docs.map((i) => ({ t: i.title, s: i.subject, k: i.kind === 'informe' ? 'Informe de laboratorio' : 'Apuntes', p: i.pages, c: cover(i.slug), u: link(i), w: i.coauthor ? i.coauthor.replace(/\s*y\s*Daniel Mart[ií]n.*/i, '') : '' }));
---
<div class="pkt" id="biblioteca" data-packet data-items={JSON.stringify(items)}>
  <div class="pkt__head">
    <p class="pkt__sum"><span class="pkt__big">{docs.length}</span> documentos · <span class="pkt__big">{pages.toLocaleString('es-ES')}</span> páginas</p>
    <p class="pkt__eq" aria-hidden="true">ψ(x, t) = e<sup>−x²/2σ²</sup> sin(kx − ωt)</p>
  </div>

  <div class="pkt__stage" data-pkt-stage aria-hidden="true">
    <canvas class="pkt__wave" data-pkt-wave></canvas>
    <div class="pkt__track" data-pkt-track></div>
  </div>

  <div class="pkt__bar">
    <div class="pkt__now" aria-live="polite">
      <p class="pkt__meta" data-pkt-meta></p>
      <p class="pkt__title" data-pkt-title></p>
    </div>
    <div class="pkt__ctl">
      <span class="pkt__count" data-pkt-count></span>
      <button class="ctl" type="button" data-pkt-prev aria-label="Anterior">←</button>
      <button class="ctl" type="button" data-pkt-next aria-label="Siguiente">→</button>
      <a class="ctl ctl--open" data-pkt-open href="#" target="_blank" rel="noopener">Abrir PDF</a>
    </div>
  </div>

  <ul class="pkt__list">
    {docs.map((i) => <li><a class="link" href={link(i)}>{i.title}</a> <span>· {i.subject} · {i.pages} pp.</span></li>)}
  </ul>
</div>

<style>
  .pkt { margin-top: clamp(48px, 6vw, 80px); scroll-margin-top: calc(var(--head) + 24px); }
  .pkt__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .pkt__sum { font-size: 15px; color: var(--ink-3); }
  .pkt__big { font-family: var(--serif); font-size: 1.6rem; color: var(--ink); font-variant-numeric: lining-nums; }
  .pkt__eq { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--ink-3); }

  .pkt__stage { position: relative; height: clamp(400px, 58vh, 600px); overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; display: none; }
  .pkt__stage.is-dragging { cursor: grabbing; }
  .pkt__wave { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pkt__track { position: absolute; inset: 0; }
  .pkt__track :global(.pkt__doc) {
    position: absolute; left: 0; top: 50%; width: clamp(150px, 15vw, 210px); aspect-ratio: 1 / 1.414;
    margin: calc(clamp(150px, 15vw, 210px) * -0.707) 0 0 calc(clamp(150px, 15vw, 210px) * -0.5);
    background: #f4f2ec center top / cover no-repeat; outline: 1px solid var(--line-2); outline-offset: -1px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    will-change: transform, opacity; cursor: pointer;
  }
  .pkt__track :global(.pkt__doc.is-on) { outline-color: var(--gold); }

  .pkt__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; padding-top: 16px; border-top: 1px solid var(--line); }
  .pkt__now { min-width: 0; flex: 1 1 420px; }
  .pkt__meta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); }
  .pkt__title { margin-top: 6px; font-family: var(--serif); font-weight: 300; font-size: clamp(1.5rem, 2.8vw, 2.4rem); line-height: 1.1; letter-spacing: -0.015em; min-height: 1.1em; }
  .pkt__ctl { display: flex; align-items: center; gap: 6px; }
  .pkt__count { font-family: var(--mono); font-size: 12px; color: var(--ink-3); margin-right: 10px; font-variant-numeric: tabular-nums; }
  .ctl--open { text-decoration: none; color: var(--bg); background: var(--ink); border-color: var(--ink); display: inline-flex; align-items: center; }
  .ctl--open:hover { background: var(--gold); border-color: var(--gold); color: var(--bg); }

  .pkt__list { margin-top: 24px; columns: 2 320px; font-size: 14.5px; line-height: 1.9; color: var(--ink-3); }
  :global(html.js) .pkt__stage { display: block; }
  :global(html.js) .pkt__list { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  :global(html:not(.js)) .pkt__bar { display: none; }
</style>

<script>
  import { reduceMotion, surface } from '@/lib/figure';

  type Doc = { t: string; s: string; k: string; p: number; c: string; u: string; w: string };
  const root = document.querySelector<HTMLElement>('[data-packet]');
  if (root) {
    const docs = JSON.parse(root.dataset.items!) as Doc[];
    const stage = root.querySelector<HTMLElement>('[data-pkt-stage]')!;
    const track = root.querySelector<HTMLElement>('[data-pkt-track]')!;
    const wave = surface(root.querySelector<HTMLCanvasElement>('[data-pkt-wave]')!);
    const title = root.querySelector<HTMLElement>('[data-pkt-title]')!;
    const meta = root.querySelector<HTMLElement>('[data-pkt-meta]')!;
    const count = root.querySelector<HTMLElement>('[data-pkt-count]')!;
    const open = root.querySelector<HTMLAnchorElement>('[data-pkt-open]')!;
    const still = reduceMotion();
    const N = docs.length;

    const els = docs.map((d, i) => {
      const el = document.createElement('div');
      el.className = 'pkt__doc';
      if (d.c) el.style.backgroundImage = `url('${d.c}')`;
      el.addEventListener('click', () => {
        if (Math.abs(dragged) > 6) return;
        if (i === current) window.open(d.u, '_blank', 'noopener');
        else goTo(i);
      });
      track.append(el);
      return el;
    });

    // pos: the index at the centre (fractional while moving); vel in documents per second.
    let pos = 0, vel = 0, target: number | null = 0, current = -1, t = 0, hover = false, visible = false;
    const wrap = (x: number) => ((x % N) + N) % N;
    const nearest = (i: number) => { const d = wrap(i - pos + N / 2) - N / 2; return pos + d; };
    const goTo = (i: number) => { target = nearest(i); vel = 0; };

    const select = (i: number) => {
      if (i === current) return;
      current = i;
      const d = docs[i];
      title.textContent = d.t;
      meta.textContent = `${d.k} · ${d.s}${d.p ? ` · ${d.p} pp.` : ''}${d.w ? ` · con ${d.w}` : ''}`;
      count.textContent = `${String(i + 1).padStart(2, '0')} / ${N}`;
      open.href = d.u;
      els.forEach((e, k) => e.classList.toggle('is-on', k === i));
    };

    const frame = (dt: number) => {
      t += dt;
      const w = stage.clientWidth, h = stage.clientHeight;
      const spacing = Math.max(140, Math.min(240, w / 6));
      // Motion: towards a target, or coasting with friction, or a slow drift when idle.
      if (target !== null) {
        const d = target - pos; vel = d * 6; pos += vel * dt;
        if (Math.abs(d) < 0.002) { pos = target; target = null; vel = 0; }
      } else if (!dragging) {
        if (Math.abs(vel) > 0.02) { pos += vel * dt; vel *= Math.exp(-dt * 2.4); }
        else if (!hover && !still) { pos += dt * 0.12; }
        else { vel = 0; const r = Math.round(pos); if (Math.abs(r - pos) > 0.001) target = r; }
      }
      select(wrap(Math.round(pos)));
      const sigma = 2.1, k = 0.9, om = 1.6, A = Math.min(26, h * 0.05);
      for (let i = 0; i < N; i++) {
        const x = wrap(i - pos + N / 2) - N / 2; // signed distance from the centre, in documents
        const g = Math.exp(-(x * x) / (2 * sigma * sigma));
        const y = -A * g * Math.sin(k * x - om * t) * (still ? 0 : 1);
        const s = 0.5 + 0.62 * g;
        const el = els[i];
        el.style.transform = `translate3d(${w / 2 + x * spacing * (0.72 + 0.28 * g)}px, ${y}px, 0) scale(${s}) rotateZ(${(x * -1.2 * (1 - g)).toFixed(2)}deg)`;
        el.style.opacity = String(Math.max(0, Math.min(1, 0.12 + 0.95 * g)));
        el.style.zIndex = String(Math.round(g * 100));
        el.style.visibility = Math.abs(x) > 6 ? 'hidden' : 'visible';
      }
      // The packet itself, faint behind the documents: envelope and carrier.
      const { ctx } = wave;
      ctx.clearRect(0, 0, wave.w, wave.h);
      const cy = wave.h / 2;
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(236,235,230,0.08)';
      ctx.beginPath(); ctx.moveTo(0, cy); ctx.lineTo(wave.w, cy); ctx.stroke();
      ctx.strokeStyle = 'rgba(226,194,125,0.38)';
      ctx.beginPath();
      for (let px = 0; px <= wave.w; px += 3) {
        const x = (px - wave.w / 2) / spacing;
        const g = Math.exp(-(x * x) / (2 * sigma * sigma));
        const yy = cy - wave.h * 0.3 * g * Math.sin(k * 2.2 * x - om * t * 1.4);
        px ? ctx.lineTo(px, yy) : ctx.moveTo(px, yy);
      }
      ctx.stroke();
      ctx.setLineDash([2, 5]); ctx.strokeStyle = 'rgba(236,235,230,0.14)';
      for (const sgn of [1, -1]) {
        ctx.beginPath();
        for (let px = 0; px <= wave.w; px += 4) { const x = (px - wave.w / 2) / spacing; const yy = cy - sgn * wave.h * 0.3 * Math.exp(-(x * x) / (2 * sigma * sigma)); px ? ctx.lineTo(px, yy) : ctx.moveTo(px, yy); }
        ctx.stroke();
      }
      ctx.setLineDash([]);
    };

    // Dragging, with inertia.
    let dragging = false, dragged = 0, lastX = 0, lastT = 0;
    stage.addEventListener('pointerdown', (e) => {
      dragging = true; dragged = 0; lastX = e.clientX; lastT = e.timeStamp; target = null; vel = 0;
      stage.setPointerCapture(e.pointerId); stage.classList.add('is-dragging');
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const spacing = Math.max(140, Math.min(240, stage.clientWidth / 6));
      const dx = e.clientX - lastX, dtt = Math.max(1, e.timeStamp - lastT) / 1000;
      dragged += dx; pos -= dx / spacing; vel = -(dx / spacing) / dtt; lastX = e.clientX; lastT = e.timeStamp;
    });
    const release = () => { if (!dragging) return; dragging = false; stage.classList.remove('is-dragging'); vel = Math.max(-12, Math.min(12, vel)); };
    stage.addEventListener('pointerup', release); stage.addEventListener('pointercancel', release);
    stage.addEventListener('pointerenter', () => { hover = true; });
    stage.addEventListener('pointerleave', () => { hover = false; });
    // Sideways wheel or trackpad swipes move it; vertical scrolling is left to the page.
    stage.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault(); target = null; vel = 0; pos += e.deltaX / 160;
    }, { passive: false });
    root.querySelector('[data-pkt-prev]')!.addEventListener('click', () => goTo(wrap(current - 1)));
    root.querySelector('[data-pkt-next]')!.addEventListener('click', () => goTo(wrap(current + 1)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { goTo(wrap(current + 1)); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { goTo(wrap(current - 1)); e.preventDefault(); }
    });
    root.addEventListener('focusin', () => { hover = true; });
    root.addEventListener('focusout', () => { hover = false; });

    // The study plan's subjects bring their first document to the centre.
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-subject]');
      if (!a) return;
      const i = docs.findIndex((d) => d.s === a.dataset.subject);
      if (i < 0) return;
      e.preventDefault();
      root.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
      goTo(i); hover = true; setTimeout(() => { hover = false; }, 6000);
    });

    let raf = 0, last = 0;
    const tick = (now: number) => { const dt = last ? Math.min((now - last) / 1000, 0.05) : 0; last = now; frame(dt); raf = requestAnimationFrame(tick); };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) { last = 0; raf = requestAnimationFrame(tick); }
      if (!visible && raf) { cancelAnimationFrame(raf); raf = 0; }
    }).observe(stage);
    frame(0);
  }
</script>
