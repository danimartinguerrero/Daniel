---
/**
 * Daniel's notes and lab reports, by subject, each a cover that opens the PDF itself: the copy the build
 * brought from danimartinguerrero/apuntes (scripts/apuntes.mjs), or the file on GitHub if the build
 * could not fetch it.
 */
import { existsSync } from 'node:fs';
import apuntes from '@/data/apuntes.json';
import { href } from '@/lib/paths';

const order = ['Mecánica I', 'Electromagnetismo I', 'Ecuaciones Diferenciales', 'Termodinámica I', 'Laboratorio de Mecánica y Ondas', 'Otros'];
const groups = order
  .map((subject) => ({ subject, items: apuntes.items.filter((i) => i.subject === subject) }))
  .filter((g) => g.items.length);
const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
const local = (s: string) => existsSync(`public/apuntes/${s}.pdf`);
const link = (i: typeof apuntes.items[number]) => (local(i.slug) ? href(`/apuntes/${i.slug}.pdf`) : i.github);
const cover = (s: string) => existsSync(`public/apuntes-portadas/${s}.webp`) ? href(`/apuntes-portadas/${s}.webp`) : null;
const pages = apuntes.items.reduce((n, i) => n + (i.pages ?? 0), 0);
---
<div class="lib">
  <p class="lib__sum"><span class="lib__big">{apuntes.items.length}</span> documentos · <span class="lib__big">{pages.toLocaleString('es-ES')}</span> páginas, de <a class="link" href={apuntes.repo}>danimartinguerrero/apuntes</a></p>
  {groups.map((g) => (
    <section class="lib__group" id={`pdf-${slug(g.subject)}`} aria-label={g.subject}>
      <h3 class="lib__subject"><span>{g.subject}</span><span class="lib__count">{g.items.length}</span></h3>
      <ul class="lib__grid">
        {g.items.map((i) => {
          const c = cover(i.slug);
          return (
            <li>
              <a class="doc" href={link(i)} target="_blank" rel="noopener">
                <span class:list={['doc__cover', { 'doc__cover--dark': i.dark }]}>
                  {c ? <img src={c} alt="" width="720" height="1018" loading="lazy" decoding="async" /> : <span class="doc__ph">{i.title}</span>}
                </span>
                <span class="doc__kind">{i.kind === 'informe' ? 'Informe de laboratorio' : 'Apuntes'}{i.pages && ` · ${i.pages} pp.`}</span>
                <span class="doc__title">{i.title}</span>
                {i.coauthor && <span class="doc__with">Con {i.coauthor.replace(/\s*y\s*Daniel Mart[ií]n.*/i, '').replace(/Daniel Mart[ií]n\s*y\s*/i, '')}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .lib { margin-top: clamp(48px, 6vw, 80px); }
  .lib__sum { font-size: 15px; color: var(--ink-3); }
  .lib__big { font-family: var(--serif); font-size: 1.6rem; color: var(--ink); font-variant-numeric: lining-nums; }
  .lib__group { margin-top: clamp(32px, 4vw, 48px); scroll-margin-top: calc(var(--head) + 24px); }
  .lib__subject { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; margin-bottom: 20px; border-bottom: 1px solid var(--line); font-family: var(--serif); font-weight: 400; font-size: 1.35rem; }
  .lib__count { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); }
  .lib__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px clamp(14px, 1.8vw, 24px); }
  .doc { display: grid; gap: 8px; text-decoration: none; }
  .doc__cover { display: block; aspect-ratio: 1 / 1.414; overflow: hidden; outline: 1px solid var(--line); outline-offset: -1px; background: #f4f2ec; transition: transform 400ms var(--ease); }
  .doc__cover img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .doc:hover .doc__cover { transform: translateY(-4px); }
  .doc__ph { display: grid; place-items: center; height: 100%; padding: 12px; text-align: center; font-family: var(--serif); color: #222; }
  .doc__kind { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .doc__title { font-size: 14px; line-height: 1.35; color: var(--ink); }
  .doc:hover .doc__title { color: var(--gold); }
  .doc__with { font-size: 12.5px; color: var(--ink-3); }
  @media (max-width: 520px) { .lib__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
