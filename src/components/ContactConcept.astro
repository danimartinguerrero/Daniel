---
import '@/styles/global.css';
import '@/styles/contact-concepts.css';
import '@fontsource/caveat/latin-500.css';
interface Props { variant: number }
const { variant } = Astro.props;
const names = ['Say hello', 'Postcard', 'Good chemistry', 'New message'];
const email = 'nicomg60@gmail.com';
const mail = `mailto:${email}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{names[variant - 1]} · Contact concepts · Nicolás Muñoz García</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={`concept concept--${variant}`}>
    <a class="concept-skip" href="#contact-content">Skip to contact</a>
    <header class="concept-bar">
      <a class="concept-home" href="/#contact" aria-label="Back to Nicolás’s portfolio">Nicolás<span> Muñoz García</span><span aria-hidden="true"> ↗</span></a>
      <nav class="concept-switch" aria-label="Contact design variants">
        {names.map((name, i) => <a href={`/contact-variants/${i + 1}/`} aria-current={variant === i + 1 ? 'page' : undefined}><span class="concept-number">0{i + 1}</span><span class="concept-name">{name}</span></a>)}
      </nav>
      <span class="concept-label">Contact explorations</span>
    </header>

    <main id="contact-content" class="concept-main">
      {variant === 1 && <section class="hello-layout" aria-labelledby="hello-title">
        <div class="concept-copy">
          <p class="contact-eyebrow"><span class="availability-dot" />Open to internships & junior roles</p>
          <h1 id="hello-title">Good things<br />start with<br /><span>a hello.</span></h1>
          <p class="contact-description">A curious question. An idea on a napkin.<br />Something we could build together.</p>
          <a class="contact-primary" data-topic-mail href={`${mail}?subject=Hello%20Nicol%C3%A1s`}>Say hello <span aria-hidden="true">↗</span></a>
          <p class="contact-fine">In physics, software, or somewhere in between.</p>
        </div>
        <div class="conversation" aria-label="Choose a conversation starter">
          <div class="conversation-person"><span class="avatar">N</span><span>Nicolás<span class="person-caption">Physics student. Curious builder.</span></span></div>
          <div class="bubble bubble--incoming">Hey! What’s on your mind? <span aria-hidden="true">✳</span></div>
          <div class="bubble bubble--outgoing" data-chat-preview aria-live="polite">I have an idea…</div>
          <div class="conversation-choices" role="group" aria-label="Choose an email topic">
            <button type="button" data-chat="I have an idea…" data-subject="An idea to build together" aria-pressed="true">An idea <span aria-hidden="true">↗</span></button>
            <button type="button" data-chat="Let’s talk about an opportunity." data-subject="An opportunity for you" aria-pressed="false">An opportunity <span aria-hidden="true">↗</span></button>
            <button type="button" data-chat="Just wanted to say hello!" data-subject="Hello Nicolás" aria-pressed="false">Just a hello <span aria-hidden="true">↗</span></button>
          </div>
          <p class="conversation-hint">Pick a starting point. Make it your own by email.</p>
        </div>
      </section>}

      {variant === 2 && <section class="postcard-layout" aria-labelledby="postcard-title">
        <div class="postcard-heading"><p class="contact-eyebrow">FROM SALAMANCA, WITH CURIOSITY</p><h1 id="postcard-title">Your next idea.<br /><span>My inbox.</span></h1><p class="contact-description">Some things are better when you make them together.</p></div>
        <div class="postcard-scene">
          <button class="postcard" type="button" data-postcard aria-pressed="false" aria-label="Turn the postcard over to see contact details">
            <span class="postcard-face postcard-front" data-card-front>
              <span class="postcard-topline">A LITTLE NOTE FROM NICOLÁS <span>ES · 37001</span></span>
              <span class="postcard-greeting">Hello,<br />possibility.</span>
              <span class="postcard-sun" aria-hidden="true">✳</span>
              <span class="postcard-bottom">Physics. Software. Whatever comes next.<span class="postcard-flip">Turn me over ↻</span></span>
            </span>
            <span class="postcard-face postcard-back" data-card-back aria-hidden="true">
              <span class="postcard-note">Got a question,<br />a project, or a<br />“what if”?<br /><span>Let’s talk.</span></span>
              <span class="postcard-address"><span class="postcard-stamp" aria-hidden="true">N<br /><small>SALAMANCA</small></span><span>TO: NICOLÁS MUÑOZ GARCÍA</span><strong>{email}</strong><span>Open to internships<br />and junior roles.</span><span class="postcard-flip">Back to the front ↻</span></span>
            </span>
          </button>
        </div>
        <div class="postcard-actions"><a class="contact-primary" href={`${mail}?subject=A%20little%20hello`}>Write me a note <span aria-hidden="true">↗</span></a><p class="contact-fine">No stamp required.</p></div>
      </section>}

      {variant === 3 && <section class="orbit-layout" aria-labelledby="orbit-title">
        <div class="concept-copy"><p class="contact-eyebrow"><span class="availability-dot" />Open to internships & junior roles</p><h1 id="orbit-title">Let’s make<br /><span>something<br />click.</span></h1><p class="contact-description">Physics meets software.<br />Your next idea could be the missing piece.</p><a class="contact-primary" data-orbit-mail href={`${mail}?subject=Let%E2%80%99s%20build%20something`}>Let’s connect <span aria-hidden="true">↗</span></a><p class="contact-fine">Pick a point. Find some common ground.</p></div>
        <div class="orbit-system" aria-label="Explore conversation topics">
          <div class="orbit-ring orbit-ring--outer" aria-hidden="true" /><div class="orbit-ring orbit-ring--inner" aria-hidden="true" />
          <div class="orbit-center"><span class="orbit-symbol" aria-hidden="true" data-orbit-symbol>↗</span><span data-orbit-title>Common ground.</span><p data-orbit-copy aria-live="polite">A little curiosity goes a long way.</p></div>
          <button class="orbit-node orbit-node--physics" type="button" data-orbit="physics" aria-pressed="false"><span aria-hidden="true">ψ</span>Physics</button>
          <button class="orbit-node orbit-node--code" type="button" data-orbit="software" aria-pressed="false"><span aria-hidden="true">&lt;/&gt;</span>Software</button>
          <button class="orbit-node orbit-node--idea" type="button" data-orbit="ideas" aria-pressed="false"><span aria-hidden="true">✳</span>Your idea</button>
          <span class="orbit-dot orbit-dot--one" aria-hidden="true" /><span class="orbit-dot orbit-dot--two" aria-hidden="true" />
        </div>
      </section>}

      {variant === 4 && <section class="compose-layout" aria-labelledby="compose-title">
        <div class="compose-heading"><p class="contact-eyebrow">THE NEXT CHAPTER STARTS HERE</p><h1 id="compose-title">Small message.<br /><span>Big possibilities.</span></h1><p class="contact-description">Have something in mind? Pull up a window.</p></div>
        <div class="compose-desk">
          <span class="desk-note" aria-hidden="true">Good ideas<br />welcome here.<span>↘</span></span>
          <form class="compose-window" data-compose>
            <div class="window-chrome"><span class="window-dots" aria-hidden="true"><i /><i /><i /></span><span>New message</span><span aria-hidden="true">↗</span></div>
            <div class="compose-row"><span>To</span><span class="recipient">Nicolás <span class="recipient-email">&lt;{email}&gt;</span></span></div>
            <div class="compose-row"><label for="message-subject">Subject</label><input id="message-subject" name="subject" value="Let’s build something" maxlength="160" required /></div>
            <label class="sr-only" for="message-body">Your message</label><textarea id="message-body" name="body" rows="5" placeholder="Hey Nicolás,&#10;&#10;I’ve been thinking about…" maxlength="3000" required />
            <div class="compose-bottom"><p>One small step.<br /><span>Opens in your email app.</span></p><button class="contact-primary" type="submit">Continue in Mail <span aria-hidden="true">↗</span></button></div>
          </form>
        </div>
        <p class="contact-fine compose-availability">Open to internships and junior roles in physics and software.</p>
      </section>}
    </main>
    <footer class="concept-footer">
      <div class="footer-email"><a href={mail}>{email}</a><button type="button" class="copy-email" data-copy aria-label="Copy email address">Copy <span aria-hidden="true">⧉</span></button><span class="sr-only" data-copy-status role="status" /></div>
      <p>Salamanca, Spain <span aria-hidden="true">↗</span></p>
      <div class="footer-social"><a href="https://github.com/mugar123" rel="me">GitHub ↗</a><a href="https://x.com/therealmugar" rel="me">Twitter ↗</a></div>
    </footer>
    <script>
      import '@/scripts/contact-concepts';
    </script>
  </body>
</html>
