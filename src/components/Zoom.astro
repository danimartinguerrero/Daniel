---
/**
 * For every image marked [data-zoom]: a loupe and a light table.
 * - The loupe (fine pointers): a converging lens that follows the pointer and shows the full-resolution
 *   picture beneath it at ×2,5, with a thin ring and its magnification marked.
 * - The light table: pressing the image opens it whole, at its native resolution, over the page; arrows,
 *   keys or a swipe go through the other images of its group ([data-group]); Esc or a press outside
 *   closes it.
 */
---
<div class="loupe" data-loupe aria-hidden="true"><span class="loupe__m">×2,5</span></div>

<dialog class="table" data-table aria-label="Fotografía a tamaño completo">
  <figure class="table__fig">
    <img class="table__img" data-table-img alt="" />
    <figcaption class="table__cap"><span class="table__n" data-table-n></span><span data-table-cap></span><a class="link table__orig" data-table-orig target="_blank" rel="noopener">Original</a></figcaption>
  </figure>
  <button class="table__btn table__btn--prev" type="button" data-table-prev aria-label="Anterior">←</button>
  <button class="table__btn table__btn--next" type="button" data-table-next aria-label="Siguiente">→</button>
  <button class="table__close" type="button" data-table-close aria-label="Cerrar">Cerrar</button>
</dialog>

<style>
  .loupe {
    position: fixed; left: 0; top: 0; z-index: 70; width: 220px; height: 220px; border-radius: 50%;
    pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(0.6);
    transition: opacity 200ms var(--ease), transform 300ms var(--ease);
    background-repeat: no-repeat; background-color: #000;
    box-shadow: 0 0 0 1px rgba(226, 194, 125, 0.85), 0 0 0 6px rgba(10, 10, 11, 0.55), 0 24px 60px -20px rgba(0, 0, 0, 0.9);
  }
  .loupe.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .loupe__m { position: absolute; right: 22px; bottom: 18px; font-family: var(--mono); font-size: 10.5px; color: var(--gold); text-shadow: 0 1px 3px #000; }

  .table { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(5, 5, 6, 0.97); color: var(--ink); }
  .table::backdrop { background: transparent; }
  .table[open] { display: grid; place-items: center; animation: table-in 400ms var(--ease); }
  @keyframes table-in { from { opacity: 0; } }
  .table__fig { margin: 0; display: grid; gap: 14px; justify-items: center; padding: 64px 72px 32px; max-width: 100%; max-height: 100%; }
  .table__img { max-width: calc(100vw - 144px); max-height: calc(100vh - 150px); width: auto; height: auto; outline: 1px solid var(--line); }
  .table__cap { display: flex; gap: 14px; align-items: baseline; font-size: 14px; color: var(--ink-2); max-width: 90ch; text-align: center; }
  .table__n { font-family: var(--mono); font-size: 11px; color: var(--gold); }
  .table__orig { font-family: var(--mono); font-size: 11px; }
  .table__btn, .table__close { position: fixed; background: none; border: 1px solid var(--line-2); color: var(--ink-2); font-family: var(--mono); font-size: 13px; padding: 10px 14px; cursor: pointer; }
  .table__btn:hover, .table__close:hover { color: var(--ink); border-color: var(--ink-3); }
  .table__btn--prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .table__btn--next { right: 16px; top: 50%; transform: translateY(-50%); }
  .table__close { top: 16px; right: 16px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
  @media (max-width: 700px) {
    .table__fig { padding: 56px 12px 72px; }
    .table__img { max-width: calc(100vw - 24px); max-height: calc(100vh - 180px); }
    .table__btn { top: auto; bottom: 16px; transform: none; }
  }
</style>

<script>
  const loupe = document.querySelector<HTMLElement>('[data-loupe]')!;
  const table = document.querySelector<HTMLDialogElement>('[data-table]')!;
  const tImg = table.querySelector<HTMLImageElement>('[data-table-img]')!;
  const tCap = table.querySelector<HTMLElement>('[data-table-cap]')!;
  const tN = table.querySelector<HTMLElement>('[data-table-n]')!;
  const tOrig = table.querySelector<HTMLAnchorElement>('[data-table-orig]')!;
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const ZOOM = 2.5;
  let group: HTMLImageElement[] = [], index = 0;

  // The loupe: the full image behind a circle, offset so the point under the pointer sits at its centre.
  const show = (img: HTMLImageElement, e: PointerEvent) => {
    const r = img.getBoundingClientRect();
    const x = e.clientX - r.left, y = e.clientY - r.top;
    if (x < 0 || y < 0 || x > r.width || y > r.height) { loupe.classList.remove('is-on'); return; }
    const lw = loupe.offsetWidth / 2;
    loupe.style.left = `${e.clientX}px`; loupe.style.top = `${e.clientY}px`;
    loupe.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`;
    loupe.style.backgroundPosition = `${lw - x * ZOOM}px ${lw - y * ZOOM}px`;
    loupe.classList.add('is-on');
  };
  document.querySelectorAll<HTMLImageElement>('img[data-zoom]').forEach((img) => {
    img.addEventListener('pointerenter', (e) => {
      if (!fine.matches) return;
      loupe.style.backgroundImage = `url('${img.dataset.full}')`;
      show(img, e);
    });
    img.addEventListener('pointermove', (e) => { if (fine.matches) show(img, e); });
    img.addEventListener('pointerleave', () => loupe.classList.remove('is-on'));
    img.addEventListener('click', () => open(img));
  });

  const render = () => {
    const img = group[index];
    tImg.src = img.dataset.full!; tImg.alt = img.alt;
    tCap.textContent = img.dataset.caption ?? img.alt;
    tN.textContent = `${String(index + 1).padStart(2, '0')} / ${String(group.length).padStart(2, '0')}`;
    tOrig.href = img.dataset.full!;
  };
  const open = (img: HTMLImageElement) => {
    group = [...document.querySelectorAll<HTMLImageElement>(`img[data-zoom][data-group="${img.dataset.group}"]`)];
    index = Math.max(0, group.indexOf(img));
    loupe.classList.remove('is-on');
    render(); table.showModal();
  };
  const step = (d: number) => { index = (index + d + group.length) % group.length; render(); };
  table.querySelector('[data-table-prev]')!.addEventListener('click', () => step(-1));
  table.querySelector('[data-table-next]')!.addEventListener('click', () => step(1));
  table.querySelector('[data-table-close]')!.addEventListener('click', () => table.close());
  table.addEventListener('click', (e) => { if (e.target === table) table.close(); });
  table.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  let sx = 0;
  table.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  table.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1); });
</script>
