---
interface Props { id?: string; headingId: string; title: string }
const { id, headingId, title } = Astro.props;
---
<section class="divider section--dark" id={id} aria-labelledby={headingId} data-divider>
  <div class="divider__pin">
    <h2 class="divider__title" id={headingId}>{title}<span class="divider__shade" aria-hidden="true"><span class="divider__light"></span></span></h2>
  </div>
</section>
<style is:global>
  /* Separation pages: the part's name holds the screen and fills with light, left to right, as it scrolls past
     (the site's one fill: --fill-dim, --fill-edge and --fill-line in global.css). The name fills over the
     first 70% of its hold, so the hold is --fill-line / 0.7 and the page that long past the screen.
     Without the script, or with reduced motion, it is simply lit. */
  .divider { height: calc(100svh + var(--fill-line) / 0.7); }
  .divider__pin {
    position: sticky; top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    display: grid; place-content: center; justify-items: center; gap: 1.5rem;
    padding-inline: var(--gutter);
    text-align: center;
  }
  .divider__title {
    padding: 0.04em 0.06em 0.18em;
    margin-bottom: -0.14em;
    font-size: clamp(4.5rem, 17vw, 16rem); line-height: 0.95; font-weight: 600; letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .divider__shade { display: none; }

  /* Multiply the moving colour over the stationary white glyphs. Keep the overlay
     inside the black padding so its edges always blend against opaque pixels,
     even when the compositor rounds each layer to a different device pixel. */
  @media (forced-colors: none) {
    html.js:not(.reduce) .divider__title {
      position: relative; isolation: isolate; color: white; background: black;
      transform: translateZ(0);
    }
    html.js:not(.reduce) .divider__shade {
      display: block; position: absolute; inset: 2px; overflow: hidden; pointer-events: none;
      background: var(--fill-dim);
      mix-blend-mode: multiply;
    }
    html.js:not(.reduce) .divider__light {
      display: block; position: absolute; inset: 0 calc(-100% * var(--fill-edge)) 0 0;
      background: linear-gradient(90deg, var(--on-dark) calc(100% / (1 + var(--fill-edge))), var(--fill-dim));
      transform: translate3d(-100%, 0, 0);
    }
  }
  @supports (animation-timeline: view()) {
    .divider { view-timeline-name: --divider; view-timeline-axis: block; view-timeline-inset: 0; }
    html.js:not(.reduce) .divider__light {
      animation: divider-fill linear both;
      animation-duration: auto;
      animation-timeline: --divider;
      animation-range: contain 0px contain var(--fill-line);
    }
    @keyframes divider-fill {
      from { transform: translate3d(-100%, 0, 0); }
      to { transform: translate3d(0, 0, 0); }
    }
  }
  html:not(.js) .divider, html.reduce .divider { height: auto; }
  html:not(.js) .divider__pin, html.reduce .divider__pin { position: static; min-height: calc(100svh - var(--nav-h)); }
</style>
